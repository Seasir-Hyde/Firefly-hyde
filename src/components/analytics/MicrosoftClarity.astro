---
interface Props {
	shareId: string;
	shareApiBase: string;
	historicalVisitors?: number;
	historicalPageviews?: number;
	localPreview?: boolean;
}

const {
	shareId,
	shareApiBase,
	historicalVisitors = 0,
	historicalPageviews = 0,
	localPreview = false,
} = Astro.props;
---

<script is:inline define:vars={{ shareId, shareApiBase, historicalVisitors, historicalPageviews, localPreview }}>
	(() => {
		const namespace = "__rainztUmamiMetrics";
		const shareCacheKey = "rainzt:umami:share";
		const metricsCacheKey = "rainzt:umami:metrics";
		const statsCacheKey = "rainzt:umami:stats";
		const friendClickCacheKey = "rainzt:umami:friend-clicks:v2";
		const friendClickEventName = "friend-link-click";
		const legacyFriendClickEventName = "outbound-link-click";
		const shareCacheTtl = 24 * 60 * 60 * 1000;
		const metricsCacheTtl = 60 * 1000;
		const pendingRequests = new Map();
		const requestOnce = (key, factory) => {
			const pending = pendingRequests.get(key);
			if (pending) return pending;

			const request = Promise.resolve()
				.then(factory)
				.finally(() => {
					if (pendingRequests.get(key) === request) pendingRequests.delete(key);
				});
			pendingRequests.set(key, request);
			return request;
		};
		const apiBase = String(shareApiBase || "").replace(/\/+$/, "");
		const historicalVisitorCount = Math.max(0, Math.floor(Number(historicalVisitors) || 0));
		const historicalPageviewCount = Math.max(0, Math.floor(Number(historicalPageviews) || 0));
		const localPreviewHosts = new Set(["localhost", "127.0.0.1", "::1", "0.0.0.0"]);
		const numberAnimationFrames = new WeakMap();
		const animationClockKey = "__rainztAnalyticsAnimationClock";
		let summaryCounterObserver;
		const isLocalHost = localPreviewHosts.has(window.location.hostname.toLowerCase()) || window.location.protocol === "file:";
		const isLocalAnalytics = localPreview || isLocalHost;
		const isAnalyticsPage = () => window.location.pathname.replace(/\/+$/u, "") === "/analytics";
		const shouldBlockLocalStats = () => isLocalAnalytics && !isAnalyticsPage();
		const getAnimationClock = () => {
			const root = document.querySelector("[data-umami-dashboard]");
			const current = window[animationClockKey];
			if (current?.root === root) return current;
			const clock = {
				root,
				duration: 4500,
				startedAt: null,
				start() {
					if (this.startedAt === null) this.startedAt = performance.now();
					return this.startedAt;
				},
				replay() {
					this.startedAt = null;
					window.dispatchEvent(new CustomEvent("rainzt-analytics-animation-replay"));
				},
			};
			window[animationClockKey] = clock;
			return clock;
		};

		const markLocalPreview = () => {
			if (!shouldBlockLocalStats()) return;
			document.documentElement.dataset.analyticsMode = "local";
			document.querySelectorAll("[data-umami-pageviews], [data-umami-stat]").forEach((element) => {
				element.textContent = "不统计";
			});
			document.querySelectorAll(".waline-pageview-count").forEach((element) => {
				element.parentElement?.setAttribute("hidden", "true");
			});
		};

		if (shouldBlockLocalStats()) {
			markLocalPreview();
			const localPreviewObserver = new MutationObserver(() => {
				if (!document.querySelector("[data-umami-pageviews], [data-umami-stat], [data-friend-clicks-value], .waline-pageview-count")) return;
				markLocalPreview();
				localPreviewObserver.disconnect();
			});
			localPreviewObserver.observe(document.documentElement, { childList: true, subtree: true });
			if (document.readyState === "loading") {
				document.addEventListener("DOMContentLoaded", markLocalPreview, { once: true });
			}
			document.addEventListener("astro:page-load", markLocalPreview);
			document.addEventListener("swup:contentReplaced", markLocalPreview);
		}

		if (!shareId || !apiBase) return;

		function readCache(key, tag, ttl) {
			try {
				const raw = localStorage.getItem(key);
				if (!raw) return null;
				const cached = JSON.parse(raw);
				if (
					cached?.tag === tag &&
					typeof cached.timestamp === "number" &&
					Date.now() - cached.timestamp < ttl
				) {
					return cached.value;
				}
			} catch {
				// 本地缓存不可用时直接请求 Umami，不影响页面阅读。
			}
			return null;
		}

		function writeCache(key, tag, value) {
			try {
				localStorage.setItem(
					key,
					JSON.stringify({ tag, timestamp: Date.now(), value }),
				);
			} catch {
				// Safari 无痕等场景可能禁用本地缓存，无需额外提示。
			}
		}

		function normalizePath(value) {
			const path = String(value || "").split(/[?#]/, 1)[0].replace(/\/+$/, "");
			return (path || "/").toLowerCase();
		}

		function normalizeSiteUrl(value) {
			return String(value || "")
				.trim()
				.replace(/\/+$/, "")
				.toLowerCase();
		}

		const friendClickCountsBySite = new Map();

		function formatNumber(value) {
			return new Intl.NumberFormat("zh-CN").format(Number(value) || 0);
		}

		function flushPendingSummaryCounts(summary) {
			summary.querySelectorAll("[data-analytics-pending-count]").forEach((element) => {
				const target = Number(element.dataset.analyticsPendingCount);
				delete element.dataset.analyticsPendingCount;
				if (Number.isFinite(target)) renderStatValue(element, target, true);
			});
		}

		function observeSummaryCounters(summary) {
			if (!summary) return;
			if ("IntersectionObserver" in window) {
				if (!summaryCounterObserver) {
					summaryCounterObserver = new IntersectionObserver((entries) => {
						entries.forEach((entry) => {
							if (entry.isIntersecting) flushPendingSummaryCounts(entry.target);
						});
					}, { threshold: 0.18 });
				}
				summaryCounterObserver.observe(summary);
				return;
			}
			const rect = summary.getBoundingClientRect();
			if (rect.bottom > 0 && rect.top < window.innerHeight) flushPendingSummaryCounts(summary);
		}

		function renderStatValue(element, value, force = false) {
			const target = Math.max(0, Math.round(Number(value) || 0));
			element.dataset.analyticsTarget = String(target);
			const summary = element.closest(".analytics-summary");
			if (summary && !force) {
				const rect = summary.getBoundingClientRect();
				const isVisible = rect.bottom > 0 && rect.top < window.innerHeight;
				if (!isVisible) {
					element.dataset.analyticsPendingCount = String(target);
					element.dataset.analyticsCount = "0";
					element.textContent = formatNumber(0);
					observeSummaryCounters(summary);
					return;
				}
			}
			if (!summary) {
				element.textContent = formatNumber(target);
				return;
			}
			delete element.dataset.analyticsPendingCount;

			const previousFrame = numberAnimationFrames.get(element);
			if (previousFrame) cancelAnimationFrame(previousFrame);
			if (window.matchMedia?.("(prefers-reduced-motion: reduce)").matches) {
				element.dataset.analyticsCount = String(target);
				element.textContent = formatNumber(target);
				return;
			}
			const storedValue = Number(element.dataset.analyticsCount);
			const start = Number.isFinite(storedValue) ? storedValue : 0;
			const animationClock = getAnimationClock();
			const duration = animationClock.duration;
			const startedAt = animationClock.start();
			const liveRegion = element.getAttribute("aria-live");
			if (liveRegion) element.removeAttribute("aria-live");
			const easeCountProgress = (progress) => progress < 0.18
				? 0.08 * Math.pow(progress / 0.18, 2)
				: progress < 0.9
					? 0.08 + 0.82 * ((progress - 0.18) / 0.72)
					: 0.9 + 0.1 * (1 - Math.pow(1 - ((progress - 0.9) / 0.1), 3));

			const tick = (timestamp) => {
				const progress = Math.min(1, (timestamp - startedAt) / duration);
				const current = Math.round(start + (target - start) * easeCountProgress(progress));
				element.dataset.analyticsCount = String(current);
				element.textContent = formatNumber(current);
				if (progress < 1) {
					const frame = requestAnimationFrame(tick);
					numberAnimationFrames.set(element, frame);
					return;
				}
				element.dataset.analyticsCount = String(target);
				element.textContent = formatNumber(target);
				if (liveRegion) element.setAttribute("aria-live", liveRegion);
				numberAnimationFrames.delete(element);
			};

			const frame = requestAnimationFrame(tick);
			numberAnimationFrames.set(element, frame);
		}

		async function getShare() {
			const cached = readCache(shareCacheKey, shareId, shareCacheTtl);
			if (cached) return cached;

			return requestOnce(`share:${shareId}`, async () => {
				const freshCached = readCache(shareCacheKey, shareId, shareCacheTtl);
				if (freshCached) return freshCached;

				const response = await fetch(`${apiBase}/api/share/${encodeURIComponent(shareId)}`);
				if (!response.ok) throw new Error(`share ${response.status}`);
				const result = await response.json();
				if (!result?.websiteId || !result?.token) throw new Error("invalid share response");
				writeCache(shareCacheKey, shareId, result);
				return result;
			});
		}

		async function getMetrics(share, forceRefresh = false) {
			const cached = forceRefresh
				? null
				: readCache(metricsCacheKey, share.websiteId, metricsCacheTtl);
			if (cached) return cached;

			return requestOnce(`metrics:${share.websiteId}`, async () => {
				const freshCached = forceRefresh
					? null
					: readCache(metricsCacheKey, share.websiteId, metricsCacheTtl);
				if (freshCached) return freshCached;

				const url = new URL(`${apiBase}/api/websites/${share.websiteId}/metrics`);
				url.searchParams.set("startAt", "0");
				url.searchParams.set("endAt", String(Date.now()));
				url.searchParams.set("type", "path");
				url.searchParams.set("limit", "1000");

				const response = await fetch(url, {
					headers: {
						"x-umami-share-token": share.token,
						"x-umami-share-context": "1",
					},
				});
				if (!response.ok) throw new Error(`metrics ${response.status}`);
				const result = await response.json();
				writeCache(metricsCacheKey, share.websiteId, result);
				return result;
			});
		}

		async function getStats(share, startAt, endAt, cacheScope, forceRefresh = false) {
			const cacheKey = `${statsCacheKey}:${cacheScope}`;
			const cached = forceRefresh
				? null
				: readCache(cacheKey, share.websiteId, metricsCacheTtl);
			if (cached) return cached;

			return requestOnce(`stats:${share.websiteId}:${cacheScope}`, async () => {
				const freshCached = forceRefresh
					? null
					: readCache(cacheKey, share.websiteId, metricsCacheTtl);
				if (freshCached) return freshCached;

				const url = new URL(`${apiBase}/api/websites/${share.websiteId}/stats`);
				url.searchParams.set("startAt", String(startAt));
				url.searchParams.set("endAt", String(endAt));

				const response = await fetch(url, {
					headers: {
						"x-umami-share-token": share.token,
						"x-umami-share-context": "1",
					},
				});
				if (!response.ok) throw new Error(`stats ${response.status}`);
				const result = await response.json();
				writeCache(cacheKey, share.websiteId, result);
				return result;
			});
		}

		async function getEventDataValues(share, eventName, propertyName) {
			const url = new URL(
				`${apiBase}/api/websites/${share.websiteId}/event-data/values`,
			);
			url.searchParams.set("startAt", "0");
			url.searchParams.set("endAt", String(Date.now()));
			url.searchParams.set("eventName", eventName);
			url.searchParams.set("propertyName", propertyName);
			url.searchParams.set("limit", "1000");

			const response = await fetch(url, {
				headers: {
					"x-umami-share-token": share.token,
					"x-umami-share-context": "1",
				},
			});
			if (!response.ok) throw new Error(`${eventName} values ${response.status}`);
			return response.json();
		}

		async function getFriendClickCounts(share, forceRefresh = false) {
			const cached = forceRefresh
				? null
				: readCache(friendClickCacheKey, share.websiteId, metricsCacheTtl);
			if (cached) return cached;

			return requestOnce(`friend-clicks:${share.websiteId}`, async () => {
				const freshCached = forceRefresh
					? null
					: readCache(friendClickCacheKey, share.websiteId, metricsCacheTtl);
				if (freshCached) return freshCached;

				const results = await Promise.allSettled([
					getEventDataValues(share, friendClickEventName, "site"),
					getEventDataValues(share, legacyFriendClickEventName, "url"),
				]);
				if (results.every((result) => result.status === "rejected")) {
					throw results[0].reason || new Error("friend click counts unavailable");
				}
				const result = {
					friendClicks: results[0].status === "fulfilled" ? results[0].value : [],
					legacyOutboundClicks: results[1].status === "fulfilled" ? results[1].value : [],
				};
				writeCache(friendClickCacheKey, share.websiteId, result);
				return result;
			});
		}

		function getLocalDayStart(timestamp = Date.now()) {
			const date = new Date(timestamp);
			date.setHours(0, 0, 0, 0);
			return date.getTime();
		}

		function renderPageViews(metrics) {
			const rows = Array.isArray(metrics) ? metrics : metrics?.data || [];
			const viewsByPath = new Map();
			for (const row of rows) {
				const path = normalizePath(row?.x);
				viewsByPath.set(path, (viewsByPath.get(path) || 0) + (Number(row?.y) || 0));
			}

			document.querySelectorAll("[data-umami-pageviews]").forEach((element) => {
				const value = viewsByPath.get(normalizePath(element.getAttribute("data-umami-pageviews"))) || 0;
				element.textContent = formatNumber(value);
			});
		}

		function renderSiteStats(stats, todayStats) {
			document.querySelectorAll('[data-umami-stat="todayVisitors"]').forEach((element) => {
				if (todayStats) renderStatValue(element, todayStats.visitors);
			});
			document.querySelectorAll('[data-umami-stat="todayPageviews"]').forEach((element) => {
				if (todayStats) renderStatValue(element, todayStats.pageviews);
			});
			document.querySelectorAll('[data-umami-stat="visitors"]').forEach((element) => {
				if (stats) renderStatValue(element, (Number(stats.visitors) || 0) + historicalVisitorCount);
			});
			document.querySelectorAll('[data-umami-stat="pageviews"]').forEach((element) => {
				if (stats) renderStatValue(element, (Number(stats.pageviews) || 0) + historicalPageviewCount);
			});
			renderFriendSitePageviews(stats);
		}

		// 友链页「本站主理人」条目里的本站总访问次数。
		// 数值来自 Umami 站点总 PV（与页脚统计同源），超过一万按「万」缩写。
		function renderFriendSitePageviews(stats) {
			if (!stats) return;
			const count = (Number(stats.pageviews) || 0) + historicalPageviewCount;
			const text = count >= 10000 ? `${(count / 10000).toFixed(1)}w` : formatNumber(count);
			document.querySelectorAll("[data-friend-site-pageviews]").forEach((element) => {
				element.textContent = text;
				const badge = element.closest(".friend-site-visit-count");
				const label = `本站总访问 ${formatNumber(count)} 次`;
				badge?.setAttribute("title", label);
				badge?.setAttribute("aria-label", label);
			});
		}

		function renderFriendClickCounts(values) {
			const countsBySite = new Map();
			const addRows = (result) => {
				const rows = Array.isArray(result) ? result : result?.data || [];
				for (const row of rows) {
					const site = normalizeSiteUrl(row?.value);
					if (!site) continue;
					countsBySite.set(site, (countsBySite.get(site) || 0) + (Number(row?.total) || 0));
				}
			};

			addRows(values?.friendClicks);
			addRows(values?.legacyOutboundClicks);
			friendClickCountsBySite.clear();
			countsBySite.forEach((count, site) => friendClickCountsBySite.set(site, count));

			renderFriendClickBadges();
		}

		function renderFriendClickBadges() {
			document.querySelectorAll("[data-friend-clicks-for]").forEach((element) => {
				const site = normalizeSiteUrl(element.getAttribute("data-friend-clicks-for"));
				const count = (friendClickCountsBySite.get(site) || 0) + (friendClickPreviewCounts.get(site) || 0);
				const valueElement = element.querySelector("[data-friend-clicks-value]");
				if (valueElement && count > 0) valueElement.textContent = formatNumber(count);
				if (count > 0) element.setAttribute("aria-label", `从本站点击 ${formatNumber(count)} 次`);
			});
		}

		// 点击乐观计数：点击友链卡片的瞬间徽章立即 +1（sessionStorage 记录，仅当前浏览器
		// 会话有效），真实上报仍由 Umami tracker 完成。生产环境点击会真实上报，4 秒后强制
		// 重拉服务端聚合值（已包含刚上报的点击事件）并替换乐观值，避免出现"点击后数字不动"
		// 的观感；本地开发的上报被 data-domains 拦截，服务端不会计入本地点击，因此乐观值
		// 保留整个会话，不做同步回退。
		const friendClickPreviewKey = "rainzt:umami:friend-click-preview";
		const friendClickPreviewCounts = new Map();
		const pendingPreviewSyncs = new Map();

		function loadFriendClickPreview() {
			try {
				const parsed = JSON.parse(sessionStorage.getItem(friendClickPreviewKey) || "null");
				if (parsed && typeof parsed === "object") {
					Object.entries(parsed).forEach(([site, count]) => {
						const value = Math.floor(Number(count));
						const key = normalizeSiteUrl(site);
						if (key && Number.isFinite(value) && value > 0) friendClickPreviewCounts.set(key, value);
					});
				}
			} catch {
				// sessionStorage 不可用时跳过，仅影响点击瞬间的乐观显示
			}
		}

		function saveFriendClickPreview() {
			try {
				sessionStorage.setItem(
					friendClickPreviewKey,
					JSON.stringify(Object.fromEntries(friendClickPreviewCounts)),
				);
			} catch {
				// 忽略写入失败
			}
		}

		function scheduleFriendClickSync(site) {
			if (pendingPreviewSyncs.has(site)) return;
			const timer = window.setTimeout(() => {
				pendingPreviewSyncs.delete(site);
				Promise.resolve(refresh(true)).then(() => {
					if (friendClickCountsBySite.size > 0) {
						friendClickPreviewCounts.delete(site);
						saveFriendClickPreview();
						renderFriendClickBadges();
					}
				});
			}, 4000);
			pendingPreviewSyncs.set(site, timer);
		}

		function handleFriendClickPreview(event) {
			const target = event.target;
			const link = target instanceof Element ? target.closest('[data-umami-event="friend-link-click"]') : null;
			if (!link) return;
			const site = normalizeSiteUrl(link.getAttribute("data-umami-event-site"));
			if (!site) return;
			friendClickPreviewCounts.set(site, (friendClickPreviewCounts.get(site) || 0) + 1);
			saveFriendClickPreview();
			renderFriendClickBadges();
			if (!isLocalAnalytics) scheduleFriendClickSync(site);
		}

		loadFriendClickPreview();
		if (!window.__rainztFriendClickPreviewBound) {
			window.__rainztFriendClickPreviewBound = true;
			document.addEventListener("click", handleFriendClickPreview, true);
		}

		const replaySummaryAnimations = () => {
			document.querySelectorAll(".analytics-summary [data-umami-stat]").forEach((element) => {
				const target = Number(element.dataset.analyticsTarget);
				if (!Number.isFinite(target)) return;
				element.dataset.analyticsCount = "0";
				element.textContent = formatNumber(0);
				renderStatValue(element, target);
			});
		};
		if (!window.__rainztAnalyticsReplayBound) {
			window.addEventListener("rainzt-analytics-animation-replay", replaySummaryAnimations);
			window.__rainztAnalyticsReplayBound = true;
		}

		function markUnavailable() {
			document.querySelectorAll("[data-umami-pageviews]").forEach((element) => {
				element.textContent = "加载中";
			});
			document.querySelectorAll('[data-umami-stat="visitors"]').forEach((element) => {
				element.textContent = "加载中";
			});
			document.querySelectorAll('[data-umami-stat="pageviews"]').forEach((element) => {
				element.textContent = "加载中";
			});
			document.querySelectorAll('[data-umami-stat="todayVisitors"], [data-umami-stat="todayPageviews"]').forEach((element) => {
				element.textContent = "加载中";
			});
		}

		async function refresh(forceRefresh = false) {
			const blockLocalStats = shouldBlockLocalStats();
			const needsViews = !blockLocalStats && Boolean(document.querySelector("[data-umami-pageviews]"));
			const statElements = blockLocalStats ? [] : [...document.querySelectorAll("[data-umami-stat]")];
			const needsStats = statElements.length > 0;
			const needsTodayStats = statElements.some((element) =>
				["todayVisitors", "todayPageviews"].includes(element.getAttribute("data-umami-stat")),
			);
			const needsFriendClickCounts = Boolean(document.querySelector("[data-friend-clicks-for]"));
			// 友链页「本站主理人」条目需要站点总 PV，同样依赖 stats 接口，
			// 因此即使页面上没有 [data-umami-stat] 元素也要拉取。
			const needsSitePageviews = Boolean(
				document.querySelector("[data-friend-site-pageviews]"),
			);
			if (!needsViews && !needsStats && !needsFriendClickCounts && !needsSitePageviews)
				return;

			try {
				const share = await getShare();
				const now = Date.now();
				const dayStart = getLocalDayStart(now);
				const tasks = await Promise.allSettled([
					needsViews ? getMetrics(share, forceRefresh) : Promise.resolve(null),
					needsStats || needsSitePageviews
						? getStats(share, 0, now, "all", forceRefresh)
						: Promise.resolve(null),
					needsTodayStats
						? getStats(share, dayStart, now, `today:${dayStart}`, forceRefresh)
						: Promise.resolve(null),
					needsFriendClickCounts
						? getFriendClickCounts(share, forceRefresh)
						: Promise.resolve(null),
				]);
				const metrics = tasks[0].status === "fulfilled" ? tasks[0].value : null;
				const stats = tasks[1].status === "fulfilled" ? tasks[1].value : null;
				const todayStats = tasks[2].status === "fulfilled" ? tasks[2].value : null;
				const friendClickCounts = tasks[3].status === "fulfilled" ? tasks[3].value : null;
				if (metrics) renderPageViews(metrics);
				if (needsStats) renderSiteStats(stats, todayStats);
				else if (needsSitePageviews) renderFriendSitePageviews(stats);
				if (friendClickCounts) renderFriendClickCounts(friendClickCounts);
				if (!metrics && needsViews) {
					document.querySelectorAll("[data-umami-pageviews]").forEach((element) => {
						element.textContent = "加载中";
					});
				}
			} catch {
				markUnavailable();
			}
		}

		if (window[namespace]) {
			window[namespace]();
			return;
		}

		let scheduled = false;
		let delayedRefreshTimer;
		const scheduleRefresh = () => {
			if (scheduled) return;
			scheduled = true;
			requestAnimationFrame(() => {
				scheduled = false;
				refresh();
			});
			if (delayedRefreshTimer) window.clearTimeout(delayedRefreshTimer);
			delayedRefreshTimer = window.setTimeout(() => refresh(true), 4000);
		};

		window[namespace] = scheduleRefresh;
		document.addEventListener("astro:page-load", scheduleRefresh);
		document.addEventListener("swup:contentReplaced", scheduleRefresh);
		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", scheduleRefresh, { once: true });
		} else {
			scheduleRefresh();
		}
	})();
</script>