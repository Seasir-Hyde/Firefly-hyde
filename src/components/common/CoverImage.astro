---
import ImageWrapper from "@/components/common/ImageWrapper.astro";
import { coverImageConfig } from "@/config";
import type { ImageFormat, ResponsiveImageLayout } from "@/types/config";
import {
	getImageFormats,
	getImageQuality,
	shouldAddNoReferrer,
} from "@/utils/image-utils";
import { getLqipProps } from "@/utils/lqip-utils";
import { url } from "@/utils/url-utils";
import { getImage } from "astro:assets";

interface Props {
	id?: string;
	src: string;
	class?: string;
	alt?: string;
	position?: string;
	basePath?: string;
	preview?: boolean;
	layout?: ResponsiveImageLayout;
	formats?: ImageFormat[];
	loading?: "lazy" | "eager";
	apiUrls?: string[];
	// 高度跟随图片本身宽高比（不裁上下，只裁两边），用于文章详情页封面
	naturalHeight?: boolean;
}

const {
	id,
	src,
	alt,
	position = "center",
	basePath = "/",
	preview = false,
	layout = "constrained",
	formats = getImageFormats(),
	loading = "lazy",
	apiUrls = [],
	naturalHeight = false,
} = Astro.props;

const configQuality = getImageQuality();
const className = Astro.props.class;

// 判断图片类型
const isLocal = !(
	src.startsWith("/") ||
	src.startsWith("http") ||
	src.startsWith("https") ||
	src.startsWith("data:")
);
const isPublic = src.startsWith("/");

// 图片样式
const imageClass =
	"w-full h-full object-cover opacity-0 transition-opacity duration-500 ease-out";
const imageStyle = `object-position: ${position};`;

// LQIP 渐变占位
const lqipProps = isLocal
	? getLqipProps(src, basePath)
	: isPublic
		? getLqipProps(src, basePath, true)
		: getLqipProps(src);

// 列表卡片和文章详情共享同一组封面产物
const widths = [828];
const sizes = preview
	? "(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 320px"
	: "(max-width: 768px) 100vw, 828px";
const quality = configQuality;

// 是否显示加载动画
const showLoading = coverImageConfig.showLoading ?? true;

// 显式宽高：为封面图建立固有宽高比，消除布局偏移（CLS），并满足 Lighthouse “设置显式宽高”审计。
// 默认值 2:1 与文章卡片封面容器（PostCard 的 aspect-ratio: 2/1）一致；详情页自然高度模式不设固定宽高，避免比例冲突导致 CLS。
const coverWidth = 828;
const coverHeight = naturalHeight ? undefined : 414;

// 检查远程图片是否需要 referrerpolicy
const remoteReferrerPolicy =
	!isLocal && shouldAddNoReferrer(isPublic ? url(src) : src)
		? "no-referrer"
		: undefined;

// 构建期远程封面优化：把随机封面 API 返回的原始大图（t.alcy.cc 全分辨率、dmoe.cc 高达 1.66MB、uapis.cn ~537KB）
// 在构建期用 sharp 重采样为 828 webp，真正削减体积、修复 LCP。优化后的本地产物同时写入 data-api-urls 重试链，
// 使“主封面 + 全部备选封面”都变成小体积本地 webp，彻底消除首屏 4K 远程图。
// 仅对博客封面所用的三个已知图源做优化；公开资源(/...)与未知主机保持原样，避免误优化 public 文件或对任意 URL 发起请求（SSRF 风险）。
// 若构建期无法拉取/优化（图源不可达等），回退到原始远程 URL，保证构建不失败，且客户端重试逻辑仍可用。
const COVER_REMOTE_HOSTS = ["t.alcy.cc", "www.dmoe.cc", "uapis.cn"];

let primaryOptimizedSrc: string | undefined;

if (!isLocal && !isPublic) {
	let host = "";
	try {
		host = new URL(src).hostname;
	} catch {
		host = "";
	}
	if (COVER_REMOTE_HOSTS.includes(host)) {
		try {
			const optimized = await getImage({
				src,
				width: 828,
				format: "webp",
				quality,
				// 固定 2:1 裁切（与 PostCard 封面容器一致）；详情页自然高度模式不裁上下，仅限宽
				...(naturalHeight ? {} : { height: 414, fit: "cover" }),
			});
			primaryOptimizedSrc = optimized.src;
		} catch (e) {
			if (import.meta.env.DEV) {
				console.warn("[CoverImage] 远程封面优化失败，回退原始 URL:", src, (e as Error)?.message);
			}
			primaryOptimizedSrc = undefined;
		}
	}
}
---

<div
	id={id}
	class:list={[className, "cover-image-container overflow-hidden relative"]}
	data-loading={showLoading ? "true" : "false"}
	data-api-urls={apiUrls.length > 0 ? JSON.stringify(apiUrls) : undefined}
	data-natural-height={naturalHeight ? "true" : undefined}
>
	<!-- LQIP 渐变占位 -->
	<div class="lqip-placeholder absolute inset-0 pointer-events-none" style={lqipProps.style} aria-hidden="true"></div>

	<!-- 加载动画 -->
	{showLoading && (
		<div class="loading-spinner absolute inset-0 flex items-center justify-center z-10" style="background-color: var(--card-bg);">
			<div class="spinner"></div>
		</div>
	)}

	<!-- 错误提示 -->
	<div class="error-message absolute inset-0 items-center justify-center z-20 hidden pointer-events-none">
		<span class="text-white text-sm px-3 py-1 rounded-sm bg-black/50">Image API Error</span>
	</div>

	<!-- 本地图片 -->
	{isLocal && (
		<ImageWrapper
			src={src}
			basePath={basePath}
			alt={alt || ""}
			class="w-full h-full"
			position={position}
			loading={loading}
			formats={formats}
			quality={quality}
			layout={layout}
			width={828}
			widths={widths}
			sizes={sizes}
			dataCoverImg={true}
			showLqip={false}
			showOverlay={false}
		/>
	)}

	<!-- 远程图片 -->
	{!isLocal && (
		primaryOptimizedSrc ? (
			<img
				src={primaryOptimizedSrc}
				alt={alt || ""}
				class={imageClass}
				style={imageStyle}
				width={coverWidth}
				height={coverHeight}
				loading={loading}
				decoding="async"
				fetchpriority={loading === "eager" ? "high" : "auto"}
				data-cover-img
				data-remote="true"
			/>
		) : (
			<img
				src={isPublic ? url(src) : src}
				alt={alt || ""}
				class={imageClass}
				style={imageStyle}
				width={coverWidth}
				height={coverHeight}
				loading={loading}
				decoding="async"
				fetchpriority={loading === "eager" ? "high" : "auto"}
				data-cover-img
				data-remote="true"
				referrerpolicy={remoteReferrerPolicy}
			/>
		)
	)}
</div>

<style>
	.cover-image-container {
		min-height: 150px;
	}

	@media (min-width: 768px) {
		.cover-image-container {
			min-height: 0;
		}
	}

	/* 加载动画容器 */
	.loading-spinner {
		transition: opacity 0.3s ease-out;
	}

	/* 加载完成后隐藏 */
	.cover-image-container[data-loading="false"] .loading-spinner {
		opacity: 0;
		pointer-events: none;
	}

	/* 错误状态隐藏加载动画 */
	.cover-image-container[data-error="true"] .loading-spinner {
		display: none;
	}

	/* 错误状态显示错误信息 */
	.cover-image-container[data-error="true"] .error-message {
		display: flex;
	}

	/* 错误状态隐藏失败的远程图片 */
	.cover-image-container[data-error="true"] img[data-remote="true"] {
		display: none;
	}

	/* 旋转加载动画 */
	.spinner {
		width: 40px;
		height: 40px;
		border: 3px solid oklch(0.9 0.05 var(--hue));
		border-top-color: oklch(0.6 0.15 var(--hue));
		border-radius: 50%;
		animation: spin 0.8s linear infinite;
	}

	@keyframes spin {
		to {
			transform: rotate(360deg);
		}
	}

	/* 图片样式（height 用 !important 覆盖 Astro Picture/Image 注入的 height:auto，
	   使本地图也能像远程图一样以 object-fit: cover 填满容器，与主页卡片封面行为一致） */
	.cover-image-container img {
		width: 100%;
		height: 100% !important;
		object-fit: cover;
	}

	/* 自然高度模式（详情页封面）：高度跟随图片原始宽高比，不裁上下、只裁两边 */
	.cover-image-container[data-natural-height] {
		min-height: 0;
	}
	.cover-image-container[data-natural-height] img {
		height: auto !important;
	}
</style>

<script>
	function initCoverImages() {
		const containers = document.querySelectorAll('.cover-image-container');
		containers.forEach((container) => {
			if (container.hasAttribute('data-initialized')) return;
			container.setAttribute('data-initialized', 'true');

			const img = container.querySelector('img[data-cover-img]') as HTMLImageElement | null;
			if (!img) return;

			// 解析API URL列表，用于按顺序重试
			let apiUrls: string[] = [];
			let currentApiIndex = 1; // 0号已由服务端设为img.src
			const apiUrlsAttr = container.getAttribute('data-api-urls');
			if (apiUrlsAttr) {
				try { apiUrls = JSON.parse(apiUrlsAttr); } catch (_e) { /* ignore */ }
			}

			const hideLoading = () => {
				container.setAttribute('data-loading', 'false');
				img.style.opacity = '1';
				const placeholder = container.querySelector('.lqip-placeholder') as HTMLElement | null;
				if (placeholder) placeholder.classList.add('loaded');
			};

			const showError = () => {
				container.setAttribute('data-loading', 'false');
				container.setAttribute('data-error', 'true');
			};

			// 统一的错误处理：尝试下一个API或显示错误提示
			const onError = () => {
				if (img.dataset.remote !== 'true') return;

				if (currentApiIndex < apiUrls.length) {
					// 先绑定好事件，再更换src
					img.addEventListener('load', hideLoading, { once: true });
					img.addEventListener('error', onError, { once: true });
					img.src = apiUrls[currentApiIndex];
					currentApiIndex++;
				} else {
					showError();
				}
			};

			if (img.complete) {
				if (img.naturalWidth > 0) {
					hideLoading();
				} else {
					onError();
				}
			} else {
				img.addEventListener('load', hideLoading, { once: true });
				img.addEventListener('error', onError, { once: true });
			}
		});
	}

	// 防止 Swup 切页重跑脚本时重复注册监听器（initCoverImages 由一次性 astro:page-load 监听器在切页时触发）
	if (!window.__coverImageInit) {
		window.__coverImageInit = true;
		initCoverImages();
		document.addEventListener('astro:page-load', initCoverImages);
	}
</script>
