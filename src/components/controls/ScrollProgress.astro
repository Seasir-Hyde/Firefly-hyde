---
---

<div
  id="scroll-progress-circle"
  class="scroll-progress-circle"
  role="img"
  aria-label="页面滚动进度 0%"
>
  <svg viewBox="0 0 48 48" aria-hidden="true" focusable="false">
    <circle class="scroll-progress-circle__track" cx="24" cy="24" r="19" pathLength="100" />
    <circle
      id="scroll-progress-circle-value"
      class="scroll-progress-circle__value"
      cx="24"
      cy="24"
      r="19"
      pathLength="100"
    />
  </svg>
  <span id="scroll-progress-circle-label">0%</span>
</div>

<script is:inline>
  (function () {
    var root = null;
    var valueCircle = null;
    var label = null;
    var ticking = false;
    var lastPercent = -1;

    function resolve() {
      root = document.getElementById("scroll-progress-circle");
      valueCircle = root
        ? root.querySelector(".scroll-progress-circle__value")
        : null;
      label = document.getElementById("scroll-progress-circle-label");
    }

    function getScrollState() {
      // 优先使用标准滚动元素，兼容 window / documentElement 两种取值方式
      var scrollingElement =
        document.scrollingElement || document.documentElement || document.body;
      var scrollTop =
        window.pageYOffset ||
        window.scrollY ||
        scrollingElement.scrollTop ||
        document.body.scrollTop ||
        0;
      var scrollHeight = Math.max(
        scrollingElement.scrollHeight,
        document.documentElement.scrollHeight,
        document.body.scrollHeight,
      );
      var clientHeight = Math.max(
        document.documentElement.clientHeight,
        window.innerHeight || 0,
        scrollingElement.clientHeight,
      );
      var scrollable = scrollHeight - clientHeight;
      return { scrollTop: scrollTop, scrollable: scrollable };
    }

    function update() {
      ticking = false;
      // Swup 切页后元素会被替换，缓存失效时重新取一次
      if (!root || !root.isConnected) resolve();
      if (!root || !valueCircle) return;

      var state = getScrollState();
      var percent = state.scrollable > 0 ? (state.scrollTop / state.scrollable) * 100 : 0;
      percent = Math.min(100, Math.max(0, Math.round(percent)));
      if (percent === lastPercent) return;
      lastPercent = percent;

      // pathLength=100，dashoffset 直接等于「剩余百分比」
      valueCircle.style.strokeDashoffset = String(100 - percent);
      if (label) label.textContent = percent + "%";
      root.setAttribute("aria-label", "页面滚动进度 " + percent + "%");
    }

    function scheduleUpdate() {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(update);
    }

    function init() {
      resolve();
      update();
      if (window.__scrollProgressCircleBound) return;
      window.__scrollProgressCircleBound = true;

      // capture 可同时覆盖 window 滚动和主题里可能的滚动容器
      window.addEventListener("scroll", scheduleUpdate, {
        passive: true,
        capture: true,
      });
      document.addEventListener("scroll", scheduleUpdate, {
        passive: true,
        capture: true,
      });
      window.addEventListener("resize", scheduleUpdate, { passive: true });
      document.addEventListener("visibilitychange", scheduleUpdate);

      // 内容高度变化（异步加载、图片撑开）后需要重算
      if (typeof ResizeObserver !== "undefined") {
        var resizeObserver = new ResizeObserver(scheduleUpdate);
        resizeObserver.observe(document.documentElement);
        if (document.body) resizeObserver.observe(document.body);
      }

      // 切页后 DOM 变了，但不一定触发 scroll，需要主动重算
      document.addEventListener("astro:page-load", function () {
        lastPercent = -1;
        scheduleUpdate();
      });
      document.addEventListener("swup:contentReplaced", function () {
        lastPercent = -1;
        scheduleUpdate();
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init, { once: true });
    } else {
      init();
    }
  })();
</script>

<style>
  .scroll-progress-circle {
    position: relative;
    display: grid;
    flex: none;
    width: 3rem;
    height: 3rem;
    place-items: center;
    color: var(--primary);
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 1rem;
    background-color: var(--card-bg);
    box-shadow: none;
    backdrop-filter: blur(12px);
    transition: background-color 0.15s ease;
    overflow: hidden;
    pointer-events: none;
  }

  .scroll-progress-circle svg {
    position: absolute;
    inset: 0.18rem;
    width: calc(100% - 0.36rem);
    height: calc(100% - 0.36rem);
    overflow: visible;
    transform: rotate(-90deg);
  }

  .scroll-progress-circle circle {
    fill: none;
    stroke-linecap: round;
    stroke-width: 3.5;
  }

  .scroll-progress-circle__track {
    stroke: color-mix(in srgb, var(--primary) 14%, var(--line-divider));
  }

  .scroll-progress-circle__value {
    stroke: var(--primary);
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    transition: stroke-dashoffset 120ms linear;
  }

  .scroll-progress-circle > span {
    position: relative;
    z-index: 1;
    min-width: 2.3em;
    color: var(--primary);
    font-size: 0.68rem;
    font-weight: 800;
    line-height: 1;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  :global(.dark) .scroll-progress-circle {
    background-color: var(--card-bg);
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  @media (max-width: 768px) {
    .scroll-progress-circle {
      width: 3rem;
      height: 3rem;
      border-radius: 1rem;
    }
  }

  @media (max-width: 480px) {
    .scroll-progress-circle {
      width: 2.5rem;
      height: 2.5rem;
      border-radius: 1rem;
    }
  }

  @media (max-width: 360px) {
    .scroll-progress-circle {
      width: 2rem;
      height: 2rem;
      border-radius: 1rem;
    }

    .scroll-progress-circle > span {
      font-size: 0.55rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-progress-circle__value {
      transition: none;
    }
  }
</style>
