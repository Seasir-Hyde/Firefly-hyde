---
/**
 * FontSetup.astro
 *
 * 使用 Astro Font API（<Font /> 组件）统一管理字体加载。
 * 字体定义在 fontConfig.ts 的 fonts 数组中配置，
 * 本组件负责渲染 <Font /> 标签并设置 body 字体和区域覆盖 CSS 变量。
 *
 * 字体的 fallback 由各字体定义中的 fallbacks 字段控制（Astro Font API 处理），
 */
import { Font } from "astro:assets";
import { fontConfig } from "@/config";
import {
	collectUsedFontCssVars,
	resolveDefaultFontMode,
	resolveFontSwitchOptions,
} from "@/utils/fontHelper";

// 使用共享的工具函数收集所有需要加载的 CSS 变量名（selected + 各区域字体，去重）
// enable=false 时返回空集，不会加载任何字体
const allCssVars = fontConfig.enable
	? collectUsedFontCssVars(fontConfig)
	: new Set<string>();

// 统一解析 selected 为数组（用于后续 body font-family 和 preload 判断）
const selectedIds: string[] =
	fontConfig.enable && fontConfig.selected
		? Array.isArray(fontConfig.selected)
			? fontConfig.selected
			: [fontConfig.selected]
		: [];

// 生成 body 的 font-family 值
// 每个字体的 fallback 由其在 fonts 中的 fallbacks 字段控制
// 这里只拼接 CSS 变量引用，末尾加系统字体作为最终保底
const SYSTEM_FONT_STACK =
	"system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, sans-serif";
// 代码字体的系统保底栈，codeFont 没配置或字体加载失败时用它，保证行内代码/代码块始终是等宽字体
const MONO_FONT_STACK =
	'ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace';
const selectedFontVars = selectedIds.filter((v) => v !== "system");
const bodyFontFamily =
	selectedFontVars.length > 0
		? [...selectedFontVars.map((v) => `var(${v})`), SYSTEM_FONT_STACK].join(
				", ",
			)
		: SYSTEM_FONT_STACK;

// 各区域字体 CSS 变量值
const bannerTitleFontVar = fontConfig.enable
	? fontConfig.bannerTitleFont || ""
	: "";
const bannerSubtitleFontVar = fontConfig.enable
	? fontConfig.bannerSubtitleFont || ""
	: "";
const navbarTitleFontVar = fontConfig.enable
	? fontConfig.navbarTitleFont || ""
	: "";
const codeFontVar = fontConfig.enable ? fontConfig.codeFont || "" : "";
// --font-code 由 fontConfig.codeFont 决定，行内代码和代码块统一引用它
// 末尾始终带 MONO_FONT_STACK 保底，避免 codeFont 为空时 var() 解析失败导致字体回退到正文字体
const codeFontFamily = codeFontVar
	? `var(${codeFontVar}, ${MONO_FONT_STACK})`
	: MONO_FONT_STACK;

// ─── 字体样式切换 ───────────────────────────────────────────
// 可切换档位与默认档位（与 FontSwitch.svelte 共用同一份配置解析逻辑）
const switchOptions = resolveFontSwitchOptions(fontConfig);
const defaultFontMode = resolveDefaultFontMode(fontConfig);
const fontSwitchEnabled = switchOptions.length > 0 && defaultFontMode !== null;
const fontStorageKey = fontConfig.switchable?.storageKey || "firefly-font-mode";
// 合法档位 id 列表，供前端校验 localStorage 中保存的值
const switchIds = switchOptions.map((o) => o.id);

// 各档位的字体族。cssVariable 为 "system" 时使用系统字体栈。
const buildFontStack = (cssVariable: string): string => {
	if (!cssVariable || cssVariable === "system") return SYSTEM_FONT_STACK;
	return `var(${cssVariable}, ${SYSTEM_FONT_STACK})`;
};

// 原始（未切换）状态下各区域的字体族，作为切换的对照基准
const originalBannerTitle = bannerTitleFontVar
	? `var(${bannerTitleFontVar}, ${SYSTEM_FONT_STACK})`
	: SYSTEM_FONT_STACK;
const originalBannerSubtitle = bannerSubtitleFontVar
	? `var(${bannerSubtitleFontVar}, ${SYSTEM_FONT_STACK})`
	: SYSTEM_FONT_STACK;
const originalNavbarTitle = navbarTitleFontVar
	? `var(${navbarTitleFontVar}, ${SYSTEM_FONT_STACK})`
	: SYSTEM_FONT_STACK;
---

<!-- Astro Font API: 自动下载、缓存并生成优化的 @font-face -->
<!-- 性能优化：关闭字体 preload。345KB 级别的中文字体若预加载会阻塞首屏关键路径；
     改用 font-display:swap（Astro Font 默认），文字先用系统字体渲染，字体到位后无感替换，
     首屏 FCP/LCP 不再被巨量字体下载拖慢。 -->
{Array.from(allCssVars).map((cssVar) => (
  <Font
    cssVariable={cssVar as any}
    preload={false}
  />
))}

<!-- 区域字体 CSS 变量 + body 字体 -->
<!-- --font-code 无条件输出，即使关闭自定义字体，行内代码和代码块也要保持等宽字体 -->
<style
  set:html={`
  :root {
    --font-code: ${codeFontFamily};
    ${bannerTitleFontVar ? `--font-banner-title: var(${bannerTitleFontVar}, inherit);` : ""}
    ${bannerSubtitleFontVar ? `--font-banner-subtitle: var(${bannerSubtitleFontVar}, inherit);` : ""}
    ${navbarTitleFontVar ? `--font-navbar-title: var(${navbarTitleFontVar}, inherit);` : ""}
  }

  ${
		fontConfig.enable &&
		(bannerTitleFontVar ||
			bannerSubtitleFontVar ||
			navbarTitleFontVar ||
			selectedFontVars.length > 0)
			? `body {
      font-family: ${bodyFontFamily};
    }`
			: ""
	}
`}
/>

{
	fontSwitchEnabled && (
		<style
			is:global
			set:html={`
    /* ─── 字体样式切换 ───────────────────────────────────────
       原始字体（未切换）保存在 --font-original-* 变量中，
       --font-active-* 指向当前生效的字体族。
       切换时只改 data-font-mode 属性，CSS 变量随之重指向，
       无需重新加载页面或重新应用样式。 */
    :root {
      --font-original-sans: ${bodyFontFamily};
      --font-original-banner-title: ${originalBannerTitle};
      --font-original-banner-subtitle: ${originalBannerSubtitle};
      --font-original-navbar-title: ${originalNavbarTitle};

      --font-active-sans: var(--font-original-sans);
      --font-active-banner-title: var(--font-original-banner-title);
      --font-active-banner-subtitle: var(--font-original-banner-subtitle);
      --font-active-navbar-title: var(--font-original-navbar-title);
    }

    ${switchOptions
			.filter((o) => o.id !== defaultFontMode)
			.map(
				(o) => `
    :root[data-font-mode="${o.id}"] {
      --font-active-sans: ${buildFontStack(o.cssVariable)};
      --font-active-banner-title: ${buildFontStack(o.cssVariable)};
      --font-active-banner-subtitle: ${buildFontStack(o.cssVariable)};
      --font-active-navbar-title: ${buildFontStack(o.cssVariable)};
    }`,
			)
			.join("\n")}

    /* 正文与表单控件跟随当前字体档位。
       --font-code 不在其中：代码块始终保持等宽字体，不随档位变化。 */
    body,
    button,
    input,
    textarea,
    select {
      font-family: var(--font-active-sans);
    }
  `}
		/>
	)
}

{
	fontSwitchEnabled && (
		<script is:inline define:vars={{ fontStorageKey, defaultFontMode, switchIds }}>
			// 尽早恢复访客选择的字体档位，避免首屏闪烁回默认字体。
			// 内联脚本放在 <head> 之前执行，先于首次绘制。
			(() => {
				try {
					const saved = localStorage.getItem(fontStorageKey);
					const mode =
						saved && switchIds.includes(saved) ? saved : defaultFontMode;
					document.documentElement.dataset.fontMode = mode;
				} catch {
					// 隐私模式下 localStorage 可能不可用，静默回退到默认档位
					document.documentElement.dataset.fontMode = defaultFontMode;
				}
			})();
		</script>
	)
}

<script>
  // 字体加载完成事件
  if (document.fonts && typeof document.fonts.ready !== "undefined") {
    document.fonts.ready
      .then(() => {
        document.dispatchEvent(new CustomEvent("fontsLoaded"));
      })
      .catch((error) => {
        console.warn("Font loading failed:", error);
      });
  }
</script>
