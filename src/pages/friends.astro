---
import { getEntry, render } from "astro:content";
// 友链“xxx 次”点击计数徽章的数据源组件（内部即 Umami 指标聚合逻辑，文件名沿用历史命名）
import MicrosoftClarity from "@components/analytics/MicrosoftClarity.astro";
import Comment from "@components/comment/index.astro";
import Markdown from "@components/common/Markdown.astro";
import FriendAvatarMarquee from "@components/friends/FriendAvatarMarquee.astro";
import FriendsMagicLink from "@components/friends/FriendsMagicLink.astro";
import { Icon } from "astro-icon/components";
import {
	analyticsConfig,
	commentConfig,
	friendsPageConfig,
	getEnabledFriends,
	siteConfig,
} from "@/config";
import friendsLatencySnapshot from "@/data/friends-latency-snapshot.json";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import type { FriendLatencySnapshot } from "@/types/friendLatency";
import { getFriendLatencyDisplay } from "@/utils/friend-latency";
import {
	formatRemediationCountdown,
	remediationSeconds,
} from "@/utils/friend-remediation";
import { normalizeFriendUrl } from "@/utils/friend-url";
import {
	buildFriendUpdateMap,
	fetchRemoteFriends,
	loadFriendsFeed,
	REMOTE_FRIENDS_API_URL,
	remoteFriendToFriendLink,
} from "@/utils/friends-feed";
import "@/styles/pages/common.css";
import "@/styles/pages/friends.css";
import "@/styles/friends-magic-link.css";

// 检查页面是否启用
if (!siteConfig.pages.friends) {
	return Astro.redirect("/404/");
}

// 友链“xxx 次”点击计数徽章：数据来自自建 Umami 的 friend-link-click 自定义事件聚合，
// 由 MicrosoftClarity 组件（Umami 指标逻辑）在客户端拉取并填充 [data-friend-clicks-for] 徽章
const umamiAnalytics = analyticsConfig.umamiAnalytics;
const umamiShareApiBase = umamiAnalytics?.scriptUrl
	? new URL(umamiAnalytics.scriptUrl).origin
	: "";

const friendsPost = await getEntry("spec", "friends");

if (!friendsPost) {
	throw new Error("friends page content not found");
}

const { Content } = await render(friendsPost);

// 检查评论系统是否启用
const isCommentEnabled =
	commentConfig?.type &&
	commentConfig.type !== "none" &&
	friendsPageConfig.showComment !== false;

// 使用配置文件中的友链数据，按权重排序
const items = getEnabledFriends();
// 需要引入: friendsProjects 配置（"加入的项目"区块数据源）- 待手动更新，先用空数组占位（区块自动隐藏）
const projects: {
	siteurl: string;
	imgurl: string;
	title: string;
	desc: string;
	tags?: string[];
	screenshot?: string;
}[] = [];
const allTags = [...new Set(items.flatMap((item) => item.tags || []))].sort();
const ownSiteUrl = normalizeFriendUrl(siteConfig.site_url);
// 延迟快照数据来自 src/data/friends-latency-snapshot.json（文件已存在，直接使用真实数据）
const latencySnapshot = friendsLatencySnapshot as FriendLatencySnapshot;

// 友链 RSS 聚合：每个友链站点的最新文章（构建期抓取，失败回落到快照缓存）
const feed = await loadFriendsFeed(items, { cachedOnly: import.meta.env.DEV });
const staleFeeds = new Set(
	feed.sources
		.filter((source) => source.stale)
		.map((source) => normalizeFriendUrl(source.friendUrl)),
);
const rssUpdates = new Map<
	string,
	{ date: Date; title: string; stale: boolean }
>();
for (const entry of feed.items) {
	if (!entry.publishedAt) continue;
	const key = normalizeFriendUrl(entry.friendUrl);
	const previous = rssUpdates.get(key);
	if (!previous || entry.publishedAt > previous.date) {
		rssUpdates.set(key, {
			date: entry.publishedAt,
			title: entry.title,
			stale: staleFeeds.has(key),
		});
	}
}
const rssDateLabel = (date: Date) =>
	date.toLocaleDateString("sv-SE", { timeZone: "Asia/Shanghai" });

// 远程友链：由 /api/friends 在运行时下发，构建期同样抓一次 RSS，
// 这样动态插入的卡片才能像本地友链一样显示「最后更新」。
// 接口不可用时降级为空列表：动态卡片回落到接口自带的记录更新时间。
const remoteFriends = await fetchRemoteFriends(REMOTE_FRIENDS_API_URL);
const remoteFeed = remoteFriends.length
	? await loadFriendsFeed(remoteFriends.map(remoteFriendToFriendLink), {
			cachedOnly: import.meta.env.DEV,
			// 远程友链数量多且多为小站，收紧超时与重试次数，避免拖慢构建
			timeoutMs: 5000,
			attempts: 2,
		})
	: null;
// 注入给浏览器端：动态卡片按站点 URL 查表取「最后更新」
const remoteFriendUpdates = remoteFeed ? buildFriendUpdateMap(remoteFeed) : {};

// 页面标题和描述
const title = friendsPageConfig.title || i18n(I18nKey.friends);
const description =
	friendsPageConfig.description || i18n(I18nKey.friendsDescription);

// ==================== 自助申请友链模块（保留勿动） ====================
// 站点信息和注意事项（带默认值）
const siteInfo = friendsPageConfig.site ?? {
	name: "",
	desc: "",
	url: "",
	avatar: "",
	rss: "",
};
const notes = friendsPageConfig.notes ?? [];

const escapedSiteName = (siteInfo.name || "").replace(/'/g, "\\'");
const escapedSiteDesc = (siteInfo.desc || "").replace(/'/g, "\\'");
const escapedSiteUrl = (siteInfo.url || "").replace(/'/g, "\\'");
const escapedSiteAvatar = (siteInfo.avatar || "").replace(/'/g, "\\'");
const escapedSiteRss = (siteInfo.rss || "").replace(/'/g, "\\'");
const copyAllOnClick = `navigator.clipboard.writeText('站点名称：${escapedSiteName}\\n站点描述：${escapedSiteDesc}\\n站点链接：${escapedSiteUrl}\\n头像链接：${escapedSiteAvatar}\\nRSS：${escapedSiteRss}');this.querySelectorAll('svg')[0].classList.add('hidden');this.querySelectorAll('svg')[1].classList.remove('hidden');setTimeout(()=>{this.querySelectorAll('svg')[0].classList.remove('hidden');this.querySelectorAll('svg')[1].classList.add('hidden')},1500)`;
---

<MainGridLayout title={title} description={description}>
  <div
    class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32"
  >
      <div class="card-base z-10 px-9 py-6 relative w-full">
      <!-- 页面标题和描述 -->
      <div class="friends-heading-row mb-4">
        <div class="friends-heading-copy">
          <div class="flex flex-wrap items-center gap-3 mb-0">
            <div
              class="h-8 w-8 shrink-0 rounded-lg bg-(--primary) flex items-center justify-center text-white dark:text-black/70"
            >
              <Icon is:inline name="material-symbols:group" class="text-[1.5rem]" />
            </div>
            <div class="shrink-0 whitespace-nowrap text-3xl font-bold text-neutral-900 dark:text-neutral-100">
              {title}
            </div>
            <span class="friends-count" aria-label={`当前共收录 ${items.length} 个友链`}>
              <strong>{items.length}</strong>
              <span>个</span>
            </span>
          </div>
          {
            description && (
              <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed mb-0">
                {description}
              </p>
            )
          }
        </div>

        {/* 右侧操作按钮：神奇按钮 + 随机访问 + 申请友链，与标题同一行右对齐 */}
        <div class="friends-heading-actions">
          <FriendsMagicLink />
          <button
            id="random-friend-btn"
            type="button"
            class="friend-action-btn relative flex items-center gap-1.5 px-3.5 py-2 rounded-lg text-(--primary) dark:text-white border border-(--primary) hover:-translate-y-0.5 hover:shadow-[0_8px_25px_rgba(0,0,0,0.15)] transition-all duration-200 text-sm font-medium cursor-pointer"
          >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="1em"
                height="1em"
                viewBox="0 0 512 512"
                class="text-base"
              >
                <!-- Icon from File Icons by John Gardner - https://github.com/file-icons/icons/blob/master/LICENSE.md -->
                <path
                  fill="currentColor"
                  d="M470.435 45.423L16.827 221.249c-18.254 8.188-24.428 24.585-4.412 33.484l116.37 37.173l281.368-174.79c15.363-10.973 31.091-8.047 17.557 4.024L186.053 341.075l-7.591 93.076c7.031 14.371 19.905 14.438 28.117 7.295l66.858-63.589l114.505 86.187c26.595 15.826 41.066 5.613 46.788-23.394l75.105-357.47c7.798-35.705-5.5-51.437-39.4-37.757"
                />
              </svg>
              <span class="hidden sm:inline">随机访问</span>
            </button>
            <button
              id="apply-friend-btn"
              type="button"
              class="friend-action-btn relative flex items-center gap-1.5 px-3.5 py-2 rounded-lg bg-(--primary) text-white dark:text-white border border-transparent hover:-translate-y-0.5 hover:shadow-[0_8px_25px_rgba(0,0,0,0.15)] transition-all duration-200 text-sm font-medium cursor-pointer"
            >
              <svg data-v-2d63c78e="" class="icon text-base" viewBox="0 13.8 1024 972" version="1.1" xmlns="http://www.w3.org/2000/svg" p-id="10543" width="1em" height="1em"><path data-v-2d63c78e="" d="M535.630769 821.169231l-41.353846-5.907693s-27.569231-5.907692-41.353846-11.815384c-7.876923-1.969231-17.723077 0-23.630769 5.907692l-9.846154 9.846154c-57.107692 57.107692-149.661538 63.015385-208.738462 11.815385-66.953846-57.107692-68.923077-159.507692-7.876923-220.553847l149.661539-149.661538c19.692308-19.692308 43.323077-31.507692 66.953846-39.384615 31.507692-7.876923 64.984615-5.907692 94.523077 5.907692 17.723077 7.876923 35.446154 17.723077 51.2 33.476923 7.876923 7.876923 13.784615 15.753846 19.692307 25.6 7.876923 13.784615 25.6 15.753846 35.446154 3.938462l55.138462-55.138462c7.876923-7.876923 7.876923-19.692308 1.969231-29.538462-7.876923-11.815385-17.723077-21.661538-27.569231-31.507692-13.784615-13.784615-29.538462-27.569231-47.261539-37.415384-27.569231-17.723077-59.076923-29.538462-92.553846-35.446154-61.046154-11.815385-128-1.969231-183.138461 27.56923-21.661538 11.815385-43.323077 27.569231-61.046154 45.292308l-143.753846 143.753846C17.723077 622.276923 9.846154 791.630769 110.276923 897.969231c104.369231 114.215385 281.6 116.184615 389.907692 7.876923l49.23077-49.230769c13.784615-9.846154 3.938462-33.476923-13.784616-35.446154zM897.969231 114.215385c-108.307692-100.430769-277.661538-92.553846-380.061539 11.815384L472.615385 169.353846c-13.784615 13.784615-3.938462 37.415385 13.784615 39.384616 27.569231 1.969231 55.138462 7.876923 82.707692 15.753846 7.876923 1.969231 17.723077 0 23.63077-5.907693l9.846153-9.846153c57.107692-57.107692 149.661538-63.015385 208.738462-11.815385 66.953846 57.107692 68.923077 159.507692 7.876923 220.553846L669.538462 567.138462c-19.692308 19.692308-43.323077 31.507692-66.953847 39.384615-31.507692 7.876923-64.984615 5.907692-94.523077-5.907692-17.723077-7.876923-35.446154-17.723077-51.2-33.476923-7.876923-7.876923-13.784615-15.753846-19.692307-25.6-7.876923-13.784615-25.6-15.753846-35.446154-3.938462l-55.138462 55.138462c-7.876923 7.876923-7.876923 19.692308-1.96923 29.538461 7.876923 11.815385 17.723077 21.661538 27.56923 31.507692 13.784615 13.784615 31.507692 27.569231 47.261539 37.415385 27.569231 17.723077 59.076923 29.538462 90.584615 35.446154 61.046154 11.815385 128 1.969231 183.138462-27.569231 21.661538-11.815385 43.323077-27.569231 61.046154-45.292308l149.661538-149.661538c110.276923-108.307692 106.338462-285.538462-5.907692-389.907692z" fill="currentColor" p-id="10544"></path></svg>
              <span class="hidden sm:inline">申请友链</span>
            </button>
        </div>
      </div>


      <!-- 友链头像跑马灯：快捷访问各友链站点，悬停预览站点截图 -->
      {
        items.length > 0 && (
          <FriendAvatarMarquee friends={items} ownSiteUrl={ownSiteUrl} />
        )
      }

      <!-- 搜索框 -->
      {
        items.length > 0 && (
          <friend-filter class="mb-6">
            <div class="relative mb-3">
              <Icon is:inline
                name="material-symbols:search"
                class="absolute left-3 top-1/2 -translate-y-1/2 text-neutral-400 dark:text-neutral-500 text-lg pointer-events-none"
              />
              <input
                type="text"
                data-search
                placeholder={i18n(I18nKey.searchFriends) || "搜索友链..."}
                class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-(--line-divider) bg-transparent text-neutral-900 dark:text-neutral-100 placeholder-neutral-400 dark:placeholder-neutral-500 focus:border-(--primary) focus:ring-1 focus:ring-(--primary) outline-none transition-all duration-200 text-sm"
              />
            </div>
            <div class="friend-filter-tags-shell" data-tags-shell>
              <div
                class="friend-filter-tags-viewport"
                data-tags-viewport
              >
                <div
                  id="friend-tags-list"
                  class="friend-filter-tags"
                  data-tags-list
                  aria-label="友链标签"
                >
                  <button
                    data-tag="all"
                    class="btn-regular px-3 py-1.5 rounded-lg bg-(--primary) text-white hover:bg-(--primary) transition-colors duration-200 text-sm font-medium"
                  >
                    {i18n(I18nKey.all)}
                  </button>
                  {allTags.map((tag) => (
                    <button
                      data-tag={tag}
                      class="btn-regular px-3 py-1.5 rounded-lg bg-(--btn-regular-bg) text-(--btn-content) hover:bg-(--btn-regular-bg-hover) transition-colors duration-200 text-sm font-medium"
                    >
                      {tag}
                    </button>
                  ))}
                </div>
              </div>
              <button
                type="button"
                data-tags-toggle
                data-expanded="false"
                aria-controls="friend-tags-list"
                aria-expanded="false"
                class="friend-filter-tags-toggle hidden"
              >
                <span data-tags-toggle-label>展开标签</span>
                <Icon is:inline name="material-symbols:expand-more-rounded" class="text-base transition-transform duration-200" />
              </button>
            </div>
          </friend-filter>
        )
      }

      <!-- 自助申请友链模块：动态加载状态 -->
      <div id="friends-loading" class="hidden my-4">
        <div class="flex items-center justify-center gap-2 text-(--content-meta)">
          <svg class="animate-spin w-5 h-5" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"/>
          </svg>
          <span>加载中...</span>
        </div>
      </div>

      <div class="friends-grid my-4" id="friends-grid">
        {
          items.length === 0 && (
            <div class="col-span-full flex flex-col items-center justify-center py-12 text-neutral-400 dark:text-neutral-500">
              <Icon is:inline name="material-symbols:group-off-outline" class="text-4xl mb-3" />
              <div class="text-sm">{i18n(I18nKey.friendsEmpty)}</div>
            </div>
          )
        }
        {
		items.map((item) => {
			const isOwnSite = normalizeFriendUrl(item.siteurl) === ownSiteUrl;
			const scheduledLatency = latencySnapshot.results[normalizeFriendUrl(item.siteurl)];
            const isTemporarilyUnavailable = item.temporarilyUnavailable === true;
            const latency = getFriendLatencyDisplay(latencySnapshot, item.siteurl);
            const latencyState = isTemporarilyUnavailable ? "down" : latency.state;
            const latencyValue = isTemporarilyUnavailable ? "失联" : latency.value;
            const latencyLabel = isTemporarilyUnavailable
              ? `${item.title}，最近一次定时 GET 探测未连通`
              : latency.label;
            const rssUpdate = rssUpdates.get(normalizeFriendUrl(item.siteurl));
            const rssDate = rssUpdate ? rssDateLabel(rssUpdate.date) : null;
            const rssLabel = rssUpdate
              ? `${rssUpdate.stale ? "RSS 缓存" : "RSS"} 最近文章时间：${rssDate}，${rssUpdate.title}`
              : `${item.title}，RSS 暂无有效更新日期`;
            // 可见性状态：构建期配置优先于远端下发
            const visibilityStatus =
              item.visibilityStatus ||
              (item.temporarilyUnavailable ? "temporarily_unavailable" : "normal");
            const isPolicyViolation = visibilityStatus === "policy_violation";
            const violationStartedAt =
              Number.isSafeInteger(item.violationStartedAt) &&
              (item.violationStartedAt || 0) > 0
                ? item.violationStartedAt || 0
                : 0;
            const unavailableStartedAt =
              Number.isSafeInteger(item.unavailableStartedAt) &&
              (item.unavailableStartedAt || 0) > 0
                ? item.unavailableStartedAt || 0
                : 0;
            const remediationStartedAt = isTemporarilyUnavailable
              ? unavailableStartedAt
              : violationStartedAt;
            const remediationDeadline = remediationStartedAt
              ? remediationStartedAt + remediationSeconds(visibilityStatus)
              : 0;

			return (
              <a
                href={item.siteurl}
                target="_blank"
                rel="noopener noreferrer"
                data-umami-event={isOwnSite ? undefined : "friend-link-click"}
                data-friend-site-url={item.siteurl}
                data-friend-title={item.title}
                data-friend-visibility-status={visibilityStatus}
                data-friend-unavailable={String(isTemporarilyUnavailable)}
                data-friend-unavailable-started-at={unavailableStartedAt || undefined}
                data-friend-violation-started-at={violationStartedAt || undefined}
                data-friend-own-site={String(isOwnSite)}
                data-friend-screenshot={item.screenshot}
                aria-label={
                  isTemporarilyUnavailable
                    ? `${item.title}，短暂失联`
                    : isOwnSite
                      ? `${item.title}，本站`
                      : item.title
                }
                data-tags={item.tags?.join(",")}
                class:list={[
                  "friend-card friend-list-card group rounded-xl relative overflow-visible",
                  isOwnSite && "friend-card--own",
                  isTemporarilyUnavailable && "friend-card--temporarily-unavailable",
                  isPolicyViolation && "friend-card--policy-violation",
                ]}
              >
              {/* 背景装饰 - 仅悬停显示 */}
              <div class="friend-card-surface absolute inset-0 rounded-xl overflow-hidden pointer-events-none">
                {/* 头像取景背景：复用友链头像图作为卡片底纹，左侧渐隐。
                    头像加载失败时由降级逻辑隐藏该层，仅保留底色。 */}
                <img
                  class="friend-card-avatar-backdrop"
                  src={item.imgurl}
                  alt=""
                  aria-hidden="true"
                  loading="lazy"
                  decoding="async"
                  data-friend-avatar-backdrop
                />
                <div class="absolute inset-0 bg-(--primary) opacity-0 transition-opacity duration-300" />
              </div>


              {/* 头像 */}
              <div class="friend-card-avatar relative z-10 w-16 h-16 shrink-0 rounded-xl overflow-hidden bg-zinc-100 dark:bg-zinc-800 border border-black/5 dark:border-white/5 group-hover:scale-105 transition-transform duration-300">
                <img
                  src={item.imgurl}
                  alt={item.title}
                  data-friend-avatar
                  class="w-full h-full object-cover"
                />
              </div>

              {/* 内容 */}
              <div class="friend-card-content relative z-10 grow min-w-0 flex flex-col justify-center gap-0.5">
                <div class="friend-card-heading">
                  <div
                    class="friend-card-title font-bold text-base text-neutral-900 dark:text-neutral-100 transition-colors truncate"
                  >
                    {item.title}
                  </div>
                    <span
                      class:list={[
                        "friend-latency",
                        `friend-latency--${latencyState}`,
                        latency.stale && "friend-latency--stale",
                      ]}
                      data-friend-latency-for={item.siteurl}
                      data-friend-latency-name={item.title}
                      data-friend-latency-state={latencyState}
                      title={latencyLabel}
                      aria-label={latencyLabel}
                    >
                      <span class="friend-latency-dot" aria-hidden="true"></span>
                      <span data-friend-latency-value aria-live="polite">
                        {latencyValue}
                      </span>
                    </span>
                </div>

                <div
                  class="friend-card-description text-sm line-clamp-1"
                  title={item.desc}
                >
                  {item.desc}
                </div>

                {/* 标签 */}
				<div class="flex flex-wrap items-center gap-1 mt-1">
					{item.tags && item.tags.length > 0
                    ? item.tags
                        .slice(0, isOwnSite ? 4 : 3)
                        .map((tag) => (
                          <span class="friend-card-tag text-[0.65rem] font-medium px-1.5 py-0.5 rounded transition-colors duration-300">
                            {tag}
                          </span>
                        ))
                    : null}
				</div>

                {/* RSS 最近更新时间 */}
              </div>
              {/* 卡片底部信息行：左侧「本站主理人 / 最近更新于」，右侧「探测次数」 */}
              <div class="friend-card-footer">
                <div class="friend-card-footer__identity">
                  {isOwnSite && (
                  <span
                  class="friend-site-badge friend-site-owner-badge"
                  aria-hidden="true"
                  >
                  <span>本站主理人</span>
                  </span>
                  )}
                  {rssUpdate ? (
                  <time
                  class="friend-rss-updated"
                  datetime={rssUpdate.date.toISOString()}
                  title={rssLabel}
                  aria-label={rssLabel}
                  >
                  最近更新于 {rssDate}
                  </time>
                  ) : (
                  <span class="friend-rss-updated" title={rssLabel}>RSS 暂无</span>
                  )}
                </div>
                <div class="friend-card-footer__metrics">
                  {!isOwnSite && (
                  <span
