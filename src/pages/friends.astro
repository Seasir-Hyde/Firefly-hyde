  {/* latencyResults：构建时延迟快照注入浏览器端，供动态卡片（远程 API 友链）渲染延迟徽章 */}
  <script is:inline define:vars={{ latencyResults: latencySnapshot.results }}>
    function renderFriendCard(item) {
      var normalizeFriendUrl = function(url) {
        return String(url || '').trim().replace(/^https?:\/\//i, '').replace(/^www\./i, '').replace(/\/+$/, '').toLowerCase();
      };
      var friendEntry = latencyResults[normalizeFriendUrl(item.siteUrl)];
      var friendClicks = friendEntry && typeof friendEntry.clicks === 'number' ? friendEntry.clicks : null;
      var renderFriendLatency = function() {
        var key = normalizeFriendUrl(item.siteUrl);
        var entry = key ? latencyResults[key] : undefined;
        var state = entry && entry.state ? entry.state : 'checking';
        var value = state === 'down' ? '失联' : (entry && entry.milliseconds ? entry.milliseconds + 'ms' : '待探测');
        return '<span class="friend-latency friend-latency--' + state + '" data-friend-latency-for="' + item.siteUrl + '" data-friend-latency-name="' + item.title + '" data-friend-latency-state="' + state + '" title="' + item.title + '，最近一次东八区定时 GET 探测" aria-label="' + item.title + '，最近一次东八区定时 GET 探测">' +
          '<span class="friend-latency-dot" aria-hidden="true"></span>' +
          '<span data-friend-latency-value aria-live="polite">' + value + '</span>' +
        '</span>';
      };
      var tagsHtml = '';
      if (item.tags && item.tags.length > 0) {
        tagsHtml = '<div class="flex flex-wrap gap-1 mt-1">' +
          item.tags.slice(0, 3).map(function(tag) {
            return '<span class="text-[0.65rem] px-1.5 py-0.5 rounded bg-(--btn-regular-bg-hover) text-(--content-meta) transition-colors duration-300">' + tag + '</span>';
          }).join('') +
        '</div>';
      }
      return '<a href="' + item.siteUrl + '" target="_blank" rel="noopener noreferrer" data-umami-event="friend-link-click" data-tags="' + (item.tags ? item.tags.join(',') : '') + '" class="friend-card friend-list-card group flex items-center gap-3 p-2.5 rounded-xl border border-(--line-divider) hover:border-(--primary) hover:bg-(--card-bg) transition-all duration-300 hover:shadow-lg relative overflow-hidden animate-fade-in-up">' +
        '<div class="absolute inset-0 bg-(--primary) opacity-0 group-hover:opacity-5 transition-opacity duration-300 pointer-events-none"></div>' +
        '<div class="relative w-16 h-16 shrink-0 rounded-xl overflow-hidden bg-zinc-100 dark:bg-zinc-800 border border-black/5 dark:border-white/5 group-hover:scale-105 transition-transform duration-300">' +
          '<img src="' + item.imgUrl + '" alt="' + item.title + '" class="w-full h-full object-cover" loading="lazy" />' +
        '</div>' +
        '<div class="friend-card-content relative z-10 grow min-w-0 flex flex-col justify-center gap-0.5">' +
          '<div class="flex items-center justify-between">' +
            '<div class="font-bold text-base text-(--btn-content) group-hover:text-(--primary) transition-colors truncate">' + item.title + '</div>' +
          '</div>' +
          '<div class="friend-card-description text-sm line-clamp-1" title="' + item.desc + '">' + item.desc + '</div>' +
          tagsHtml +
        '</div>' +
        '<span class="friend-click-count" data-friend-clicks-for="' + item.siteUrl + '" title="从本站点击次数" aria-label="' + item.title + '，从本站点击 ' + (friendClicks != null ? friendClicks.toLocaleString('zh-CN') : 0) + ' 次">' +
          '<svg width="1em" height="1em" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 8q-1.65 0-2.825 1.175T8 12q0 1.125.563 2.075t1.562 1.475q.4.2.563.587t-.013.788q-.175.35-.525.525t-.7 0q-1.575-.75-2.512-2.225T6 12q0-2.5 1.75-4.25T12 6q1.775 0 3.263.938T17.475 9.5q.15.35-.012.7t-.513.5q-.4.175-.8 0t-.6-.575q-.525-1-1.475-1.562T12 8m0-4Q8.65 4 6.325 6.325T4 12q0 3.15 2.075 5.4t5.2 2.55q.425.05.737.375t.288.75t-.313.7t-.712.25q-1.95-.125-3.638-.975t-2.95-2.213t-1.975-3.125T2 12q0-2.075.788-3.9t2.137-3.175T8.1 2.788T12 2q3.925 0 6.838 2.675t3.187 6.6q.05.4-.237.688t-.713.312t-.762-.275t-.388-.725q-.375-3-2.612-5.137T12 4m7.55 17.5l-3.3-3.275l-.75 2.275q-.125.35-.475.338t-.475-.363L12.275 12.9q-.1-.275.125-.5t.5-.125l7.575 2.275q.35.125.363.475t-.338.475l-2.275.75l3.3 3.3q.425.425.425.975t-.425.975t-.987.425t-.988-.425"/></svg>' +
          '<span data-friend-clicks-value aria-live="polite">' + (friendClicks != null ? friendClicks.toLocaleString('zh-CN') : '…') + '</span>' +
          '<span class="friend-click-count-unit" aria-hidden="true">次</span>' +
        '</span>' +
        renderFriendLatency() +
      '</a>';
    }

    function loadDynamicFriends() {
      var loading = document.getElementById('friends-loading');
      var grid = document.getElementById('friends-grid');
      if (!grid) return;

      if (loading) loading.classList.remove('hidden');

      fetch('https://seasir.top/api/friends')
        .then(function(res) { return res.json(); })
        .then(function(data) {
          var friends = data.items;
          if (Array.isArray(friends) && friends.length > 0) {
            friends.sort(function(a, b) {
              return (Number(b.weight) || 0) - (Number(a.weight) || 0);
            });
            var html = friends.map(function(item) {
              return renderFriendCard(item);
            }).join('');
            grid.insertAdjacentHTML('beforeend', html);
          }
        })
        .catch(function(err) {
          console.error('加载动态友链失败:', err);
        })
        .finally(function() {
          if (loading) loading.classList.add('hidden');
          // 动态卡片插入后触发 Umami 指标组件重算“xxx 次”徽章（组件已挂载时才存在该全局钩子）
          if (window.__rainztUmamiMetrics) window.__rainztUmamiMetrics();
        });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', loadDynamicFriends);
    } else {
      loadDynamicFriends();
    }

    document.addEventListener('swup:contentReplaced', loadDynamicFriends);
  </script>

  <script is:inline>
    // 友链点击显式上报 site 属性：本部署的 Umami 未持久化 data-umami-event-* 自定义属性，
    // 故用 umami.track 显式携带 site，供构建期快照按归一化域名汇总“从本站点击次数”。
    (function () {
      var trackFriendClick = function (e) {
        var el = e.target && e.target.closest ? e.target.closest("[data-friend-clicks-for]") : null;
        if (!el) return;
        var site = el.getAttribute("data-friend-clicks-for");
        if (site && window.umami && typeof window.umami.track === "function") {
          window.umami.track("friend-link-click", { site: site });
        }
      };
      document.addEventListener("click", trackFriendClick);
    })();
  </script>

