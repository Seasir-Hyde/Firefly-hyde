  <script slot="head" is:inline>
    (() => {
      const avatarFallbackNamespace = "__rainztFriendAvatarFallback";
      if (window[avatarFallbackNamespace]) return;

      document.addEventListener(
        "error",
        (event) => {
          const image = event.target instanceof HTMLImageElement ? event.target : null;
          if (!image?.matches("[data-friend-avatar]")) return;
          if (image.dataset.friendAvatarFallback === "true") return;

          image.dataset.friendAvatarFallback = "true";
          image.removeAttribute("srcset");
          // 512px 头像
          image.src = "/favicon/chaoc-tingyu-avatar-512.png?v=20260907";
          image.alt = "小爱客服头像";
        },
        true,
      );

      window[avatarFallbackNamespace] = true;
    })();

    if (!customElements.get("friend-filter")) {
      class FriendFilter extends HTMLElement {
        selectedTag = "all";
        tagsList = null;
        tagsViewport = null;
        tagsToggle = null;
        resizeObserver = null;

        constructor() {
          super();
        }

        connectedCallback() {
          this.addEventListener("click", this.handleClick);

          if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", this.setupInteractiveElements, {
              once: true,
            });
          } else {
            this.setupInteractiveElements();
          }
        }

        setupInteractiveElements = () => {
          const input = this.querySelector("[data-search]");
          if (input) {
            input.addEventListener("input", this.handleInput);
          }

          this.tagsList = this.querySelector("[data-tags-list]");
          this.tagsViewport = this.querySelector("[data-tags-viewport]");
          this.tagsToggle = this.querySelector("[data-tags-toggle]");
          if (this.tagsList && this.tagsViewport && this.tagsToggle) {
            this.resizeObserver =
              typeof ResizeObserver !== "undefined"
                ? new ResizeObserver(this.updateTagsToggle)
                : null;
            this.resizeObserver?.observe(this.tagsList);
            window.addEventListener("resize", this.updateTagsToggle, { passive: true });
            requestAnimationFrame(this.updateTagsToggle);
          }
        };

        disconnectedCallback() {
          this.removeEventListener("click", this.handleClick);
          document.removeEventListener("DOMContentLoaded", this.setupInteractiveElements);
          this.querySelector("[data-search]")?.removeEventListener("input", this.handleInput);
          this.resizeObserver?.disconnect();
          window.removeEventListener("resize", this.updateTagsToggle);
        }

        handleInput = () => this.applyFilters();

        updateTagsToggle = () => {
          if (!this.tagsList || !this.tagsToggle) return;

          const collapsedHeight = Number.parseFloat(
            getComputedStyle(this.tagsViewport).getPropertyValue(
              "--friend-filter-collapsed-height",
            ),
          );
          const hasOverflow = this.tagsList.scrollHeight > collapsedHeight + 1;
          const isExpanded = this.tagsViewport.classList.contains("is-expanded");

          if (!hasOverflow && isExpanded) {
            this.tagsViewport.classList.remove("is-expanded");
          }

          const expanded = this.tagsViewport.classList.contains("is-expanded");
          this.tagsToggle.classList.toggle("hidden", !hasOverflow && !expanded);
          this.tagsToggle.dataset.expanded = String(expanded);
          this.tagsToggle.setAttribute("aria-expanded", String(expanded));
          const label = this.tagsToggle.querySelector("[data-tags-toggle-label]");
          if (label) label.textContent = expanded ? "收起标签" : "展开标签";
        };

        toggleTags = () => {
          if (!this.tagsViewport || !this.tagsToggle) return;
          this.tagsViewport.classList.toggle("is-expanded");
          this.updateTagsToggle();
        };

        handleClick(e) {
          const target = e.target instanceof Element ? e.target : null;
          const button = target?.closest("button");
          if (!button) return;

          if (button.hasAttribute("data-tags-toggle")) {
            this.toggleTags();
            return;
          }

          if (!button.dataset.tag) return;

          this.selectedTag = button.dataset.tag;
          const filters = this.querySelectorAll("button[data-tag]");

          filters.forEach((f) => {
            f.classList.remove("bg-(--primary)", "text-white");
            f.classList.remove("hover:bg-(--primary)");
            f.classList.add("bg-(--btn-regular-bg)", "text-(--btn-content)");
            f.classList.add("hover:bg-(--btn-regular-bg-hover)");

            if (f === button) {
              f.classList.remove("bg-(--btn-regular-bg)", "text-(--btn-content)");
              f.classList.remove("hover:bg-(--btn-regular-bg-hover)");
              f.classList.add("bg-(--primary)", "text-white");
              f.classList.add("hover:bg-(--primary)");
            }
          });

          this.applyFilters();
        }

        applyFilters() {
          const container = this.closest(".card-base");
          if (!container) return;

          const input = this.querySelector("[data-search]");
          const query = (input?.value || "").toLowerCase().trim();
          const cards = container.querySelectorAll(".friend-list-card");

          let hasVisible = false;

          cards.forEach((card) => {
            const cardEl = card;
            const tags = (cardEl.dataset.tags || "").split(",");
            const name = (cardEl.querySelector(".font-bold")?.textContent || "").toLowerCase();
            const desc = (cardEl.querySelector(".line-clamp-1")?.textContent || "").toLowerCase();

            const tagMatch =
              this.selectedTag === "all" ||
              (this.selectedTag && tags.includes(this.selectedTag));
            const searchMatch =
              !query ||
              name.includes(query) ||
              desc.includes(query) ||
              tags.some((t) => t.toLowerCase().includes(query));

            if (tagMatch && searchMatch) {
              cardEl.style.display = "";
              cardEl.classList.add("animate-fade-in-up");
              hasVisible = true;
            } else {
              cardEl.style.display = "none";
              cardEl.classList.remove("animate-fade-in-up");
            }
          });

          const emptyEl = container.querySelector(".friends-empty");
          if (emptyEl) {
            emptyEl.classList.toggle("hidden", hasVisible);
            emptyEl.classList.toggle("flex", !hasVisible);
          }
        }
      }
      customElements.define("friend-filter", FriendFilter);
    }


  </script>

  <script is:inline>
    // 申请友链表单逻辑
    function initFriendForm() {
      // 获取表单、提交按钮、成功提示、步骤容器
      var form = document.getElementById('friend-link-form');
      var submitBtn = document.getElementById('friend-submit-btn');
      var successEl = document.getElementById('friend-form-success');
      var stepsEl = document.getElementById('friend-apply-steps');

      // 防止重复初始化（swup 切换页面时会再次触发）
      if (!form || !submitBtn || submitBtn.dataset.initialized) return;

      // 友链接口地址由构建期注入到表单的 data 属性，避免多处硬编码
      var apiUrl = form.dataset.friendsApiUrl || '';

      // 防重复提交标记
      var isSubmitting = false;

      submitBtn.dataset.initialized = 'true';
      submitBtn.addEventListener('click', async function() {
        if (isSubmitting) return;
        isSubmitting = true;

        // 读取表单字段并去掉首尾空格
        var title = form.querySelector('input[name="title"]').value.trim();
        var desc = form.querySelector('input[name="desc"]').value.trim();
        var siteUrl = form.querySelector('input[name="siteUrl"]').value.trim();
        var imgUrl = form.querySelector('input[name="imgUrl"]').value.trim();
        var email = form.querySelector('input[name="email"]').value.trim();
        var message = form.querySelector('textarea[name="message"]').value.trim();

        // 校验：任一必填项为空则弹 toast 并返回
        if (!title || !desc || !siteUrl || !imgUrl) {
          isSubmitting = false;
          var toast = document.createElement('div');
          toast.className = 'cc-toast error';
          toast.textContent = '请填写完整信息';
          document.body.appendChild(toast);
          setTimeout(function() { toast.style.opacity = '0'; toast.style.transition = 'opacity 0.3s'; setTimeout(function() { toast.remove(); }, 300); }, 3000);
          return;
        }

        // 进入提交状态：禁用按钮、文案改为"提交中..."
        submitBtn.disabled = true;
        submitBtn.querySelector('span').textContent = '提交中...';

        try {
          // 向后端提交申请，状态默认为 pending
          var res = await fetch(apiUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ title: title, desc: desc, siteUrl: siteUrl, imgUrl: imgUrl, email: email, message: message })
          });

          var data = await res.json();
          if (!res.ok) throw new Error(data.message || '提交失败');
          if (!data.success) throw new Error(data.message || '提交失败');
          // 提交成功：隐藏步骤、显示成功提示
          if (stepsEl) stepsEl.style.display = 'none';
          successEl.classList.remove('hidden');
          successEl.style.display = 'flex';
        } catch (err) {
          // 网络/后端错误：转换文案并弹 toast
          var msg = err.message === 'Failed to fetch' ? '网络连接失败，请检查网络' : (err.message || '提交失败，请稍后重试');
          var toast = document.createElement('div');
          toast.className = 'cc-toast error';
          toast.textContent = msg;
          document.body.appendChild(toast);
          setTimeout(function() { toast.style.opacity = '0'; toast.style.transition = 'opacity 0.3s'; setTimeout(function() { toast.remove(); }, 300); }, 3000);
        } finally {
          // 恢复按钮状态
          isSubmitting = false;
          submitBtn.disabled = false;
          submitBtn.querySelector('span').textContent = '提交申请';
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initFriendForm);
    } else {
      initFriendForm();
    }

    document.addEventListener('swup:contentReplaced', initFriendForm);
  </script>

  {/* 友链“xxx 次”点击计数徽章数据源：组件会聚合 Umami 的 friend-link-click / outbound-link-click
      事件并填充页面上所有 [data-friend-clicks-for] 徽章；仅配置齐 shareId + scriptUrl 时挂载 */}
  {umamiAnalytics?.shareId && umamiShareApiBase && (
    <MicrosoftClarity
      shareId={umamiAnalytics.shareId}
      shareApiBase={umamiShareApiBase}
    />
  )}

  {/* latencyResults：构建时延迟快照注入浏览器端，供动态卡片（远程 API 友链）渲染延迟徽章
      remoteFriendUpdates：构建期抓取的远程友链 RSS 最新文章时间，供动态卡片渲染「最后更新」 */}
  <script is:inline define:vars={{ latencyResults: latencySnapshot.results, latencyProbeLocation: latencySnapshot.probeLocation, remoteFriendUpdates, remoteFriendsApiUrl: REMOTE_FRIENDS_API_URL }}>
    // 友链键归一化：主机名口径，与 src/utils/friend-url.ts 保持一致
    // （改动时需同步该文件，否则查表会落空）
    var normalizeFriendUrl = function(url) {
      var raw = String(url || '').trim();
      if (!raw) return '';
      try {
        var parsed = new URL(raw.indexOf('://') > -1 ? raw : 'https://' + raw);
        var host = parsed.hostname.toLowerCase().replace(/^www\./, '');
        return parsed.port ? host + ':' + parsed.port : host;
      } catch (e) {
        return raw.replace(/^https?:\/\//i, '').replace(/^www\./i, '').replace(/\/.*$/, '').toLowerCase();
      }
    };
    var escapeHtml = function(value) {
      return String(value == null ? '' : value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    };
    var formatUpdateDate = function(value) {
      if (value === null || value === undefined || value === '') return null;
      var date;
      if (value instanceof Date) {
        date = value;
      } else if (typeof value === 'number') {
        // 0 与负数视为无效时间，避免渲染成 1970 年
        if (!isFinite(value) || value <= 0) return null;
        // 小于 1e11 的值按 Unix 秒处理（1e11 毫秒约等于 1973 年）
        date = new Date(value < 1e11 ? value * 1000 : value);
      } else {
        date = new Date(value);
      }
      if (isNaN(date.getTime())) return null;
      return {
        iso: date.toISOString(),
        label: date.toLocaleDateString('sv-SE', { timeZone: 'Asia/Shanghai' })
      };
    };
    // 远程友链的「最后更新」：优先用构建期抓到的 RSS 最新文章时间，
    // 其次回落到接口下发的友链记录更新时间，两者都缺失时显示「RSS 暂无」。
    var renderFriendUpdated = function(item) {
      var key = normalizeFriendUrl(item.siteUrl);
      var rssEntry = remoteFriendUpdates ? remoteFriendUpdates[key] : null;
      if (rssEntry && rssEntry.date) {
        var rssDate = formatUpdateDate(rssEntry.date);
        if (rssDate) {
          var rssLabel = (rssEntry.stale ? 'RSS 缓存' : 'RSS') + ' 最近文章时间：' + rssDate.label + '，' + (rssEntry.title || '');
          return '<time class="friend-rss-updated" datetime="' + rssDate.iso + '" title="' + escapeHtml(rssLabel) + '" aria-label="' + escapeHtml(rssLabel) + '">最近更新于 ' + rssDate.label + '</time>';
        }
      }
      var recordDate = formatUpdateDate(item.updatedAt) || formatUpdateDate(item.createdAt);
      if (recordDate) {
        var recordLabel = item.title + '，友链记录最后更新：' + recordDate.label;
        return '<time class="friend-rss-updated" datetime="' + recordDate.iso + '" title="' + escapeHtml(recordLabel) + '" aria-label="' + escapeHtml(recordLabel) + '">最近更新于 ' + recordDate.label + '</time>';
      }
      return '<span class="friend-rss-updated" title="' + escapeHtml(item.title) + '，RSS 暂无有效更新日期">RSS 暂无</span>';
    };
    function renderFriendCard(item) {
      var friendEntry = latencyResults[normalizeFriendUrl(item.siteUrl)];
      var friendClicks = friendEntry && typeof friendEntry.clicks === 'number' ? friendEntry.clicks : null;
      var renderFriendLatency = function() {
        var key = normalizeFriendUrl(item.siteUrl);
        var entry = key ? latencyResults[key] : undefined;
        if (!entry) {
          // 没有探测记录：说明该站点未纳入探测队列，而不是「正在探测」
          var pendingLabel = item.title + '，该站点未纳入延迟探测队列，暂无 HTTP 响应时间数据';
          return '<span class="friend-latency friend-latency--checking" data-friend-latency-for="' + item.siteUrl + '" data-friend-latency-name="' + item.title + '" data-friend-latency-state="checking" title="' + escapeHtml(pendingLabel) + '" aria-label="' + escapeHtml(pendingLabel) + '">' +
            '<span class="friend-latency-dot" aria-hidden="true"></span>' +
            '<span data-friend-latency-value aria-live="polite">未探测</span>' +
          '</span>';
        }
        var state = entry.state || 'checking';
        var stale = false;
        var checkedLabel = '';
        if (entry.checkedAt) {
          var checkedDate = new Date(entry.checkedAt);
          if (!isNaN(checkedDate.getTime())) {
            checkedLabel = checkedDate.toLocaleString('zh-CN', { timeZone: 'Asia/Shanghai', hour12: false });
            stale = Date.now() - checkedDate.getTime() > 48 * 3600 * 1000;
          }
        }
        var value = state === 'down'
          ? '失联'
          : (entry.milliseconds ? entry.milliseconds + 'ms' : '未探测');
        var source = (entry.probeLocation || latencyProbeLocation || '未知探测节点') + (checkedLabel ? '，探测于 ' + checkedLabel + '（北京时间）' : '');
        var detail = state === 'down'
          ? '最近一次 HTTP GET 探测' + value
          : (entry.milliseconds ? 'HTTP GET 首次响应时间 ' + entry.milliseconds + ' 毫秒' : '暂无耗时数据');
        var label = item.title + '，' + detail + '；' + source + (stale ? '，探测数据已过期' : '') + '。仅表示该探测节点的结果。';
        return '<span class="friend-latency friend-latency--' + state + (stale ? ' friend-latency--stale' : '') + '" data-friend-latency-for="' + item.siteUrl + '" data-friend-latency-name="' + item.title + '" data-friend-latency-state="' + state + '" title="' + escapeHtml(label) + '" aria-label="' + escapeHtml(label) + '">' +
          '<span class="friend-latency-dot" aria-hidden="true"></span>' +
          '<span data-friend-latency-value aria-live="polite">' + value + '</span>' +
        '</span>';
      };
      var tagsHtml = '';
      if (item.tags && item.tags.length > 0) {
        tagsHtml = '<div class="flex flex-wrap gap-1 mt-1">' +
          item.tags.slice(0, 3).map(function(tag) {
            return '<span class="text-[0.65rem] px-1.5 py-0.5 rounded bg-(--btn-regular-bg-hover) text-(--content-meta) transition-colors duration-300">' + tag + '</span>';
          }).join('') +
        '</div>';
      }
      return '<a href="' + item.siteUrl + '" target="_blank" rel="noopener noreferrer" data-umami-event="friend-link-click" data-tags="' + (item.tags ? item.tags.join(',') : '') + '" data-friend-site-url="' + item.siteUrl + '" data-friend-title="' + escapeHtml(item.title) + '" data-friend-dynamic="true" class="friend-card friend-list-card group rounded-xl border border-(--line-divider) transition-all duration-300 relative overflow-hidden animate-fade-in-up">' +
        '<div class="friend-card-surface absolute inset-0 rounded-xl overflow-hidden pointer-events-none">' +
          '<img class="friend-card-avatar-backdrop" src="' + item.imgUrl + '" alt="" aria-hidden="true" loading="lazy" decoding="async" data-friend-avatar-backdrop />' +
          '<div class="absolute inset-0 bg-(--primary) opacity-0 transition-opacity duration-300"></div>' +
        '</div>' +
        '<div class="friend-card-avatar relative z-10 w-16 h-16 shrink-0 rounded-xl overflow-hidden bg-zinc-100 dark:bg-zinc-800 border border-black/5 dark:border-white/5 group-hover:scale-105 transition-transform duration-300">' +
          '<img src="' + item.imgUrl + '" alt="' + item.title + '" class="w-full h-full object-cover" loading="lazy" data-friend-avatar />' +
        '</div>' +
        '<div class="friend-card-content relative z-10 grow min-w-0 flex flex-col justify-center gap-0.5">' +
          '<div class="friend-card-heading">' +
            '<div class="friend-card-title font-bold text-base text-(--btn-content) group-hover:text-(--primary) transition-colors truncate">' + item.title + '</div>' +
            renderFriendLatency() +
          '</div>' +
          '<div class="friend-card-description text-sm line-clamp-1" title="' + item.desc + '">' + item.desc + '</div>' +
          tagsHtml +
        '</div>' +
        '<div class="friend-card-footer">' +
          '<div class="friend-card-footer__identity">' +
            renderFriendUpdated(item) +
          '</div>' +
          '<div class="friend-card-footer__metrics">' +
            '<span class="friend-click-count friend-click-count--inline" data-friend-clicks-for="' + item.siteUrl + '" title="从本站点击次数" aria-label="' + item.title + '，从本站点击次数">' +
              '<span data-friend-clicks-value>…</span>' +
              '<span class="friend-click-count-unit">次</span>' +
            '</span>' +
          '</div>' +
        '</div>' +
      '</a>';
    }

    function loadDynamicFriends() {
      var loading = document.getElementById('friends-loading');
      var grid = document.getElementById('friends-grid');
      if (!grid) return;

      if (loading) loading.classList.remove('hidden');

      fetch(remoteFriendsApiUrl)
        .then(function(res) { return res.json(); })
        .then(function(data) {
          var friends = data.items || data.friends;
          if (Array.isArray(friends) && friends.length > 0) {
            // 同域名去重：静态卡片（本地配置）里已有的站点不再重复插入动态卡片，
            // 避免同一站点因为两个域名出现两张卡片（如站点迁移后新旧域名并存）
            var existing = {};
            grid.querySelectorAll('.friend-card[data-friend-site-url]:not([data-friend-dynamic])').forEach(function(card) {
              var key = normalizeFriendUrl(card.getAttribute('data-friend-site-url'));
              if (key) existing[key] = true;
            });
            var filtered = friends.filter(function(item) {
              return !existing[normalizeFriendUrl(item.siteUrl)];
            });
            filtered.sort(function(a, b) {
              return (Number(b.weight) || 0) - (Number(a.weight) || 0);
            });
            var html = filtered.map(function(item) {
              return renderFriendCard(item);
            }).join('');
            grid.insertAdjacentHTML('beforeend', html);
          }
        })
        .catch(function(err) {
          console.error('加载动态友链失败:', err);
        })
        .finally(function() {
          if (loading) loading.classList.add('hidden');
          // 动态卡片插入后触发 Umami 指标组件重算“xxx 次”徽章（组件已挂载时才存在该全局钩子）
          if (window.__rainztUmamiMetrics) window.__rainztUmamiMetrics();
        });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', loadDynamicFriends);
    } else {
      loadDynamicFriends();
    }

    document.addEventListener('swup:contentReplaced', loadDynamicFriends);
  </script>

  <script is:inline>
    // 友链点击显式上报 site 属性：本部署的 Umami 未持久化 data-umami-event-* 自定义属性，
