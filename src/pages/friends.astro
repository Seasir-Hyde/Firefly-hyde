  <script is:inline>
    // 顶部按钮逻辑：随机访问友链 + 滚动到申请表单
    function initFriendsHeaderButtons() {
      var randomBtn = document.getElementById('random-friend-btn');
      var applyBtn = document.getElementById('apply-friend-btn');

      function showToast(msg) {
        var toast = document.createElement('div');
        toast.className = 'cc-toast error';
        toast.textContent = msg;
        document.body.appendChild(toast);
        setTimeout(function() { toast.style.opacity = '0'; toast.style.transition = 'opacity 0.3s'; setTimeout(function() { toast.remove(); }, 300); }, 3000);
      }

      // 随机访问：从当前可见的友链卡片中随机选一个，在新标签页打开
      if (randomBtn && !randomBtn.dataset.initialized) {
        randomBtn.dataset.initialized = 'true';
        randomBtn.addEventListener('click', function() {
          var cards = document.querySelectorAll('#friends-grid .friend-card');
          var validCards = [];
          cards.forEach(function(card) {
            if (card.href && card.style.display !== 'none') {
              validCards.push(card);
            }
          });

          if (validCards.length === 0) {
            showToast('暂无可访问的友链');
            return;
          }

          var randomCard = validCards[Math.floor(Math.random() * validCards.length)];
          window.open(randomCard.href, '_blank', 'noopener,noreferrer');
        });
      }

      // 申请友链：平滑滚动到申请表单，并短暂高亮提示
      if (applyBtn && !applyBtn.dataset.initialized) {
        applyBtn.dataset.initialized = 'true';
        applyBtn.addEventListener('click', function() {
          var target = document.getElementById('friend-apply-steps') || document.getElementById('friend-link-form');
          if (!target) return;
          target.scrollIntoView({ behavior: 'smooth', block: 'center' });
          target.classList.add('friend-apply-highlight');
          setTimeout(function() { target.classList.remove('friend-apply-highlight'); }, 1800);
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initFriendsHeaderButtons);
    } else {
      initFriendsHeaderButtons();
    }
    document.addEventListener('swup:contentReplaced', initFriendsHeaderButtons);
  </script>

