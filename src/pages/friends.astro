      max-height: none;
      overflow: visible;
      white-space: pre-line;
    }

    .friend-filter-tags-shell {
      display: flex;
      flex-direction: row;
      align-items: flex-start;
      gap: 0.5rem;
    }

    .friend-filter-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      width: 100%;
      min-height: 0;
    }

    .friend-filter-tags-viewport {
      --friend-filter-collapsed-height: 2.25rem;
      display: grid;
      grid-template-rows: minmax(var(--friend-filter-collapsed-height), 0fr);
      min-width: 0;
      flex: 1;
      overflow: hidden;
      transition: grid-template-rows 260ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .friend-filter-tags-viewport.is-expanded {
      grid-template-rows: minmax(var(--friend-filter-collapsed-height), 1fr);
    }

    .friend-filter-tags-toggle {
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
      flex-shrink: 0;
      min-height: 2rem;
      padding: 0.35rem 0.7rem;
      border: 1px solid color-mix(in srgb, var(--primary) 22%, var(--line-divider));
      border-radius: 0.7rem;
      background: color-mix(in srgb, var(--primary) 8%, var(--card-bg));
      color: var(--primary);
      font-size: 0.75rem;
      font-weight: 650;
      line-height: 1;
      transition: background-color 180ms ease, border-color 180ms ease, transform 180ms ease;
    }

    .friend-filter-tags-toggle:hover {
      border-color: color-mix(in srgb, var(--primary) 42%, var(--line-divider));
      background: color-mix(in srgb, var(--primary) 14%, var(--card-bg));
    }

    .friend-filter-tags-toggle:focus-visible {
      outline: 2px solid color-mix(in srgb, var(--primary) 68%, transparent);
      outline-offset: 2px;
    }

    .friend-filter-tags-toggle[data-expanded="true"] svg {
      transform: rotate(180deg);
    }

    .friend-filter-tags-toggle.hidden {
      display: none;
    }

    @media (max-width: 1023px) {
      .friends-ai-recommendation-mobile {
        display: block;
        margin-top: 1rem;
      }

      .friends-ai-recommendation--inline {
        display: block !important;
        width: 100%;
        margin-top: 0;
        background: color-mix(in srgb, var(--primary) 12%, var(--card-bg));
        border-color: color-mix(in srgb, var(--primary) 26%, var(--line-divider));
        box-shadow: 0 0.75rem 1.5rem color-mix(in srgb, var(--primary) 10%, transparent);
        color: #243447;
        text-shadow: none;
        -webkit-backdrop-filter: none;
        backdrop-filter: none;
      }

      .friends-ai-recommendation--inline .banner-post-ai-summary__label {
        color: #20344d;
      }

      .friends-ai-recommendation--inline .banner-post-ai-summary__provider {
        color: rgba(44, 68, 94, 0.68);
      }

      .friends-ai-recommendation--inline .banner-post-ai-summary__label svg {
        color: var(--primary);
        filter: drop-shadow(0 0 0.45rem color-mix(in srgb, var(--primary) 45%, transparent));
      }

      .friends-ai-recommendation--inline p {
        color: rgba(36, 52, 71, 0.88);
      }

      :root.dark .friends-ai-recommendation--inline {
        border-color: color-mix(in srgb, var(--primary) 34%, var(--line-divider));
        background: color-mix(in srgb, var(--card-bg) 82%, var(--primary) 18%);
        box-shadow: 0 0.75rem 1.5rem rgb(0 0 0 / 0.24);
        color: #edf5ff;
      }

      :root.dark .friends-ai-recommendation--inline .banner-post-ai-summary__label {
        color: #f5f8ff;
      }

      :root.dark .friends-ai-recommendation--inline .banner-post-ai-summary__provider {
        color: rgba(216, 229, 243, 0.72);
      }

      :root.dark .friends-ai-recommendation--inline p {
        color: rgba(235, 243, 251, 0.9);
      }
    }

    /* 友链头像统一圆形裁切。
       覆盖 Tailwind 的 rounded-xl（.rounded-xl 的 border-radius: 0.75rem），
       用 50% 保证 img 被裁成正圆，边缘无方形残留。 */
    .friend-card-avatar {
      isolation: isolate;
      border-radius: 50%;
      border-color: color-mix(in srgb, var(--primary) 18%, var(--line-divider));
      box-shadow:
        0 0.18rem 0.55rem color-mix(in srgb, var(--primary) 9%, transparent),
        0 0 0.72rem color-mix(in srgb, var(--primary) 17%, transparent);
      transition:
        transform 300ms cubic-bezier(0.2, 0.8, 0.2, 1),
        border-color 240ms ease,
        box-shadow 300ms ease;
    }

    /* 头像取景背景：把友链头像图铺在卡片左侧作为底纹，
       靠 mask 渐变向右淡出，低透明度叠加在卡片底色之上。
       高度取卡片满高，宽度限制在 70% 以内，避免压住右侧正文。 */
    .friend-card-avatar-backdrop {
      position: absolute;
      inset: 0 auto 0 0;
      width: 12rem;
      max-width: 70%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      opacity: 0.13;
      -webkit-mask-image: linear-gradient(to right, black 20%, transparent 100%);
      mask-image: linear-gradient(to right, black 20%, transparent 100%);
      pointer-events: none;
    }

    /* 暗色模式下底色更深，适当提高背景可见度。 */
    :root.dark .friend-card-avatar-backdrop {
      opacity: 0.17;
    }

    /* 头像图加载失败（外链 404 / 防盗链 / 网络不通）时隐藏底纹层，
       卡片回退为纯底色，不显示破图图标。 */
    .friend-card-avatar-backdrop[data-friend-backdrop-failed] {
      display: none;
    }

    /* 头像本体加载失败时移出图片，保留头像容器的占位底色，
       避免出现破图图标破坏圆形裁切。 */
    .friend-card-avatar img[data-friend-avatar-failed] {
      display: none;
    }

    .friend-card:hover .friend-card-avatar,
    .friend-card:focus-visible .friend-card-avatar {
      border-color: color-mix(in srgb, var(--primary) 34%, var(--line-divider));
      box-shadow:
        0 0.28rem 0.7rem color-mix(in srgb, var(--primary) 13%, transparent),
        0 0 0.95rem color-mix(in srgb, var(--primary) 24%, transparent);
    }

    /* 兜底：确保头像内的图片本身也是圆形，避免个别浏览器下
       border-radius 不裁切 overflow 子元素而出现方形边缘。 */
    .friend-card-avatar img {
      border-radius: 50%;
    }

    .friend-card-description {
      color: #607487;
      letter-spacing: 0.005em;
    }

    .friend-card--own .friend-card-avatar {
      border-color: color-mix(in srgb, #39bde8 35%, var(--line-divider));
      box-shadow:
        0 0.18rem 0.55rem rgba(42, 157, 204, 0.13),
        0 0 0.78rem rgba(42, 190, 232, 0.24);
    }

    .friend-card--own .friend-card-description {
      color: #3f7185;
    }

    :global(.dark) .friend-card-avatar {
      border-color: color-mix(in srgb, var(--primary) 24%, var(--line-divider));
      box-shadow:
        0 0.18rem 0.62rem color-mix(in srgb, var(--primary) 12%, transparent),
        0 0 0.82rem color-mix(in srgb, var(--primary) 22%, transparent);
    }

    :root.dark .friend-card-description {
      color: #c9d9e6;
    }

    :global(.dark) .friend-card--own .friend-card-avatar {
      border-color: rgba(78, 196, 235, 0.48);
      box-shadow:
        0 0.18rem 0.62rem rgba(26, 123, 164, 0.2),
        0 0 0.88rem rgba(63, 193, 231, 0.35);
    }

    :root.dark .friend-card--own .friend-card-description {
      color: #b4e0f0;
    }

    .friend-site-preview {
      position: absolute;
      bottom: calc(100% + 0.75rem);
      left: 50%;
      z-index: 90;
      width: 100%;
      aspect-ratio: 16 / 9;
      margin: 0;
      pointer-events: none;
      overflow: hidden;
      border: 1px solid color-mix(in srgb, var(--primary) 22%, rgba(255, 255, 255, 0.88));
      border-radius: 0.875rem;
      background: var(--card-bg);
      box-shadow: 0 0.875rem 2rem rgba(35, 65, 92, 0.22);
      opacity: 0;
      visibility: hidden;
      transform: translateX(-50%) translateY(0.375rem) scale(0.96);
      transform-origin: center bottom;
      transition:
        opacity 220ms ease,
        transform 220ms ease,
        visibility 220ms ease;
      will-change: transform, opacity;
    }

    .friend-card:hover > .friend-site-preview,
    .friend-card:focus-visible > .friend-site-preview {
      opacity: 1;
      visibility: visible;
      transform: translateX(-50%) translateY(0) scale(1);
    }

    .friend-site-preview > img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: top center;
    }

    @media (hover: none), (max-width: 767px) {
      .friend-site-preview {
        display: none !important;
      }
    }

    :global(.dark) .friend-site-preview {
      border-color: color-mix(in srgb, var(--primary) 18%, rgba(255, 255, 255, 0.14));
      background: var(--card-bg);
      box-shadow: 0 1.15rem 3rem rgba(0, 0, 0, 0.42);
    }

    /* 从本站点击次数：位于卡片右下角，与「本站主理人 / 最近更新于」同一水平线。
       采用无边框小字样式，与参考布局一致。 */
    .friend-click-count {
      --friend-click-count-ink: #6f8296;
      position: relative;
      z-index: 24;
      display: inline-flex;
      align-items: center;
      gap: 0.2rem;
      min-width: 0;
      height: auto;
      min-height: 20px;
      padding: 0;
      border: 0;
      border-radius: 0;
      background: none;
      box-shadow: none;
      color: var(--friend-click-count-ink);
      font-size: 0.64rem;
      font-weight: 600;
      font-variant-numeric: tabular-nums;
      line-height: 1;
      white-space: nowrap;
      pointer-events: none;
      transform: none;
      transition:
        border-color 220ms ease,
        color 220ms ease,
        box-shadow 220ms ease,
        transform 220ms ease;
    }

    :root.dark .friend-click-count {
      --friend-click-count-ink: #d3e1ec;
    }

    .friend-click-count :global(svg) {
      width: 0.8rem;
      height: 0.8rem;
      flex: none;
      color: var(--primary);
    }

    .friend-click-count-unit {
      color: color-mix(in srgb, currentColor 72%, transparent);
      font-weight: 700;
    }

    /* 本站总访问次数：位于卡片右下角，与「本站主理人 / 最近更新于」同一水平线，
       采用无边框小字样式，与点击次数保持一致。 */
    .friend-site-visit-count {
      display: inline-flex;
      align-items: center;
      flex: none;
      gap: 0.18rem;
      min-width: 0;
      height: auto;
      min-height: 20px;
      padding: 0;
      border: 0;
      border-radius: 0;
      background: none;
      box-shadow: none;
      color: color-mix(in srgb, var(--content-meta) 88%, var(--text-color));
      font-size: 0.64rem;
      font-weight: 600;
      line-height: 1;
      white-space: nowrap;
      pointer-events: none;
    }

    .friend-site-visit-count :global(svg) {
      width: 0.82rem;
      height: 0.82rem;
      flex: none;
      color: var(--primary);
    }

    .friend-card--own .friend-site-visit-count {
      color: #178bc0;
    }

    .friend-card--own .friend-site-visit-count :global(svg) {
      color: #2a9bca;
    }

    :global(.dark) .friend-card--own .friend-site-visit-count {
      color: #a7def6;
    }

    :global(.dark) .friend-card--own .friend-site-visit-count :global(svg) {
      color: #87d8f5;
    }

    .friend-rss-updated {
      display: inline-flex;
      align-items: center;
      font-size: 0.64rem;
      font-weight: 500;
      line-height: 1.2;
      color: color-mix(in srgb, var(--content-meta, #6f8296) 78%, transparent);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 100%;
    }

    :root.dark .friend-click-count {
      border-color: rgba(255, 255, 255, 0.3);
      background-color: transparent;
      --friend-click-count-ink: #d3e1ec;
    }

    /* 探测延迟：位于卡片标题行右端，与站点名称并列展示，
       不再与右下角的访问次数等信息挤在同一角落。 */
    /* 探测延迟：位于卡片右下角指标列的上方，
       与下方探测次数右边缘对齐，构成垂直排列的指标列。 */
    .friend-latency {
      position: relative;
      z-index: 24;
      display: inline-flex;
      align-items: center;
      justify-content: flex-end;
      flex: none;
      gap: 0.2rem;
      min-width: 0;
      height: auto;
      min-height: 20px;
      padding: 0;
      border: 0;
      border-radius: 0;
      background: none;
      box-shadow: none;
      color: var(--friend-latency-color, var(--content-meta));
      font-size: 0.64rem;
      font-weight: 600;
      font-variant-numeric: tabular-nums;
      line-height: 1;
      white-space: nowrap;
      pointer-events: none;
      transform: none;
      transition: color 220ms ease;
    }

    .friend-latency-dot {
      width: 0.42rem;
      height: 0.42rem;
      flex: none;
      border-radius: 999px;
      background: currentColor;
      box-shadow: 0 0 0.35rem color-mix(in srgb, currentColor 42%, transparent);
    }

    /* 未纳入探测队列：静态灰点，不做脉冲动画——
       页面端并不存在运行中的探测任务，脉冲会误导访客以为正在探测 */
    .friend-latency--checking {
      color: #8fa3b5;
    }

    .friend-latency--stale {
      opacity: 0.72;
    }

    .friend-latency--fast {
      color: #69b78e;
    }

    .friend-latency--normal {
      color: #78a8dd;
    }

    .friend-latency--slow {
      color: #d4a15e;
    }

    .friend-latency--down {
      color: #dc879b;
    }

    :global(.dark) .friend-latency {
      color: color-mix(in srgb, var(--content-meta) 92%, white);
    }

    :global(.dark) .friend-latency--checking {
      color: #a7d7f8;
    }

    :global(.dark) .friend-latency--fast {
      color: #a6e8c6;
    }

    :global(.dark) .friend-latency--normal {
      color: #b1d8ff;
    }

    :global(.dark) .friend-latency--slow {
      color: #ffdaa0;
    }

    :global(.dark) .friend-latency--down {
      color: #ffb9c7;
    }

    .friend-card {
      --friend-card-border-color: rgba(255, 246, 219, 0.28);
      --friend-card-hover-border-color: color-mix(in srgb, var(--primary) 42%, var(--line-divider));
      isolation: isolate;
      /* 三列两行网格，对齐参考布局：
         第 1 列头像，第 2 列起为内容区，第 2 行横跨整卡放底部信息行。 */
      display: grid;
      grid-template-columns: 48px minmax(0, 1fr);
      grid-template-rows: auto auto;
      align-items: center;
      gap: 4px 10px;
      padding: 12px 14px;
      border: 1px solid var(--friend-card-border-color);
      border-radius: 10px 7px 12px 8px;
      background-color: color-mix(in srgb, var(--card-bg) 26%, transparent);
      box-shadow:
        0 0.48rem 1.05rem rgba(68, 128, 164, 0.09),
        0 0.12rem 0.32rem rgba(67, 108, 139, 0.06),
        inset 0 1px 0 rgba(255, 255, 255, 0.68);
      -webkit-backdrop-filter: blur(4px) saturate(1.04);
      backdrop-filter: blur(4px) saturate(1.04);
      transition:
        transform 220ms ease,
        border-color 220ms ease,
        background-color 220ms ease,
        box-shadow 220ms ease;
    }

    /* 头像：第 1 列第 1 行，相对右侧标题 / 描述 / 标签整体垂直居中 */
    .friend-card > .friend-card-avatar {
      grid-column: 1;
      grid-row: 1;
      width: 48px;
      height: 48px;
      align-self: center;
    }

    /* 内容区：第 2 列起第 1 行 */
    .friend-card > .friend-card-content {
      grid-column: 2 / -1;
      grid-row: 1;
      min-width: 0;
    }

    /* 底部信息行：横跨整卡第 2 行，
       左侧「本站主理人 / 最近更新于」，右侧「探测次数」。 */
    .friend-card > .friend-card-footer {
      grid-column: 1 / -1;
      grid-row: 2;
      position: relative;
      z-index: 10;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 6px 8px;
      min-width: 0;
    }

    /* 标题行：站点名在左，探测延迟在右（卡片右上角） */
    .friend-card-heading {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
      min-width: 0;
    }

    .friend-card-footer__identity,
    .friend-card-footer__metrics {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;
      min-width: 0;
    }

    /* 探测次数位于卡片右下角；与右上角的探测延迟同处内容区右边缘，
       因此两者的右边界落在同一条垂直线上。 */
    .friend-card-footer__metrics {
      margin-left: auto;
    }

    .friend-card--temporarily-unavailable {
      isolation: isolate;
      border-color: var(--friend-card-border-color);
      background:
        radial-gradient(125% 150% at 0% 0%, rgba(255, 255, 255, 0.38), transparent 52%),
        linear-gradient(135deg, rgba(247, 253, 255, 0.24), rgba(206, 229, 239, 0.16)),
        var(--card-bg);
      box-shadow:
        0 0.35rem 1rem rgba(68, 101, 122, 0.12),
        inset 0 1px 0 rgba(255, 255, 255, 0.82),
        inset 0 -1px 0 rgba(101, 139, 157, 0.12);
    }

    .friend-card--temporarily-unavailable .friend-card-avatar,
    .friend-card--temporarily-unavailable .friend-card-title,
    .friend-card--temporarily-unavailable .friend-card-description,
    .friend-card--temporarily-unavailable .friend-card-tag {
      filter: blur(0.06rem) saturate(0.74);
      opacity: 0.84;
      transition: filter 320ms ease, opacity 320ms ease;
    }

    .friend-card--temporarily-unavailable .friend-card-avatar {
      transform: scale(1.025);
    }

    .friend-card-status-overlay {
      position: absolute;
      inset: 0;
      z-index: 20;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0.65rem;
      border-radius: inherit;
      pointer-events: none;
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.18);
      background:
        radial-gradient(110% 120% at 8% -20%, rgba(255, 255, 255, 0.42), transparent 50%),
        linear-gradient(112deg, rgba(255, 255, 255, 0.1), rgba(223, 238, 245, 0.18) 48%, rgba(248, 252, 254, 0.08)),
        rgba(225, 238, 244, 0.04);
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.76),
        inset 0 -1px 0 rgba(112, 145, 163, 0.14);
      -webkit-backdrop-filter: blur(0.28rem) saturate(1.04) brightness(1.03);
      backdrop-filter: blur(0.28rem) saturate(1.04) brightness(1.03);
    }

    .friend-card-status-overlay::before {
      position: absolute;
      inset: -45% -18%;
      z-index: 0;
      content: "";
      pointer-events: none;
      background: linear-gradient(
        116deg,
        transparent 31%,
        rgba(255, 255, 255, 0.52) 46%,
        transparent 63%
      );
      transform: translateX(-22%);
      opacity: 0.18;
      will-change: transform, opacity;
      animation: friend-liquid-shimmer 6.5s ease-in-out infinite;
    }

    .friend-card-status-overlay::after {
      position: absolute;
      inset: 0.12rem;
      z-index: 0;
      content: "";
      pointer-events: none;
      border: 1px solid rgba(255, 255, 255, 0.22);
      border-radius: 0.63rem;
      box-shadow: inset 0 0.15rem 0.8rem rgba(255, 255, 255, 0.12);
    }

    .friend-card-status-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.58rem;
      min-height: 2.9rem;
      padding: 0.62rem 1.25rem;
      border: 1px solid rgba(255, 255, 255, 0.6);
      border-radius: 999px;
      color: #567184;
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.58), rgba(235, 247, 251, 0.3));
      box-shadow:
        0 0.4rem 1.1rem rgba(70, 105, 123, 0.14),
        inset 0 1px 0 rgba(255, 255, 255, 0.88),
        inset 0 -1px 0 rgba(98, 137, 154, 0.12);
      font-size: 1rem;
      font-weight: 800;
      letter-spacing: 0.02em;
      white-space: nowrap;
      position: relative;
      z-index: 1;
      -webkit-backdrop-filter: blur(0.42rem) saturate(1.12);
      backdrop-filter: blur(0.42rem) saturate(1.12);
    }

    .friend-card-remediation-overlay {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
    }

    .friend-card-policy-label {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      min-height: 2.6rem;
      padding: 0.55rem 1.15rem;
      border: 1px solid rgba(255, 236, 236, 0.62);
      border-radius: 999px;
      color: #a33a3a;
      background: linear-gradient(135deg, rgba(255, 240, 240, 0.72), rgba(252, 226, 226, 0.42));
      box-shadow:
        0 0.4rem 1.1rem rgba(150, 60, 60, 0.16),
        inset 0 1px 0 rgba(255, 255, 255, 0.88);
      font-size: 0.95rem;
      font-weight: 800;
      letter-spacing: 0.02em;
