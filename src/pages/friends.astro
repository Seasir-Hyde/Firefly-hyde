            const curveAngle = progress * Math.PI * 2 + particle.curvePhase;
            const rawX =
              radius +
              progress * Math.max(1, this.width - radius * 2) +
              drift * particle.xDrift;
            const x = Math.max(radius, Math.min(this.width - radius, rawX));
