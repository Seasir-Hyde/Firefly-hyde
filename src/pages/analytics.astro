									<button type="button" data-range="30" aria-pressed="true">30 天</button>
									<button type="button" data-range="90" aria-pressed="false">90 天</button>
								</div>
							</div>
							<button type="button" class="analytics-refresh" data-analytics-refresh aria-label="刷新统计数据">
								<Icon is:inline name="material-symbols:refresh-rounded" aria-hidden="true" />
							</button>
						</div>
					</header>

					<div class="analytics-chart-wrap">
						<div class="analytics-chart-labels" aria-hidden="true">
							<span data-chart-y-label="max">—</span>
							<span data-chart-y-label="mid">—</span>
							<span data-chart-y-label="min">0</span>
						</div>
						<svg
							class="analytics-chart"
							data-traffic-chart
							viewBox="0 0 960 300"
							role="img"
							aria-label="最近 30 天的浏览量与访客趋势"
						>
							<defs>
								<linearGradient id="analytics-area-gradient" x1="0" x2="0" y1="0" y2="1">
									<stop offset="0%" stop-color="var(--analytics-blue)" stop-opacity="0.24" />
									<stop offset="100%" stop-color="var(--analytics-blue)" stop-opacity="0" />
								</linearGradient>
							</defs>
							<g class="analytics-chart__grid" aria-hidden="true">
								<line x1="42" y1="38" x2="944" y2="38"></line>
								<line x1="42" y1="134" x2="944" y2="134"></line>
								<line x1="42" y1="230" x2="944" y2="230"></line>
							</g>
							<path class="analytics-chart__area" data-chart-area d="M 42 230 L 944 230 Z"></path>
							<path class="analytics-chart__line analytics-chart__line--views" data-chart-line="views" d="M 42 230 L 944 230"></path>
							<path class="analytics-chart__line analytics-chart__line--sessions" data-chart-line="sessions" d="M 42 230 L 944 230"></path>
							<line class="analytics-chart__guide" data-chart-guide x1="42" y1="24" x2="42" y2="230" style="display:none"></line>
							<g data-chart-points></g>
							<g class="analytics-chart__endpoints" data-chart-endpoints aria-hidden="true"></g>
						</svg>
						<div class="analytics-chart__tooltip" data-chart-tooltip hidden>
							<strong data-chart-tooltip-date>—</strong>
							<span><i class="analytics-legend-dot analytics-legend-dot--blue"></i><b data-chart-tooltip-views>—</b> 浏览</span>
							<span><i class="analytics-legend-dot analytics-legend-dot--gold"></i><b data-chart-tooltip-sessions>—</b> 访客</span>
						</div>
						<div class="analytics-chart__x-axis" aria-hidden="true">
							<span data-chart-x-label="start">—</span>
							<span data-chart-x-label="middle">—</span>
							<span data-chart-x-label="end">今天</span>
						</div>
						<div class="analytics-chart-empty" data-chart-empty hidden>
							<Icon is:inline name="material-symbols:query-stats-rounded" aria-hidden="true" />
							<strong>暂时没有可展示的趋势</strong>
							<span>公开数据接口暂时没有返回这段时间的记录。</span>
						</div>
					</div>

					<footer class="analytics-chart-footer">
						<div class="analytics-chart-legend" aria-label="图表图例">
							<span><i class="analytics-legend-dot analytics-legend-dot--blue"></i>浏览量</span>
							<span><i class="analytics-legend-dot analytics-legend-dot--gold"></i>访客</span>
						</div>
					</footer>

					<div class="analytics-traffic__details">
					<section class="analytics-traffic__period analytics-snapshot" data-analytics-period aria-labelledby="analytics-period-title">
						<div class="analytics-traffic__period-heading">
							<div class="analytics-snapshot__intro">
								<div>
									<strong id="analytics-period-title">本周期数据</strong>
									<span>近 30 天 · 北京时间</span>
								</div>
							</div>
							</div>

						<div class="analytics-snapshot__metrics" aria-label="近 30 天访问概览">
							<div class="analytics-snapshot__metric analytics-snapshot__metric--blue">
								<span class="analytics-snapshot__metric-icon analytics-snapshot__metric-icon--blue" aria-hidden="true"><Icon is:inline name="material-symbols:bar-chart-rounded" /></span>
								<span class="analytics-snapshot__metric-copy"><span>浏览量</span><small data-snapshot-change="pageviews">等待数据</small></span>
								<strong data-snapshot-stat="pageviews">—</strong>
							</div>
							<div class="analytics-snapshot__metric analytics-snapshot__metric--pink">
								<span class="analytics-snapshot__metric-icon analytics-snapshot__metric-icon--pink" aria-hidden="true"><Icon is:inline name="material-symbols:group-rounded" /></span>
								<span class="analytics-snapshot__metric-copy"><span>访客数</span><small data-snapshot-change="visitors">等待数据</small></span>
								<strong data-snapshot-stat="visitors">—</strong>
							</div>
							<div class="analytics-snapshot__metric analytics-snapshot__metric--mint">
								<span class="analytics-snapshot__metric-icon analytics-snapshot__metric-icon--mint" aria-hidden="true"><Icon is:inline name="material-symbols:calendar-month-rounded" /></span>
								<span class="analytics-snapshot__metric-copy"><span>活跃天数</span><small>有访问记录的日期</small></span>
								<strong data-snapshot-stat="activeDays">—</strong>
							</div>
							<div class="analytics-snapshot__metric analytics-snapshot__metric--gold">
								<span class="analytics-snapshot__metric-icon analytics-snapshot__metric-icon--gold" aria-hidden="true"><Icon is:inline name="material-symbols:trending-up-rounded" /></span>
								<span class="analytics-snapshot__metric-copy"><span>单日峰值</span><small>最高浏览量</small></span>
								<strong data-snapshot-stat="peak">—</strong>
							</div>
						</div>
					</section>

					<section class="analytics-traffic__ranking analytics-ranking-panel" aria-labelledby="analytics-pages-title">
							<header class="analytics-traffic__section-heading">
								<strong id="analytics-pages-title">大家在看什么</strong>
								<span>近 30 天 · 访客</span>
							</header>
					<ol class="analytics-ranking" data-ranking-list>
						{Array.from({ length: 4 }, (_, index) => (
							<li class="analytics-ranking__item analytics-skeleton-row" data-ranking-skeleton>
								<span class="analytics-ranking__index">{String(index + 1).padStart(2, "0")}</span>
								<span class="analytics-ranking__copy"><i></i><em></em></span>
								<strong>—</strong>
							</li>
						))}
					</ol>
						</section>
					</div>
				</section>

				<section class="analytics-panel analytics-deployment card-base" aria-labelledby="analytics-push-title" data-push-rhythm>
				<header class="analytics-panel__header analytics-panel__header--compact analytics-deployment__header">
					<div class="analytics-deployment__heading">
						<p class="analytics-section-kicker">OPERATIONS / RELEASES</p>
						<h2 id="analytics-push-title">推送节奏</h2>
						<p class="analytics-panel__description">按 GitHub main 分支推送时间观察活动密度</p>
					</div>
					<div class="analytics-deployment__art" aria-hidden="true">
						<p>持续热爱，<br />一直在更新！</p>
						<span>♥</span>
						<img src="/assets/images/analytics/push-rhythm-character.png" alt="" loading="lazy" decoding="async" />
					</div>
					<span class="analytics-panel__badge analytics-deployment__status" data-push-status>读取中</span>
				</header>
				<div class="analytics-deployment__metrics">
					<div class="analytics-deployment__metric analytics-deployment__metric--latest analytics-deployment__metric--blue">
						<span class="analytics-deployment__metric-icon" aria-hidden="true"><Icon is:inline name="material-symbols:schedule-rounded" /></span>
						<span class="analytics-deployment__metric-copy">
							<span>最近一次推送</span>
							<strong data-push-latest>—</strong>
						</span>
						<em data-push-latest-badge>—</em>
					</div>
					<div class="analytics-deployment__metric analytics-deployment__metric--pink">
						<span class="analytics-deployment__metric-icon" aria-hidden="true"><Icon is:inline name="material-symbols:calendar-month-rounded" /></span>
						<span class="analytics-deployment__metric-copy">
							<span>最近间隔</span>
							<strong data-push-interval>—</strong>
							<small>保持活跃 ✦</small>
						</span>
					</div>
					<div class="analytics-deployment__metric analytics-deployment__metric--blue">
						<span class="analytics-deployment__metric-icon" aria-hidden="true"><Icon is:inline name="material-symbols:bar-chart-rounded" /></span>
						<span class="analytics-deployment__metric-copy">
							<span>平均节奏</span>
							<strong data-push-average>—</strong>
							<small>基于全部推送</small>
						</span>
					</div>
					<div class="analytics-deployment__metric analytics-deployment__metric--violet">
						<span class="analytics-deployment__metric-icon" aria-hidden="true"><Icon is:inline name="material-symbols:local-fire-department-rounded" /></span>
						<span class="analytics-deployment__metric-copy">
							<span>连续推送</span>
							<strong data-push-streak>—</strong>
							<small data-push-streak-note>继续加油！</small>
						</span>
					</div>
				</div>
					<div class="analytics-deployment__heatmap" data-push-heatmap>
						<div class="analytics-deployment__heatmap-head">
							<div class="analytics-deployment__heatmap-title"><strong>推送活动</strong><span title="每格代表一天，颜色越深表示推送越多" aria-label="每格代表一天，颜色越深表示推送越多"><Icon is:inline name="material-symbols:info-outline-rounded" aria-hidden="true" /></span></div>
							<div class="analytics-deployment__snake-controls" aria-label="贪吃蛇设置">
								<div class="analytics-deployment__snake-control" role="group" aria-label="蛇速度">
									<span>蛇速度</span>
									<div class="analytics-deployment__snake-options">
										<button type="button" data-push-snake-speed="1" aria-pressed="true">1x</button>
										<button type="button" data-push-snake-speed="2" aria-pressed="false">2x</button>
										<button type="button" data-push-snake-speed="5" aria-pressed="false">5x</button>
									</div>
								</div>
								<div class="analytics-deployment__snake-control" role="group" aria-label="食物容量，每个食物增长格数">
									<span>食物容量</span>
									<div class="analytics-deployment__snake-options">
										<button type="button" data-push-snake-food-capacity="1" aria-pressed="true" title="吃一个食物增长 1 格">1x</button>
										<button type="button" data-push-snake-food-capacity="2" aria-pressed="false" title="吃一个食物增长 2 格">2x</button>
										<button type="button" data-push-snake-food-capacity="5" aria-pressed="false" title="吃一个食物增长 5 格">5x</button>
									</div>
								</div>
							</div>
							<div class="analytics-deployment__heatmap-tabs" role="group" aria-label="热力图时间粒度">
								<button type="button" data-push-heatmap-mode="daily" aria-pressed="true">每日</button>
								<button type="button" data-push-heatmap-mode="weekly" aria-pressed="false">每周</button>
								<button type="button" data-push-heatmap-mode="cumulative" aria-pressed="false">累计</button>
							</div>
						</div>
						<div class="analytics-deployment__heatmap-scroll" data-push-heatmap-scroll>
							<div class="analytics-deployment__heatmap-layout">
								<div class="analytics-deployment__heatmap-main">
									<div class="analytics-deployment__heatmap-grid" data-push-heatmap-grid role="grid" aria-label="近一年 GitHub 推送活动，每格代表一天，颜色越深表示当天推送越多"></div>
									<div class="analytics-deployment__months" data-push-heatmap-months aria-hidden="true"></div>
								</div>
							</div>
						</div>
						<div class="analytics-deployment__heatmap-foot">
							<span class="analytics-deployment__source"><Icon is:inline name="simple-icons:github" aria-hidden="true" /><span data-push-note>按 GitHub main 分支推送时间统计 · 已扣除每日 2 次固定 Actions</span></span>
							<span class="analytics-deployment__heatmap-legend" aria-label="推送次数图例">
								<span>少</span><i data-level="0"></i><i data-level="1"></i><i data-level="2"></i><i data-level="3"></i><i data-level="4"></i><span>多</span>
							</span>
							<strong data-push-count>—</strong>
						</div>
						<div class="analytics-deployment__message">
							<span class="analytics-deployment__message-icon" aria-hidden="true"><Icon is:inline name="material-symbols:lightbulb-rounded" /></span>
							<div><strong data-push-heatmap-detail>快来和小蛇蛇交互一下。</strong><span>「每一次推送，都是让想法变成现实的一小步。」</span></div>
							<Icon class="analytics-deployment__message-plane" is:inline name="material-symbols:send-rounded" aria-hidden="true" />
						</div>
					</div>
				</section>

				<section
					class="analytics-panel analytics-activity card-base"
					aria-labelledby="analytics-activity-title"
					data-visitor-activity
				>
					<header class="analytics-panel__header analytics-activity__header">
						<div class="analytics-activity__heading">
							<p class="analytics-section-kicker">VISITOR / ACTIVITY</p>
							<div class="analytics-activity__title-row">
								<h2 id="analytics-activity-title">访客活跃时间</h2>
								<span class="analytics-panel__badge analytics-activity__range">近 30 天</span>
							</div>
							<p class="analytics-panel__description">看看大家通常在什么时候来这里</p>
						</div>
					</header>

					<div class="analytics-activity__body">
						<div class="analytics-activity__heatmap-wrap">
							<div class="analytics-activity__heatmap" data-activity-heatmap>
								<div class="analytics-activity__hours" aria-hidden="true">
									{Array.from({ length: 12 }, (_, index) => <span>{String(index * 2).padStart(2, "0")}时</span>)}
								</div>
								<div class="analytics-activity__days" aria-hidden="true">
									{["周一", "周二", "周三", "周四", "周五", "周六", "周日"].map((day) => <span>{day}</span>)}
								</div>
