				snakeFoodCapacityHandlers.forEach(([button, handler]) => button.removeEventListener("click", handler));
			};
		};

		const setupVisitorActivity = (root, apiBase, shareId) => {
			const card = root.querySelector("[data-visitor-activity]");
			const grid = card?.querySelector("[data-activity-grid]");
			if (!card || !grid) return () => {};

			const cells = [...grid.querySelectorAll("[data-activity-cell]")];
			const note = card.querySelector("[data-activity-note]");
			const statElements = {
				time: card.querySelector('[data-activity-stat="time"]'),
				day: card.querySelector('[data-activity-stat="day"]'),
				night: card.querySelector('[data-activity-stat="night"]'),
				today: card.querySelector('[data-activity-stat="today"]'),
			};
			const weekdayLabels = ["周一", "周二", "周三", "周四", "周五", "周六", "周日"];
			const weekdayIndex = { Mon: 0, Tue: 1, Wed: 2, Thu: 3, Fri: 4, Sat: 5, Sun: 6 };
			const activityPartsFormatter = new Intl.DateTimeFormat("en-US", {
				timeZone,
				weekday: "short",
				hour: "2-digit",
				hourCycle: "h23",
			});
			const controller = new AbortController();
			let activeValues = [];
			let activityAnimationFrame = 0;

			const setText = (element, value) => {
				if (element) element.textContent = value;
			};
			const animateActivityHeatmap = () => {
				if (!grid) return;
				if (activityAnimationFrame) cancelAnimationFrame(activityAnimationFrame);
				const cells = [...grid.querySelectorAll("[data-activity-cell]")];
				const activeCells = cells
					.filter((cell) => cell.dataset.activityActive === "true")
					.sort((a, b) => Number(a.dataset.activityIndex || 0) - Number(b.dataset.activityIndex || 0));
				const reducedMotion = window.matchMedia?.("(prefers-reduced-motion: reduce)")?.matches;
				const animationClock = getAnimationClock();
				const startedAt = animationClock.start();
				const generationEnd = 0.42;
				const rhythmEnd = 0.82;
				const setCellReveal = (cell, reveal) => {
					const easedReveal = reveal <= 0 ? 0 : 0.5 - Math.cos(reveal * Math.PI) / 2;
					cell.style.setProperty("--activity-reveal", easedReveal.toFixed(3));
					cell.style.setProperty("--activity-scale", (0.72 + easedReveal * 0.28).toFixed(3));
				};
				const finish = () => {
					cells.forEach((cell) => {
						setCellReveal(cell, 1);
						cell.dataset.activityState = cell.dataset.activityActive === "true" ? "lit" : "idle";
						cell.classList.remove("is-activity-rhythm-active");
						cell.style.removeProperty("--activity-rhythm-pulse");
					});
					grid.dataset.activityAnimationPhase = "complete";
					activityAnimationFrame = 0;
				};

				grid.dataset.activityAnimationPhase = reducedMotion ? "complete" : "generating";
				cells.forEach((cell) => {
					cell.dataset.activityState = cell.dataset.activityActive === "true" ? "pending" : "idle";
					cell.classList.remove("is-activity-rhythm-active");
					cell.style.removeProperty("--activity-rhythm-pulse");
					setCellReveal(cell, reducedMotion ? 1 : 0);
				});
				if (reducedMotion) {
					finish();
					return;
				}

				const tick = (timestamp) => {
					const progress = Math.min(1, Math.max(0, (timestamp - startedAt) / animationClock.duration));
					const generationProgress = easeCountProgress(Math.min(1, progress / generationEnd));
					cells.forEach((cell, index) => {
						const reveal = Math.max(0, Math.min(1, generationProgress * (cells.length + 1) - index));
						setCellReveal(cell, reveal);
					});

					const rhythmProgress = easeCountProgress(Math.max(0, Math.min(1, (progress - generationEnd) / (rhythmEnd - generationEnd))));
					const rhythmIndex = activeCells.length && progress >= generationEnd
						? Math.min(activeCells.length - 1, Math.floor(rhythmProgress * activeCells.length))
						: -1;
					activeCells.forEach((cell, index) => {
						const isCurrent = index === rhythmIndex && progress < rhythmEnd;
						cell.dataset.activityState = index <= rhythmIndex ? "lit" : "pending";
						cell.classList.toggle("is-activity-rhythm-active", isCurrent);
						if (isCurrent) {
							const cellStart = rhythmIndex / activeCells.length;
							const localProgress = Math.max(0, Math.min(1, (rhythmProgress - cellStart) * activeCells.length));
							const pulse = localProgress <= 0.5 ? localProgress * 2 : 2 - localProgress * 2;
							cell.style.setProperty("--activity-rhythm-pulse", pulse.toFixed(3));
						} else {
							cell.style.removeProperty("--activity-rhythm-pulse");
						}
					});

					if (progress < generationEnd) grid.dataset.activityAnimationPhase = "generating";
					else if (progress < rhythmEnd) grid.dataset.activityAnimationPhase = "rhythm";
					else grid.dataset.activityAnimationPhase = "complete";

					if (progress < 1) {
						activityAnimationFrame = requestAnimationFrame(tick);
						return;
					}
					finish();
				};
				activityAnimationFrame = requestAnimationFrame(tick);
			};

			const getActivityParts = (value) => {
				const date = new Date(value);
				if (Number.isNaN(date.getTime())) return null;
				const parts = Object.fromEntries(activityPartsFormatter.formatToParts(date).map((part) => [part.type, part.value]));
				const weekday = weekdayIndex[parts.weekday];
				const hour = Number(parts.hour);
				return Number.isInteger(weekday) && Number.isInteger(hour) ? { date, weekday, hour } : null;
			};

			const renderActivity = (rows, statusText) => {
				const matrix = Array.from({ length: 7 }, () => Array.from({ length: 24 }, () => 0));
				const rowDates = [];
				for (const row of rows) {
					const parsed = getActivityParts(row?.x ?? row?.t);
					const value = Math.max(0, Number(row?.y) || 0);
					if (!parsed || value <= 0) continue;
					matrix[parsed.weekday][parsed.hour] += value;
					rowDates.push({ ...parsed, value });
				}

				activeValues = matrix.flat();
				const maxValue = Math.max(0, ...activeValues);
				const totalValue = activeValues.reduce((sum, value) => sum + value, 0);
				const maxCellIndex = activeValues.indexOf(maxValue);
				const maxHour = maxCellIndex >= 0 ? maxCellIndex % 24 : -1;
				const dayTotals = matrix.map((day) => day.reduce((sum, value) => sum + value, 0));
				const peakDay = dayTotals.indexOf(Math.max(0, ...dayTotals));
				const nightValue = matrix.flatMap((day) => day.filter((_, hour) => hour >= 22 || hour <= 5)).reduce((sum, value) => sum + value, 0);
				const todayKey = dateKey(new Date());
				const todayValue = rowDates.filter(({ date }) => dateKey(date) === todayKey).reduce((sum, row) => sum + row.value, 0);

				cells.forEach((cell, index) => {
					const weekday = Number(cell.dataset.weekday);
					const hour = Number(cell.dataset.hour);
					const value = matrix[weekday]?.[hour] || 0;
					const ratio = maxValue ? value / maxValue : 0;
					const level = value > 0 ? Math.max(1, Math.ceil(ratio * 5)) : 0;
					cell.dataset.level = String(level);
					cell.dataset.activityActive = String(value > 0);
					cell.dataset.activityValue = String(value);
					cell.style.setProperty("--activity-intensity", ratio.toFixed(3));
					cell.dataset.activityIndex = String(index);
					cell.style.setProperty("--activity-index", String(index));
					cell.setAttribute("aria-label", `${weekdayLabels[weekday]} ${String(hour).padStart(2, "0")}:00 · ${formatNumber(value)} 次访问`);
					cell.title = cell.getAttribute("aria-label");
				});

				setText(statElements.time, maxHour >= 0 && maxValue > 0 ? `${String(maxHour).padStart(2, "0")}:00` : "—");
				setText(statElements.day, peakDay >= 0 && dayTotals[peakDay] > 0 ? weekdayLabels[peakDay] : "—");
				setText(statElements.night, totalValue > 0 ? `${Math.round((nightValue / totalValue) * 100)}%` : "—");
				setText(statElements.today, todayValue > 0 ? formatNumber(todayValue) : "—");
				if (note) note.textContent = statusText;
				card.dataset.activityReady = "true";
				animateActivityHeatmap();
			};

			const resetDetail = () => {
				if (note) note.textContent = "按北京时间聚合近 30 天访问记录 · 鼠标移入查看具体时段";
			};
			cells.forEach((cell) => {
				const showDetail = () => {
					const value = Number(cell.dataset.activityValue) || 0;
					const weekday = Number(cell.dataset.weekday);
					const hour = Number(cell.dataset.hour);
					if (note) note.textContent = `${weekdayLabels[weekday]} ${String(hour).padStart(2, "0")}:00 · ${formatNumber(value)} 次访问`;
				};
				cell.addEventListener("pointerenter", showDetail);
				cell.addEventListener("focus", showDetail);
				cell.addEventListener("pointerleave", resetDetail);
				cell.addEventListener("blur", resetDetail);
			});

			const load = async () => {
				if (!apiBase || !shareId) {
					renderActivity([], "尚未配置公开分享数据");
					return;
				}
				try {
					const share = await fetchShare(apiBase, shareId, controller.signal);
					const endAt = Date.now();
					const startAt = endAt - 30 * 24 * 60 * 60 * 1000;
					const url = new URL(`${apiBase}/api/websites/${share.websiteId}/pageviews`);
					url.searchParams.set("startAt", String(startAt));
					url.searchParams.set("endAt", String(endAt));
					url.searchParams.set("unit", "hour");
					url.searchParams.set("timezone", timeZone);
					const payload = await fetchJson(url, {
						headers: {
							"x-umami-share-token": share.token,
							"x-umami-share-context": "1",
						},
						signal: controller.signal,
					}, 7000);
					const sessions = readRows(payload?.sessions);
					const pageviews = readRows(payload?.pageviews);
					renderActivity(sessions.length ? sessions : pageviews, sessions.length ? "按北京时间聚合近 30 天访客记录 · 鼠标移入查看具体时段" : "按北京时间聚合近 30 天访问记录 · 鼠标移入查看具体时段");
				} catch (error) {
					if (error?.name === "AbortError") return;
					renderActivity([], "小时级公开数据暂时不可用 · 可稍后刷新");
				}
			};

			const handleAnimationReplay = () => {
				if (card.dataset.activityReady === "true") animateActivityHeatmap();
			};
			window.addEventListener("rainzt-analytics-animation-replay", handleAnimationReplay);
			load();
			return () => {
				controller.abort();
				if (activityAnimationFrame) cancelAnimationFrame(activityAnimationFrame);
				window.removeEventListener("rainzt-analytics-animation-replay", handleAnimationReplay);
				cells.forEach((cell) => {
					cell.replaceWith(cell.cloneNode(true));
				});
			};
		};

		const setup = () => {
			const root = document.querySelector("[data-umami-dashboard]");
			if (!root) {
				clearRuntime();
				return;
			}
			if (runtime.activeRoot === root) return;
			clearRuntime();
			runtime.activeRoot = root;

			const apiBase = String(root.dataset.apiBase || "").replace(/\/+$/, "");
			const shareId = root.dataset.shareId || "";
			const rangeButtons = [...root.querySelectorAll("[data-range]")];
			const refreshButton = root.querySelector("[data-analytics-refresh]");
			const cleanups = [];
			let range = 30;
			let controller;
			let refreshInFlight = false;
			let chartCleanup;
			runtime.cleanup = () => {
				controller?.abort();
				chartCleanup?.();
				for (const cleanup of cleanups.splice(0)) cleanup();
				runtime.activeRoot = null;
			};

			const localHost = ["localhost", "127.0.0.1", "::1", "0.0.0.0"].includes(window.location.hostname.toLowerCase());
			const isLocal = localHost || window.location.protocol === "file:" || document.documentElement.dataset.analyticsMode === "local";
			cleanups.push(setupAnalyticsFooter(root));
			cleanups.push(setupPushRhythm(root));
			cleanups.push(setupDomesticRegion(root, apiBase, shareId));
			root.classList.toggle("is-local-preview", isLocal);
			if (!hasPublicStats || !apiBase || !shareId) {
				setStatus(root, "offline", "未配置");
				root.querySelector("[data-analytics-last-update]").textContent = "尚未配置公开分享数据";
				renderTrafficSources(root, [], range);
				cleanups.push(setupVisitorActivity(root, apiBase, shareId));
				cleanups.push(setupRecentComments(root));
				return;
			}
			cleanups.push(setupVisitorActivity(root, apiBase, shareId));
			cleanups.push(setupRecentComments(root));

			const updateRangeButtons = () => rangeButtons.forEach((button) => button.setAttribute("aria-pressed", String(Number(button.dataset.range) === range)));
			const refresh = async (forceRefresh = false) => {
				if (refreshInFlight) return;
				refreshInFlight = true;
				chartCleanup?.(!forceRefresh);
				chartCleanup = undefined;
				controller?.abort();
				controller = new AbortController();
				root.classList.add("is-loading");
				setStatus(root, "loading", "读取中");
				if (refreshButton) refreshButton.disabled = true;
				const endAt = Date.now();
				const startAt = endAt - range * 24 * 60 * 60 * 1000;
				const cacheKey = getCacheKey(shareId, range);
				try {
					const cached = forceRefresh ? null : readCache(cacheKey);
					let requests;
					if (cached) {
						requests = {
							traffic: Promise.resolve(cached.pageviews),
							ranking: Promise.resolve(cached.paths),
						};
						if (cached.sources !== undefined) requests.sources = Promise.resolve(cached.sources);
					} else {
						const share = await fetchShare(apiBase, shareId, controller.signal);
						const headers = {
							"x-umami-share-token": share.token,
							"x-umami-share-context": "1",
						};
					const buildUrl = (path, params = {}) => {
						const url = new URL(`${apiBase}/api/websites/${share.websiteId}/${path}`);
						url.searchParams.set("startAt", String(startAt));
						url.searchParams.set("endAt", String(endAt));
						Object.entries(params).forEach(([key, value]) => url.searchParams.set(key, String(value)));
						return url;
					};
					// 热门页面排行：Umami v3 用 type=path，v2 实例只认 type=url
					// （返回的 x 同样是路径），先试 path 再回退 url，兼容两种实例
					const fetchRanking = async () => {
						const options = { headers, signal: controller.signal };
						try {
							return await fetchJson(buildUrl("metrics", { type: "path", limit: 20 }), options);
						} catch (error) {
							return await fetchJson(buildUrl("metrics", { type: "url", limit: 20 }), options);
						}
					};
					requests = {
						traffic: fetchJson(buildUrl("pageviews", { unit: "day", timezone: timeZone }), { headers, signal: controller.signal }),
						ranking: fetchRanking(),
						sources: fetchJson(buildUrl("metrics", { type: "channel", limit: 500 }), { headers, signal: controller.signal }),
					};
					}
					if (!requests.sources) {
						const share = await fetchShare(apiBase, shareId, controller.signal);
						const headers = {
							"x-umami-share-token": share.token,
							"x-umami-share-context": "1",
						};
						const url = new URL(`${apiBase}/api/websites/${share.websiteId}/metrics`);
						url.searchParams.set("startAt", String(startAt));
						url.searchParams.set("endAt", String(endAt));
						url.searchParams.set("type", "channel");
						url.searchParams.set("limit", "500");
						requests.sources = fetchJson(url, { headers, signal: controller.signal });
					}

					const sections = [
						{
							key: "traffic",
							request: requests.traffic,
							render: (payload) => {
								const pageviews = readRows(payload?.pageviews);
								const sessions = readRows(payload?.sessions);
								chartCleanup?.();
								chartCleanup = drawChart(root, pageviews, sessions, range);
							},
							fallback: () => showChartMessage(root, "趋势暂时不可用", "这块公开数据响应较慢，其他统计仍会继续显示。"),
						},
						{
							key: "ranking",
							request: requests.ranking,
							render: (payload) => renderRanking(root, readRows(payload)),
							fallback: () => showRankingMessage(root, "热门页面暂时不可用", "这块公开数据响应较慢，其他统计仍会继续显示。"),
						},
						{
							key: "sources",
							request: requests.sources,
							render: (payload) => renderTrafficSources(root, readRows(payload), range),
							fallback: () => renderTrafficSources(root, [], range),
						},
					];
					const successful = new Set();
					const failed = new Set();
					const updateProgress = () => {
						if (successful.size > 0 && failed.size === 0 && successful.size === sections.length) {
							setStatus(root, isLocal ? "local" : "online", isLocal ? "本地预览 · 已更新" : "在线");
							root.querySelector("[data-analytics-last-update]").textContent = `${isLocal ? "本地预览刚刚更新" : "刚刚更新"} · ${range} 天区间`;
						} else if (successful.size > 0) {
							setStatus(root, isLocal ? "local" : "online", isLocal ? "本地预览 · 部分更新" : "部分在线");
							root.querySelector("[data-analytics-last-update]").textContent = `已更新 ${successful.size}/${sections.length} 个模块`;
						}
					};
					const settleSection = async (section) => {
						try {
							return { status: "fulfilled", payload: await section.request };
						} catch (error) {
							return { status: "rejected", error };
						}
					};
					const applySectionResult = (section, result) => {
						if (result.status === "fulfilled") {
							section.render(result.payload);
							successful.add(section.key);
						} else {
							if (result.error?.name === "AbortError") return;
							failed.add(section.key);
							section.fallback();
						}
						updateProgress();
					};

					if (forceRefresh) {
						const results = await Promise.all(sections.map(settleSection));
						if (results.some((result) => result.status === "fulfilled" || result.error?.name !== "AbortError")) {
							replayAnalyticsAnimations();
							results.forEach((result, index) => applySectionResult(sections[index], result));
						}
					} else {
						await Promise.all(sections.map(async (section) => {
							applySectionResult(section, await settleSection(section));
						}));
					}

					if (!cached && successful.size === sections.length) {
						writeCache(cacheKey, {
							pageviews: await requests.traffic,
							paths: await requests.ranking,
							sources: await requests.sources,
						});
					}
					if (successful.size === 0 && failed.size > 0) {
						setStatus(root, "offline", "暂不可用");
						root.querySelector("[data-analytics-last-update]").textContent = "公开接口暂时没有响应 · 可稍后重试";
						renderTrafficSources(root, [], range);
					}
				} catch (error) {
					if (error?.name !== "AbortError") {
						setStatus(root, "offline", "暂不可用");
						root.querySelector("[data-analytics-last-update]").textContent = "公开接口暂时没有响应 · 可稍后重试";
						showUnavailableSections(root, "公开数据接口响应较慢，请稍后刷新重试。");
						renderTrafficSources(root, [], range);
					}
				} finally {
					refreshInFlight = false;
					root.classList.remove("is-loading");
					if (refreshButton) refreshButton.disabled = false;
				}
			};

			for (const button of rangeButtons) {
				const onClick = () => {
					range = Number(button.dataset.range) || 30;
					updateRangeButtons();
					refresh();
				};
				button.addEventListener("click", onClick);
				cleanups.push(() => button.removeEventListener("click", onClick));
			}
			if (refreshButton) {
				const onRefresh = () => refresh(true);
				refreshButton.addEventListener("click", onRefresh);
				cleanups.push(() => refreshButton.removeEventListener("click", onRefresh));
			}
			updateRangeButtons();
			refresh();
		};

		if (!runtime.bound) {
			for (const eventName of ["astro:page-load", "astro:after-swap", "swup:contentReplaced", "swup:page:view"]) {
				document.addEventListener(eventName, setup);
			}
			runtime.bound = true;
		}
		window[runtimeKey] = runtime;
		setup();
	})();
</script>

</MainGridLayout>

