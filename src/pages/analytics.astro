			const getPushDayStreak = (timestamps) => {
				const dayKeys = [...getActionAdjustedDailyCounts(timestamps).entries()]
					.filter(([, count]) => count > 0)
					.map(([key]) => key)
					.sort();
				if (!dayKeys.length) return 0;
				const activeDays = new Set(dayKeys);
				const cursor = new Date(`${dayKeys[dayKeys.length - 1]}T12:00:00Z`);
				let days = 0;
				while (activeDays.has(dateKey(cursor))) {
					days += 1;
