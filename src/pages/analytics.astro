---
import { Icon } from "astro-icon/components";
import AnalyticsSnapshot from "@/components/widget/AnalyticsSnapshot.astro";
import { analyticsConfig, commentConfig } from "@/config";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const umamiAnalytics = analyticsConfig.umamiAnalytics;
const shareId = umamiAnalytics?.shareId ?? "";
const shareApiBase = umamiAnalytics?.shareApiBase ?? "";
const historicalVisitors = umamiAnalytics?.historicalStats?.visitors ?? 0;
const historicalPageviews = umamiAnalytics?.historicalStats?.pageviews ?? 0;
const hasPublicStats = Boolean(
	umamiAnalytics?.websiteId && shareId && shareApiBase,
);
const sourceLabel = shareApiBase.includes("cloud.umami.is")
	? "Umami Cloud"
	: "Umami";
// 公开分享页地址（Umami 后台），由配置派生，避免写死实例与 slug
const publicShareUrl =
	shareApiBase && shareId
		? `${shareApiBase.replace(/\/+$/, "")}/share/${shareId}`
		: "";
// 最新评论模块复用本站评论系统的后端地址：
// Twikoo 读 envId，Waline 读 serverURL，两者都提供公开只读的评论接口
const commentBackend =
	commentConfig.type === "waline"
		? (commentConfig.waline?.serverURL ?? "")
		: (commentConfig.twikoo?.envId ?? "");
const commentProvider = commentConfig.type === "waline" ? "Waline" : "Twikoo";

// 收集可能承载评论的页面路径（Twikoo 按路径存评论，路径不含尾斜杠）：
// 留言板、友链、动态等固定页面 + 全部文章页，构建期一次性注入前端
const commentPaths = new Set<string>([
	"/guestbook",
	"/friends",
	"/moments",
	"/dynamic",
	"/about",
	"/",
]);
// 文章页路径：Twikoo 存的是原始文件名（如 "Todo/Todo"），而 Astro 的 glob loader
// 会把 id 规范化成小写连字符形式，两者对不上，因此直接扫描内容目录取原始相对路径
const postPaths = await (async () => {
	const paths: string[] = [];
	try {
		const { readdirSync, statSync } = await import("node:fs");
		const { join, relative, sep } = await import("node:path");
		const base = join(process.cwd(), "src", "content", "posts");
		const walk = (dir: string) => {
			for (const entry of readdirSync(dir)) {
				const full = join(dir, entry);
				if (statSync(full).isDirectory()) {
					walk(full);
					continue;
				}
				if (!/\.(md|mdx|markdown)$/iu.test(entry)) continue;
				const rel = relative(base, full).split(sep).join("/");
				const slug = rel.replace(/\.(md|mdx|markdown)$/iu, "");
				if (slug) paths.push(`/posts/${slug}`);
			}
		};
		walk(base);
	} catch {
		// 目录不可用时仅保留固定页面路径，不影响页面渲染
	}
	return paths;
})();
const commentPathList = [...commentPaths, ...postPaths];
---

<MainGridLayout title="站点统计" description="基于 Umami 的公开站点访问统计">
	<section
		class="analytics-page"
		data-umami-dashboard
		data-share-id={shareId}
		data-api-base={shareApiBase}
		data-historical-visitors={historicalVisitors}
		data-historical-pageviews={historicalPageviews}
		data-ready={hasPublicStats ? "true" : "false"}
		aria-labelledby="analytics-title"
	>
		<header class="analytics-hero card-base onload-animation">
			<div class="analytics-hero__grid">
				<div class="analytics-hero__copy">
					<div class="analytics-kicker">
						<span class="analytics-kicker__signal" aria-hidden="true"></span>
						<span>UMAMI / PUBLIC TELEMETRY</span>
					</div>
					<h1 id="analytics-title">站点统计</h1>
					<p class="analytics-hero__lead">
						这里展示的是本站的整体趋势，不记录任何可识别个人身份的信息。
					</p>
					<div class="analytics-hero__notes">
						<span><Icon is:inline name="material-symbols:lock-open-rounded" aria-hidden="true" />公开只读</span>
						<span><Icon is:inline name="material-symbols:calendar-today-rounded" aria-hidden="true" />按北京时间汇总</span>
					</div>
				</div>

				<div class="analytics-hero__meta">
					<div class="analytics-status" data-analytics-status data-state="loading" role="status" aria-live="polite">
						<span class="analytics-status__dot" aria-hidden="true"></span>
						<span data-analytics-status-text>连接中</span>
					</div>
					<div class="analytics-hero__stamp">
						<span>DATA SOURCE</span>
						<strong>{sourceLabel}</strong>
						<small data-analytics-last-update>公开分享数据 · 自动刷新</small>
					</div>
				</div>
			</div>

			<div class="analytics-hero__rail" aria-hidden="true">
				<span>RZ / 2026</span>
				<span></span>
				<span>MEASURE WHAT MATTERS</span>
			</div>
		</header>

		<section class="analytics-summary" aria-label="站点概览">
			<article class="analytics-summary-card analytics-summary-card--blue">
				<div class="analytics-summary-card__topline">
					<span class="analytics-summary-card__label">ALL-TIME</span>
					<Icon is:inline name="material-symbols:group-rounded" aria-hidden="true" />
				</div>
				<strong data-umami-stat="visitors" aria-live="polite">加载中</strong>
				<span>累计访客</span>
				<small>含迁移前历史累计</small>
			</article>
			<article class="analytics-summary-card analytics-summary-card--mint">
				<div class="analytics-summary-card__topline">
					<span class="analytics-summary-card__label">ALL-TIME</span>
					<Icon is:inline name="material-symbols:visibility-rounded" aria-hidden="true" />
				</div>
				<strong data-umami-stat="pageviews" aria-live="polite">加载中</strong>
				<span>累计浏览</span>
				<small>含迁移前历史累计</small>
			</article>
			<article class="analytics-summary-card analytics-summary-card--gold">
				<div class="analytics-summary-card__topline">
					<span class="analytics-summary-card__label">TODAY</span>
					<Icon is:inline name="material-symbols:person-search-rounded" aria-hidden="true" />
				</div>
				<strong data-umami-stat="todayVisitors" aria-live="polite">加载中</strong>
				<span>今日访客</span>
				<small>北京时间 00:00 起</small>
			</article>
			<article class="analytics-summary-card analytics-summary-card--violet">
				<div class="analytics-summary-card__topline">
					<span class="analytics-summary-card__label">TODAY</span>
					<Icon is:inline name="material-symbols:trending-up-rounded" aria-hidden="true" />
				</div>
				<strong data-umami-stat="todayPageviews" aria-live="polite">加载中</strong>
				<span>今日浏览</span>
				<small>实时公开数据</small>
			</article>
		</section>

		<div class="analytics-layout">
			<main class="analytics-main">
				<section class="analytics-panel analytics-traffic card-base" aria-labelledby="analytics-traffic-title">
