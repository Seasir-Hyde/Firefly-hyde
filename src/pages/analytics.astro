				const minimumCellSize = fontSize * 0.56;
				const gap = parseFloat(gridStyles?.columnGap) || fontSize * 0.16;
				const availableWidth = Math.max(
					0,
					width - (parseFloat(scrollStyles?.paddingLeft) || 0) - (parseFloat(scrollStyles?.paddingRight) || 0),
				);
				const weeksByMonth = [26, 30, 35, 39, 44, 48, 53];
