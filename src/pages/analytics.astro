				const cells = [...heatmapGrid.querySelectorAll(".analytics-deployment__cell")];
				const activeCells = cells
					.filter((cell) => cell.dataset.pushActive === "true")
					.sort((a, b) => Number(a.dataset.pushRhythmOrder || 0) - Number(b.dataset.pushRhythmOrder || 0));
				const reducedMotion = window.matchMedia?.("(prefers-reduced-motion: reduce)")?.matches;
				const animationClock = getAnimationClock();
				const startedAt = animationClock.start();
