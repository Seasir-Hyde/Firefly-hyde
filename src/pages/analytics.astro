			const list = root.querySelector("[data-comments-list]");
			if (!list) return;
			const items = [...list.querySelectorAll(".analytics-comment:not(.analytics-comment--skeleton)")];
			if (!items.length) return;
			const previousFrame = recentCommentsAnimationFrames.get(list);
			if (previousFrame) cancelAnimationFrame(previousFrame);

			const animationClock = getAnimationClock();
			const startedAt = animationClock.start();
			const reducedMotion = window.matchMedia?.("(prefers-reduced-motion: reduce)")?.matches;
			const generationEnd = 0.42;
			const rhythmEnd = 0.82;
			const clamp = (value) => Math.max(0, Math.min(1, value));
			const setItemProgress = (item, progress, index) => {
				const rowStart = (index / Math.max(items.length, 1)) * 0.58;
				const rowProgress = clamp((progress - rowStart) / 0.28);
				const eased = easeCountProgress(rowProgress);
				item.style.setProperty("--comment-opacity", eased.toFixed(3));
				item.style.setProperty("--comment-offset", `${((1 - eased) * 0.72).toFixed(3)}rem`);
				item.style.setProperty("--comment-scale", (0.98 + eased * 0.02).toFixed(3));
				item.dataset.commentsAnimationState = rowProgress >= 1 ? "visible" : "pending";
				return eased;
			};
			const finish = () => {
				items.forEach((item) => {
					item.style.setProperty("--comment-opacity", "1");
					item.style.setProperty("--comment-offset", "0rem");
					item.style.setProperty("--comment-scale", "1");
					item.style.setProperty("--comment-ring", "0");
					item.dataset.commentsAnimationState = "visible";
				});
				list.dataset.commentsAnimationPhase = "complete";
				recentCommentsAnimationFrames.delete(list);
			};

			if (reducedMotion) {
				finish();
				return;
			}

			list.dataset.commentsAnimationPhase = "generating";
			items.forEach((item) => {
				item.style.setProperty("--comment-opacity", "0");
				item.style.setProperty("--comment-offset", "0.72rem");
				item.style.setProperty("--comment-scale", "0.98");
				item.style.setProperty("--comment-ring", "0");
				item.dataset.commentsAnimationState = "pending";
			});

			const tick = (timestamp) => {
				const progress = clamp((timestamp - startedAt) / animationClock.duration);
				items.forEach((item, index) => setItemProgress(item, progress, index));
				const rhythmProgress = easeCountProgress(clamp((progress - generationEnd) / (rhythmEnd - generationEnd)));
				const pulse = progress >= generationEnd && progress < rhythmEnd ? Math.sin(rhythmProgress * Math.PI) : 0;
				items[0]?.style.setProperty("--comment-ring", (pulse * 0.9).toFixed(3));
				list.dataset.commentsAnimationPhase = progress < generationEnd ? "generating" : progress < rhythmEnd ? "rhythm" : "complete";
				if (progress < 1) {
					const frame = requestAnimationFrame(tick);
					recentCommentsAnimationFrames.set(list, frame);
					return;
				}
				finish();
			};

			recentCommentsAnimationFrames.set(list, requestAnimationFrame(tick));
		};

