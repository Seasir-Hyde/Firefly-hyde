			};
			const selectSnakeSpeed = (value) => {
				snakeSpeedButtons.forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.pushSnakeSpeed === value)));
				snake.setSpeedMultiplier(value);
			};
			const selectFoodGrowth = (value) => {
				snakeFoodCapacityButtons.forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.pushSnakeFoodCapacity === value)));
				snake.setFoodGrowthMultiplier(value);
			};
			selectSnakeSpeed(selectedSnakeSpeed);
			selectFoodGrowth(selectedFoodGrowth);
			const modeHandlers = modeButtons.map((button) => {
				const handler = () => selectMode(button.dataset.pushHeatmapMode || "daily");
				button.addEventListener("click", handler);
				return [button, handler];
			});
			const snakeSpeedHandlers = snakeSpeedButtons.map((button) => {
				const handler = () => selectSnakeSpeed(button.dataset.pushSnakeSpeed || "1");
				button.addEventListener("click", handler);
				return [button, handler];
			});
			const snakeFoodCapacityHandlers = snakeFoodCapacityButtons.map((button) => {
				const handler = () => selectFoodGrowth(button.dataset.pushSnakeFoodCapacity || "1");
				button.addEventListener("click", handler);
				return [button, handler];
			});

			const controller = new AbortController();
			const load = async () => {
				try {
					const pushesPayload = await fetchJson(`/api/github-pushes.json?t=${Date.now()}`, {
						headers: { Accept: "application/json" },
						signal: controller.signal,
					}, 5000);
					if (controller.signal.aborted) return;

					pushTimestamps = (Array.isArray(pushesPayload?.commits) ? pushesPayload.commits : [])
						.map((value) => new Date(value).getTime())
						.filter((value) => Number.isFinite(value))
						.sort((a, b) => b - a);
					renderCurrentHeatmap();
					if (!pushTimestamps.length) {
						setText(status, "待记录");
						setText(latest, "—");
						setText(latestBadge, "—");
						setText(interval, "—");
						setText(average, "—");
						setText(streak, "—");
						setText(streakNote, "等待第一次推送");
						setText(count, "—");
						setText(note, "等待 GitHub main 分支的下一次推送");
						return;
					}

					setText(status, "已记录");
					setText(latest, dateTimeFormatter.format(new Date(pushTimestamps[0])));
					const latestAgeSeconds = Math.max(0, (Date.now() - pushTimestamps[0]) / 1000);
					setText(latestBadge, latestAgeSeconds < 60 ? "刚刚" : `${formatDeploymentDuration(latestAgeSeconds)}前`);
					const streakDays = getPushDayStreak(pushTimestamps);
					setText(streak, streakDays ? `${streakDays} 天` : "—");
					setText(streakNote, streakDays > 1 ? "保持连续更新" : "从今天开始");
					setText(count, `最近 ${getActionAdjustedTotal(pushTimestamps)} 次`);
					if (pushTimestamps.length < 2) {
						setText(interval, "首次推送");
						setText(average, "等待下一次");
						setText(note, "按 GitHub main 分支推送时间统计 · 已扣除每日 2 次固定 Actions");
						return;
					}

					const intervals = pushTimestamps.slice(0, -1).map((value, index) => value - pushTimestamps[index + 1]);
					const latestInterval = intervals[0] / 1000;
					const averageInterval = intervals.reduce((sum, value) => sum + value, 0) / intervals.length / 1000;
					setText(interval, formatDeploymentDuration(latestInterval));
					setText(average, formatDeploymentDuration(averageInterval));
					setText(note, "按 GitHub main 分支推送时间统计 · 已扣除每日 2 次固定 Actions");
				} catch (error) {
					if (error?.name === "AbortError") return;
					setText(status, "暂不可用");
					setText(latest, "—");
					setText(latestBadge, "—");
					setText(interval, "—");
					setText(average, "—");
					setText(streak, "—");
					setText(streakNote, "等待接口恢复");
					setText(count, "—");
					setText(note, "GitHub 推送记录接口暂时没有响应");
					pushTimestamps = [];
					renderCurrentHeatmap();
				}
			};

			load();
			return () => {
				controller.abort();
				if (pushAnimationFrame) cancelAnimationFrame(pushAnimationFrame);
				heatmapResizeObserver?.disconnect();
				snake.destroy();
				window.removeEventListener("rainzt-analytics-animation-replay", handleAnimationReplay);
				heatmapGrid?.removeEventListener("pointerleave", resetHeatmapDetail);
				heatmapGrid?.removeEventListener("focusout", handleHeatmapFocusout);
				modeHandlers.forEach(([button, handler]) => button.removeEventListener("click", handler));
