		</footer>
	</section>

<script is:inline define:vars={{ hasPublicStats }}>
	(() => {
		const runtimeKey = "__rainztAnalyticsPageRuntime";
		const runtime = window[runtimeKey] || {
			activeRoot: null,
			cleanup: null,
			bound: false,
		};
		const timeZone = "Asia/Shanghai";
		const defaultActionRunsPerDay = 2;
		const numberFormatter = new Intl.NumberFormat("zh-CN");
		const animationClockKey = "__rainztAnalyticsAnimationClock";
		const datePartsFormatter = new Intl.DateTimeFormat("zh-CN", {
			timeZone,
			year: "numeric",
			month: "2-digit",
			day: "2-digit",
		});
		const dateTimeFormatter = new Intl.DateTimeFormat("zh-CN", {
			timeZone,
			year: "numeric",
			month: "2-digit",
			day: "2-digit",
			hour: "2-digit",
			minute: "2-digit",
		});

		const clearRuntime = () => {
			if (typeof runtime.cleanup === "function") runtime.cleanup();
			runtime.cleanup = null;
			runtime.activeRoot = null;
		};

		const formatNumber = (value) => numberFormatter.format(Math.max(0, Math.round(Number(value) || 0)));
		const visualDuration = 4500;
		const easeCountProgress = (progress) => progress < 0.18
			? 0.08 * Math.pow(progress / 0.18, 2)
			: progress < 0.9
				? 0.08 + 0.82 * ((progress - 0.18) / 0.72)
				: 0.9 + 0.1 * (1 - Math.pow(1 - ((progress - 0.9) / 0.1), 3));
		const getAnimationClock = () => {
			const root = document.querySelector("[data-umami-dashboard]");
			const current = window[animationClockKey];
			if (current?.root === root) return current;
			const clock = {
				root,
				duration: visualDuration,
				startedAt: null,
				start() {
					if (this.startedAt === null) this.startedAt = performance.now();
					return this.startedAt;
				},
				replay() {
					this.startedAt = null;
					window.dispatchEvent(new CustomEvent("rainzt-analytics-animation-replay"));
				},
			};
			window[animationClockKey] = clock;
			return clock;
		};
		const formatDeploymentDuration = (seconds) => {
			const totalMinutes = Math.max(1, Math.round(Number(seconds) / 60));
			if (totalMinutes < 60) return `约 ${totalMinutes} 分钟`;
			const totalHours = Math.round(totalMinutes / 60);
			if (totalHours < 24) return `约 ${totalHours} 小时`;
			const days = Math.floor(totalHours / 24);
			const hours = totalHours % 24;
			return hours ? `约 ${days} 天 ${hours} 小时` : `约 ${days} 天`;
		};
		const readRows = (value) => (Array.isArray(value) ? value : value?.data || []);
		const cleanCommentText = (value, fallback = "留下了一条评论") => {
			const text = String(value || "")
				// 先整块移除图片/链接等内嵌标签，避免残留 src 与 alt 文本
				.replace(/<(?:img|video|audio|iframe|embed|object)\b[^>]*>/giu, " ")
				.replace(/<a\b[^>]*>([\s\S]*?)<\/a>/giu, "$1")
				.replace(/<[^>]*>/gu, " ")
				.replace(/\s+/gu, " ")
				.trim();
			return text || fallback;
		};
		const formatCommentTime = (value) => {
			const date = new Date(value);
			if (Number.isNaN(date.getTime())) return "时间未知";
			const elapsed = Date.now() - date.getTime();
			if (elapsed < 60 * 1000) return "刚刚";
			if (elapsed < 60 * 60 * 1000) return `${Math.floor(elapsed / (60 * 1000))} 分钟前`;
			if (elapsed < 24 * 60 * 60 * 1000) return `${Math.floor(elapsed / (60 * 60 * 1000))} 小时前`;
			if (elapsed < 7 * 24 * 60 * 60 * 1000) return `${Math.floor(elapsed / (24 * 60 * 60 * 1000))} 天前`;
			return dateTimeFormatter.format(date);
		};
		const getRecentCommentRows = (payload) => {
			if (Array.isArray(payload)) return payload;
			if (Array.isArray(payload?.data)) return payload.data;
			if (Array.isArray(payload?.data?.data)) return payload.data.data;
			return [];
		};
		const isSafeHttpUrl = (value) => {
			if (typeof value !== "string" || !value.trim()) return false;
			try {
				return ["http:", "https:"].includes(new URL(value, window.location.origin).protocol);
			} catch {
				return false;
			}
		};
		const getCommentPage = (value) => {
			const rawPath = String(value || "").trim();
			if (!rawPath) return { label: "留言板", href: "/guestbook/" };
			try {
				const url = new URL(rawPath, window.location.origin);
				if (url.origin !== window.location.origin) return { label: "站点页面", href: "/" };
				const path = url.pathname || "/";
				// 留言板路径统一显示为「留言板」，链接补上尾斜杠匹配站内路由
				const isGuestbook = /^\/guestbook\/?$/u.test(path);
				// 文章路径显示 slug，其余固定页面显示路径
				const isPost = /^\/posts\//u.test(path);
				const label = isGuestbook
					? "留言板"
					: isPost
						? decodeURIComponent(path.replace(/^\/posts\//u, "").replace(/\/+$/u, ""))
						: path === "/"
							? "首页"
							: path.length > 34
								? `${path.slice(0, 33)}…`
								: path;
				return {
					label: label || "站点页面",
					href: isGuestbook
						? "/guestbook/"
						: isPost
							? `${path.replace(/\/+$/u, "")}/`
							: `${path}${url.search}${url.hash}`,
				};
			} catch {
				return { label: "站点页面", href: "/" };
			}
		};
		const getCommentHref = (href, objectId) => {
			const commentId = String(objectId ?? "").trim();
			if (!commentId) return href;
			try {
				const url = new URL(href, window.location.origin);
				url.hash = commentId;
				return `${url.pathname}${url.search}${url.hash}`;
			} catch {
				return href;
			}
		};
		const dateKey = (value) => {
			const parts = datePartsFormatter.formatToParts(new Date(value));
			const map = Object.fromEntries(parts.map((part) => [part.type, part.value]));
			return `${map.year}-${map.month}-${map.day}`;
		};
		const getActionAdjustedDailyCounts = (timestamps) => {
			const rawCounts = new Map();
			for (const timestamp of timestamps) {
				const key = dateKey(timestamp);
				rawCounts.set(key, (rawCounts.get(key) || 0) + 1);
			}
			return new Map([...rawCounts.entries()].map(([key, value]) => [key, Math.max(0, value - defaultActionRunsPerDay)]));
		};
		const getActionAdjustedTotal = (timestamps) => [...getActionAdjustedDailyCounts(timestamps).values()]
			.reduce((sum, value) => sum + value, 0);
		const dateLabel = (key) => String(key || "").slice(5).replace("-", ".");
		const getLocalDayStart = () => {
			const now = new Date();
			now.setHours(0, 0, 0, 0);
			return now.getTime();
		};

		// 拉取公开评论流：Twikoo 走 POST 事件协议，Waline 走 GET 查询协议
		const fetchCommentFeed = async (serverURL, provider, paths, signal) => {
			if (provider === "Waline") {
				const url = new URL(`${serverURL}/api/comment`);
				url.searchParams.set("type", "recent");
				url.searchParams.set("count", "8");
				url.searchParams.set("lang", "zh-CN");
				const payload = await fetchJson(url.toString(), {
					headers: { Accept: "application/json" },
					signal,
				});
				if (Number(payload?.errno) > 0) {
					throw new Error(payload?.errmsg || "waline comments unavailable");
				}
				return payload;
			}
			// Twikoo 1.x 的 GET_RECENT_COMMENTS 在部分自托管实例上有 SQL 拼接缺陷，
			// 改为按页面路径并行取 COMMENT_GET，再合并所有页面的评论按时间排序。
			const postTwikoo = async (path) =>
				fetchJson(`${serverURL}/api/comment`, {
					method: "POST",
					headers: {
						Accept: "application/json",
						"Content-Type": "application/json",
					},
					body: JSON.stringify({
						event: "COMMENT_GET",
						url: path,
						pageSize: 20,
					}),
					signal,
				});
			// 单个路径失败不应影响其它路径，这里吞掉异常只取成功的结果
			const fetchPaths = async (group) => {
				const results = await Promise.all(
					group.map(async (path) => {
						try {
							const payload = await postTwikoo(path);
							if (Number(payload?.code) > 0) return [];
							const rows = Array.isArray(payload?.data) ? payload.data : [];
							return rows.map((row) => ({ ...row, __path: row?.url || path }));
						} catch {
							return [];
						}
					}),
				);
				return results.flat();
			};
			const all = Array.isArray(paths) && paths.length ? paths : ["/guestbook"];
			// 分批取：先取固定页面（留言板/友链等，评论最集中），
			// 不足目标条数再补文章页，避免一次性打出大量并发请求
			const target = 8;
			let merged = await fetchPaths(all.slice(0, 6));
			if (merged.length < target && all.length > 6) {
				merged = merged.concat(await fetchPaths(all.slice(6)));
			}
			// 去重（同一评论可能出现在多个路径结果里），再按创建时间倒序
			const seen = new Set();
			const unique = merged.filter((row) => {
				const key = String(row?.id || `${row?.nick}-${row?.created}`);
				if (seen.has(key)) return false;
				seen.add(key);
				return true;
			});
			unique.sort((a, b) => Number(b?.created || 0) - Number(a?.created || 0));
			return { data: unique };
		};
		const fetchJson = async (url, options = {}, timeoutMs = 8000) => {
			const timeoutController = new AbortController();
			let didTimeout = false;
			const timeoutId = window.setTimeout(() => {
				didTimeout = true;
				timeoutController.abort();
			}, timeoutMs);
			const sourceSignal = options.signal;
			const abortFromSource = () => timeoutController.abort();
			if (sourceSignal?.aborted) timeoutController.abort();
			else sourceSignal?.addEventListener("abort", abortFromSource, { once: true });

			try {
				const response = await fetch(url, {
					cache: "no-store",
					...options,
					signal: timeoutController.signal,
				});
				if (!response.ok) throw new Error(`umami ${response.status}`);
				return await response.json();
			} catch (error) {
				if (didTimeout) {
					const timeoutError = new Error(`request timeout after ${timeoutMs}ms`);
					timeoutError.name = "TimeoutError";
					throw timeoutError;
				}
				throw error;
			} finally {
				window.clearTimeout(timeoutId);
				sourceSignal?.removeEventListener("abort", abortFromSource);
			}
		};

		const readSharedShare = (shareId) => {
			try {
				const cached = JSON.parse(localStorage.getItem("rainzt:umami:share") || "null");
				if (
					cached?.tag === shareId &&
					cached?.value?.websiteId &&
					cached?.value?.token &&
					typeof cached.timestamp === "number" &&
					Date.now() - cached.timestamp < 24 * 60 * 60 * 1000
				) {
					return cached.value;
				}
			} catch {
				// The metrics widget may be unable to use localStorage; keep the live request path.
			}
			return null;
		};

		const fetchShare = async (apiBase, shareId, signal) => {
			const sharedShare = readSharedShare(shareId);
			if (sharedShare) return sharedShare;

			const encodedId = encodeURIComponent(shareId);
			const urls = [
				`${apiBase}/api/share/${encodedId}`,
				`${apiBase}/api/share/id/${encodedId}`,
			];
			let lastError;
			for (const url of urls) {
				try {
					const share = await fetchJson(url, { signal }, 6000);
					if (share?.websiteId && share?.token) return share;
					lastError = new Error("invalid public share");
				} catch (error) {
					if (error?.name === "AbortError" && signal?.aborted) throw error;
					lastError = error;
				}
			}
			throw lastError || new Error("public share unavailable");
		};

		const getCacheKey = (websiteId, range) => `rainzt:umami:dashboard:${websiteId}:${range}`;
		const readCache = (key) => {
			try {
				const cached = JSON.parse(localStorage.getItem(key) || "null");
				if (cached?.timestamp && Date.now() - cached.timestamp < 2 * 60 * 1000) return cached.value;
			} catch {
				// Private browsing may disable localStorage; the live request still works.
			}
			return null;
		};
		const writeCache = (key, value) => {
			try {
				localStorage.setItem(key, JSON.stringify({ timestamp: Date.now(), value }));
			} catch {
				// Ignore unavailable local storage.
			}
		};

		const drawChart = (root, pageviewRows, sessionRows, range) => {
			const chart = root.querySelector("[data-traffic-chart]");
			const area = root.querySelector("[data-chart-area]");
			const viewLine = root.querySelector('[data-chart-line="views"]');
			const sessionLine = root.querySelector('[data-chart-line="sessions"]');
			const pointLayer = root.querySelector("[data-chart-points]");
			const endpointLayer = root.querySelector("[data-chart-endpoints]");
			if (!chart || !area || !viewLine || !sessionLine || !pointLayer) return;
			const isInitialRender = chart.dataset.chartReady !== "true";
			if (isInitialRender) chart.classList.add("is-chart-initializing");

			const makeMap = (rows) => {
				const map = new Map();
				for (const row of rows) map.set(dateKey(row?.x || row?.t), Number(row?.y) || 0);
				return map;
			};
