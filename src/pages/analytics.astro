			const snake = setupPushSnake(panel);
			const selectedSnakeSpeed = snakeSpeedButtons.find((button) => button.getAttribute("aria-pressed") === "true")?.dataset.pushSnakeSpeed || "1";
			const selectedFoodGrowth = snakeFoodCapacityButtons.find((button) => button.getAttribute("aria-pressed") === "true")?.dataset.pushSnakeFoodCapacity || "1";
			let selectedMode = modeButtons.find((button) => button.getAttribute("aria-pressed") === "true")?.dataset.pushHeatmapMode || "daily";
			let pushTimestamps = [];
