				grid.dataset.snakeLength = String(snake.length);
			};
			const spawnFood = () => {
				const available = [...emptyCells].filter((index) => !food.has(index) && !snake.includes(index));
				if (!available.length) return false;
				food.add(randomItem(available));
				return true;
			};
			const getNeighbours = (index) => {
				const column = Math.floor(index / rows);
				const row = index % rows;
				const columnCount = Math.max(1, Math.ceil(cells.length / rows));
				return [
					[column - 1, row],
					[column + 1, row],
					[column, row - 1],
					[column, row + 1],
				]
					.filter(([nextColumn, nextRow]) => nextColumn >= 0 && nextColumn < columnCount && nextRow >= 0 && nextRow < rows)
					.map(([nextColumn, nextRow]) => nextColumn * rows + nextRow)
					.filter((nextIndex) => emptyCells.has(nextIndex));
			};
			const createInitialSnake = () => {
				const heads = [...emptyCells].sort(() => Math.random() - 0.5);
				for (const head of heads) {
					const necks = getNeighbours(head).sort(() => Math.random() - 0.5);
					for (const neck of necks) {
						const tails = getNeighbours(neck).filter((index) => index !== head).sort(() => Math.random() - 0.5);
						if (tails.length) return [head, neck, tails[0]];
					}
				}
				return heads.length ? [heads[0]] : [];
			};
			const fillFood = () => {
				while (food.size < maxFood && spawnFood()) {}
			};
			const startTimer = () => {
				window.clearInterval(timer);
				if (window.matchMedia?.("(prefers-reduced-motion: reduce)")?.matches) return;
				timer = window.setInterval(tick, baseMoveInterval / speedMultiplier);
			};
			const startRound = () => {
				if (!emptyCells.size) {
					snake = [];
					food = new Set();
					renderSnake();
					return;
				}
				snake = createInitialSnake().slice(0, initialLength);
				food = new Set();
				targetFood = null;
				fillFood();
				renderSnake();
			};
			const endRound = () => {
				const currentRound = round;
				snake = [];
				food = new Set();
				targetFood = null;
				renderSnake();
				window.clearTimeout(resetTimer);
				resetTimer = window.setTimeout(() => {
					if (currentRound === round) startRound();
				}, 420);
			};
			const nextCell = () => {
				if (!snake.length) return null;
				const head = snake[0];
				const blocked = new Set(snake);
				const queue = [{ index: head, firstStep: null }];
				const visited = new Set([head]);
				const targets = targetFood !== null && food.has(targetFood) ? new Set([targetFood]) : food;
				while (queue.length) {
					const current = queue.shift();
					for (const neighbour of getNeighbours(current.index)) {
						if (visited.has(neighbour) || blocked.has(neighbour)) continue;
						const firstStep = current.firstStep ?? neighbour;
						if (targets.has(neighbour)) return firstStep;
						visited.add(neighbour);
						queue.push({ index: neighbour, firstStep });
					}
				}
				if (targetFood !== null && food.has(targetFood)) {
					targetFood = null;
					return nextCell();
				}

				const fallback = getNeighbours(head);
				const safeFallback = fallback.filter((index) => !blocked.has(index));
				if (safeFallback.length) return randomItem(safeFallback);
				return fallback.length ? randomItem(fallback) : null;
			};
			const extendSnake = (amount) => {
				for (let segment = 1; segment < amount; segment += 1) {
					const tail = snake[snake.length - 1];
					const neck = snake[snake.length - 2];
					const available = getNeighbours(tail).filter((index) => !snake.includes(index) && !food.has(index));
					if (!available.length) return false;
					const tailColumn = Math.floor(tail / rows);
					const tailRow = tail % rows;
					const neckColumn = Math.floor(neck / rows);
					const neckRow = neck % rows;
					const preferredColumn = tailColumn + (tailColumn - neckColumn);
					const preferredRow = tailRow + (tailRow - neckRow);
					const preferred = preferredColumn * rows + preferredRow;
					snake.push(available.includes(preferred) ? preferred : randomItem(available));
				}
				return true;
			};
			const tick = () => {
				if (!snake.length) return;
				const next = nextCell();
				if (next === null || snake.includes(next)) {
					endRound();
					return;
				}
				const ateFood = food.has(next);
				snake.unshift(next);
				if (ateFood) {
					food.delete(next);
					targetFood = null;
					if (!extendSnake(foodGrowthMultiplier)) {
						endRound();
						return;
					}
					spawnFood();
				} else {
					snake.pop();
				}
				renderSnake();
			};
