		text-shadow: 0 0 0.3rem color-mix(in srgb, #e0a313 26%, transparent);
	}

	.moments-random-article--own {
		--beam-accent: #149ed8;
	}

	.moments-random-article--own .moments-random-article__link strong {
		color: #149ed8;
		text-shadow: 0 0 0.3rem color-mix(in srgb, #149ed8 24%, transparent);
	}

	.moments-random-article__link [data-random-article-description] {
		margin-top: 0.13rem;
		color: var(--content-meta);
		font-size: 0.72rem;
		line-height: 1.45;
	}

	.moments-random-article__link [data-random-article-meta] {
		margin-top: 0.12rem;
		color: color-mix(in srgb, var(--content-meta) 76%, var(--primary));
		font-size: 0.64rem;
		line-height: 1.35;
	}

	.moments-random-article__countdown {
		position: absolute;
		z-index: 0;
		top: 50%;
		left: 50%;
		color: color-mix(in srgb, var(--content-meta) 68%, transparent);
		font-size: clamp(2.8rem, 7.4vw, 5rem);
		font-variant-numeric: tabular-nums;
		font-weight: 850;
		line-height: 1;
		pointer-events: none;
		transform: translate(-50%, -50%) translateZ(4px);
		transform-style: preserve-3d;
		text-shadow: 0 0 1rem color-mix(in srgb, var(--content-meta) 14%, transparent);
		animation: moments-random-countdown 1s ease-in-out infinite;
		user-select: none;
	}

	.moments-random-article__countdown[data-auto="false"] {
		opacity: 0.48;
		animation-play-state: paused;
	}

	.moments-random-article__auto,
	.moments-random-article__refresh {
		position: relative;
		z-index: 2;
	}

	.moments-random-article__auto {
		position: absolute;
		top: 0;
		left: 50%;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.25rem;
		min-height: 1.65rem;
		padding: 0.25rem 0.52rem;
		border: 1px solid var(--glass-control-border);
		border-radius: 999px;
		background: transparent;
		color: var(--primary);
		font-size: 0.62rem;
		font-weight: 720;
		transform: translate(-50%, -50%) translateZ(22px);
		transition: border-color 180ms ease, background-color 180ms ease, color 180ms ease, box-shadow 180ms ease;
	}

	.moments-random-article__auto svg {
		font-size: 0.82rem;
	}

	.moments-random-article__auto.is-active {
		border-color: color-mix(in srgb, var(--primary) 44%, var(--line-divider));
		background: transparent;
		color: var(--primary);
		box-shadow: none;
	}

	.moments-random-article__auto:hover,
	.moments-random-article__auto:focus-visible {
		border-color: var(--primary);
		color: var(--primary);
		outline: none;
	}

	.moments-random-article__refresh {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.28rem;
		min-height: 2rem;
		padding: 0.45rem 0.62rem;
		border: 1px solid var(--glass-control-border);
		border-radius: 0.62rem;
		background: transparent;
		color: var(--primary);
		font-size: 0.68rem;
		font-weight: 720;
		white-space: nowrap;
		transform: translateZ(14px);
		transition: background 180ms ease, border-color 180ms ease, transform 180ms ease;
	}

	.moments-random-article__refresh:hover:not(:disabled) {
		border-color: color-mix(in srgb, var(--primary) 38%, var(--line-divider));
		background: transparent;
		transform: translateY(-1px);
	}

	.moments-random-article__refresh:disabled {
		cursor: wait;
		opacity: 0.55;
	}

	/* A soft, staggered hand-off keeps the postcard feeling continuous while
	 * the RSS item and its avatar are replaced.  The card itself stays put;
	 * only the incoming layers settle into place. */
	.moments-random-article.is-switching::before {
		animation: moments-random-swap-glint 640ms ease-out both;
	}

	.moments-random-article.is-switching .moments-random-article__icon {
		animation: moments-random-swap-icon 560ms cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.moments-random-article.is-switching .moments-random-article__body {
		animation: moments-random-swap-body 600ms cubic-bezier(0.22, 1, 0.36, 1) 40ms both;
	}

	.moments-random-article.is-switching .moments-random-article__refresh {
		animation: moments-random-swap-button 520ms cubic-bezier(0.22, 1, 0.36, 1) 80ms both;
	}

	@keyframes moments-random-swap-glint {
		0% {
			opacity: 0.2;
		}
		38% {
			opacity: 1;
		}
		100% {
			opacity: 0.7;
		}
	}

	@keyframes moments-random-swap-icon {
		from {
			opacity: 0;
			transform: translate3d(-0.4rem, 0, 14px) scale(0.86);
			filter: blur(5px);
		}
		55% {
			opacity: 0.82;
		}
		to {
			opacity: 1;
			transform: translateZ(14px) scale(1);
			filter: blur(0);
		}
	}

	@keyframes moments-random-swap-body {
		from {
			opacity: 0;
			transform: translate3d(0, 0.45rem, 14px) scale(0.985);
			filter: blur(5px);
		}
		55% {
			opacity: 0.76;
		}
		to {
			opacity: 1;
			transform: translateZ(14px) scale(1);
			filter: blur(0);
		}
	}

	@keyframes moments-random-swap-button {
		from {
			opacity: 0;
			transform: translate3d(0.35rem, 0, 14px) scale(0.92);
			filter: blur(3px);
		}
		to {
			opacity: 1;
			transform: translateZ(14px) scale(1);
			filter: blur(0);
		}
	}

	@keyframes moments-random-countdown {
		0%,
		100% {
			opacity: 0.34;
			transform: translate(-50%, -50%) scale(0.9);
		}
		50% {
			opacity: 0.52;
			transform: translate(-50%, -50%) scale(1);
		}
	}

	@keyframes moments-random-border-beam {
		from {
			--moments-beam-angle: 0deg;
		}
		to {
			--moments-beam-angle: 360deg;
		}
	}

	@keyframes moments-random-noise-shift {
		0%,
		100% {
			transform: translate3d(0, 0, 0) scale(1);
		}
		33% {
			transform: translate3d(-0.8%, 0.45%, 0) scale(1.012);
		}
		66% {
			transform: translate3d(0.6%, -0.35%, 0) scale(0.996);
		}
	}

	@keyframes moments-random-sheen-sweep {
		0%,
		18% {
			transform: translate3d(-16%, 0, 0) rotate(-3deg);
			opacity: 0;
		}
		42% {
			opacity: 0.42;
		}
		68%,
		100% {
			transform: translate3d(16%, 0, 0) rotate(-3deg);
			opacity: 0;
		}
	}

	.moments-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
	}

	.moments-pagination {
		display: none;
		align-items: center;
		justify-content: center;
		gap: 0.75rem;
		margin-top: 0.25rem;
	}

	.moments-pagination.is-visible {
		display: flex;
	}

	.moments-pagination button,
	.moments-pagination > span {
		display: inline-flex;
		min-height: 2.25rem;
		align-items: center;
		justify-content: center;
		gap: 0.25rem;
		border: 1px solid color-mix(in srgb, var(--primary) 18%, var(--line-divider));
		border-radius: 0.75rem;
		background: color-mix(in srgb, var(--card-bg) 90%, transparent);
		color: var(--content-meta);
		font-size: 0.8rem;
		line-height: 1;
	}

	.moments-pagination button {
		padding: 0.55rem 0.75rem;
		cursor: pointer;
		transition: border-color 180ms ease, background-color 180ms ease, color 180ms ease, opacity 180ms ease;
	}

	.moments-pagination button:hover:not(:disabled),
	.moments-pagination button:focus-visible {
		border-color: var(--primary);
		background: color-mix(in srgb, var(--primary) 10%, var(--card-bg));
		color: var(--primary);
		outline: none;
	}

	.moments-pagination button:disabled {
		cursor: not-allowed;
		opacity: 0.42;
	}

	.moments-pagination > span {
		padding: 0 0.85rem;
		color: var(--primary);
		font-weight: 650;
		white-space: nowrap;
	}

	.moments-page-jump {
		display: inline-flex;
		min-height: 2.25rem;
		align-items: center;
		gap: 0.35rem;
		padding: 0.22rem 0.35rem 0.22rem 0.65rem;
		border: 1px solid color-mix(in srgb, var(--primary) 18%, var(--line-divider));
		border-radius: 0.75rem;
		background: color-mix(in srgb, var(--card-bg) 90%, transparent);
		color: var(--content-meta);
		font-size: 0.78rem;
		line-height: 1;
	}

	.moments-page-jump label {
		white-space: nowrap;
	}

	.moments-page-jump input {
		width: 3.15rem;
		min-height: 1.8rem;
		padding: 0.25rem 0.3rem;
		border: 1px solid color-mix(in srgb, var(--primary) 22%, var(--line-divider));
		border-radius: 0.5rem;
		background: var(--card-bg);
		color: var(--primary);
		font: inherit;
		font-variant-numeric: tabular-nums;
		text-align: center;
		outline: none;
	}

	.moments-page-jump input::placeholder {
		color: color-mix(in srgb, var(--content-meta) 78%, transparent);
	}

	.moments-page-jump input:focus-visible {
		border-color: var(--primary);
		box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary) 16%, transparent);
	}

	.moments-page-jump input::-webkit-outer-spin-button,
	.moments-page-jump input::-webkit-inner-spin-button {
		margin: 0;
		-webkit-appearance: none;
	}

	.moments-page-jump button {
		min-height: 1.8rem;
		padding: 0.35rem 0.55rem;
		border: 0;
		border-radius: 0.5rem;
		background: color-mix(in srgb, var(--primary) 12%, var(--card-bg));
		color: var(--primary);
		font: inherit;
		cursor: pointer;
	}

	.moments-page-jump button:hover,
	.moments-page-jump button:focus-visible {
		border-color: transparent;
		background: var(--primary);
		color: #fff;
		outline: none;
	}

	.moment-card {
		position: relative;
		isolation: isolate;
		contain: paint;
		display: flex;
		align-items: flex-start;
		gap: 0.75rem;
		min-width: 0;
		padding: 0.85rem;
		border: 1px solid var(--line-divider);
		border-radius: 0.9rem;
		background: var(--card-bg);
		color: inherit;
		text-decoration: none;
		transition:
			border-color 220ms ease,
			box-shadow 220ms ease,
			background-color 220ms ease;
	}

	.moment-card:hover,
	.moment-card:focus-visible {
		border-color: color-mix(in srgb, var(--primary) 58%, var(--line-divider));
		background: color-mix(in srgb, var(--card-bg) 96%, var(--primary));
		box-shadow: 0 0.8rem 1.8rem color-mix(in srgb, var(--primary) 12%, transparent);
	}

	.moment-card:focus-visible {
		outline: 2px solid color-mix(in srgb, var(--primary) 72%, white);
		outline-offset: 3px;
	}

	.moment-card--recommended {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		border-color: color-mix(in srgb, #e9bd51 42%, var(--line-divider));
		background: color-mix(in srgb, #fff1b8 48%, var(--card-bg));
		box-shadow: 0 0.28rem 0.9rem color-mix(in srgb, #e7b83e 14%, transparent);
	}

	.moment-card--recommended:hover,
	.moment-card--recommended:focus-visible {
		border-color: color-mix(in srgb, #dfa92e 62%, var(--line-divider));
		background: color-mix(in srgb, #fff5c6 82%, var(--card-bg));
		box-shadow: 0 0.45rem 1.15rem color-mix(in srgb, #e7b83e 20%, transparent);
	}

	.moment-card--own {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		border-color: color-mix(in srgb, #1dbde8 34%, var(--line-divider));
		background: color-mix(in srgb, #dff5ff 54%, var(--card-bg));
		box-shadow: 0 0.28rem 0.9rem color-mix(in srgb, #1dbde8 12%, transparent);
	}

	.moment-card--own:hover,
	.moment-card--own:focus-visible {
		border-color: color-mix(in srgb, #1dbde8 58%, var(--line-divider));
		background: color-mix(in srgb, #d2f1ff 68%, var(--card-bg));
		box-shadow: 0 0.45rem 1.15rem color-mix(in srgb, #1dbde8 18%, transparent);
	}

	.moment-card--recommended > *:not(.moment-flow),
	.moment-card--own > *:not(.moment-flow) {
		position: relative;
		z-index: 2;
	}

	.moment-card--recommended {
		--moment-flow-start: #fff0a8;
		--moment-flow-blue: #ffe5a0;
		--moment-flow-purple: #fff1ba;
		--moment-flow-pink: #fff9e2;
		--moment-flow-end: #ffe7a2;
		background: color-mix(in srgb, #fff9df 78%, var(--card-bg));
	}

	.moment-card--own {
		--moment-flow-start: #a9dcff;
		--moment-flow-blue: #c8ebff;
		--moment-flow-purple: #e1f4ff;
		--moment-flow-pink: #f3fbff;
		--moment-flow-end: #8ed0ff;
		background: color-mix(in srgb, #effaff 78%, var(--card-bg));
	}

	.moment-card--recommended .moment-avatar {
		border: 2px solid #f0bd32;
		background: #fff3b8;
		box-shadow:
			0 0 0 3px color-mix(in srgb, #f7d66b 34%, transparent),
			0 0.35rem 0.9rem color-mix(in srgb, #e5ae22 24%, transparent);
	}

	.moment-flow {
		position: absolute !important;
		inset: 0;
		z-index: 1 !important;
		overflow: hidden;
		border-radius: inherit;
		pointer-events: none;
		isolation: isolate;
		opacity: 0.46;
		background:
			linear-gradient(
				100deg,
				var(--moment-flow-start) 0%,
				color-mix(in srgb, var(--moment-flow-start) 62%, var(--moment-flow-blue)) 19%,
				var(--moment-flow-purple) 42%,
				color-mix(in srgb, var(--moment-flow-purple) 78%, var(--moment-flow-pink)) 65%,
				var(--moment-flow-pink) 84%,
				var(--moment-flow-end) 100%
			);
		background-size: 240% 100%;
		box-shadow:
			inset 0 1px 1px rgba(255, 255, 255, 0.19),
			inset 0 -1px 1px rgba(50, 20, 120, 0.16),
			0 1px 3px color-mix(in srgb, var(--moment-flow-start) 14%, transparent);
		animation: moment-flow-base 4.8s ease-in-out infinite alternate;
	}

	.moment-card--recommended .moment-flow {
		opacity: 0.62;
		background: linear-gradient(
			100deg,
			#ffe18a 0%,
			#ffedac 19%,
			#fff4c8 42%,
			#fffbe6 65%,
			#ffffff 84%,
			#ffe39b 100%
		);
		background-size: 360% 100%;
		background-position: 0% 50%;
		animation: moment-flow-base 4.2s ease-in-out infinite alternate;
	}

	.moment-card--own .moment-flow {
		opacity: 0.58;
		background: linear-gradient(
			100deg,
			#94d5ff 0%,
			#b5e5ff 19%,
			#dbf3ff 42%,
			#f4fbff 65%,
			#ffffff 84%,
			#a0ddff 100%
		);
		background-size: 360% 100%;
		background-position: 0% 50%;
		animation: moment-flow-base 4.2s ease-in-out infinite alternate;
	}

	.moment-card--recommended .moment-flow::before {
		background:
			radial-gradient(
				ellipse at 18% 48%,
				rgba(255, 209, 67, 0.55) 0 6%,
				rgba(255, 221, 109, 0.22) 17%,
				transparent 37%
			),
			radial-gradient(
				ellipse at 49% 45%,
				rgba(255, 231, 142, 0.76) 0 7%,
				rgba(255, 222, 110, 0.28) 20%,
				transparent 42%
			),
			radial-gradient(
				ellipse at 77% 52%,
				rgba(255, 244, 194, 0.68) 0 7%,
				rgba(255, 235, 159, 0.24) 22%,
				transparent 42%
			);
	}

	.moment-card--own .moment-flow::before {
		background:
			radial-gradient(
				ellipse at 18% 48%,
				rgba(82, 184, 255, 0.55) 0 6%,
				rgba(82, 184, 255, 0.22) 17%,
				transparent 37%
			),
			radial-gradient(
				ellipse at 49% 45%,
				rgba(180, 210, 255, 0.76) 0 7%,
				rgba(175, 205, 255, 0.28) 20%,
				transparent 42%
			),
			radial-gradient(
				ellipse at 77% 52%,
				rgba(183, 235, 255, 0.58) 0 7%,
				rgba(151, 220, 255, 0.22) 22%,
				transparent 42%
			);
	}

	.moment-flow::before {
		position: absolute;
		inset: -70% -45%;
		content: "";
		background:
			radial-gradient(
				ellipse at 18% 48%,
				color-mix(in srgb, var(--moment-flow-blue) 72%, white) 0 6%,
				color-mix(in srgb, var(--moment-flow-blue) 38%, transparent) 17%,
				transparent 37%
			),
			radial-gradient(
				ellipse at 49% 45%,
				color-mix(in srgb, var(--moment-flow-purple) 76%, white) 0 7%,
				color-mix(in srgb, var(--moment-flow-purple) 35%, transparent) 20%,
				transparent 42%
			),
			radial-gradient(
				ellipse at 77% 52%,
				color-mix(in srgb, var(--moment-flow-pink) 70%, white) 0 7%,
				color-mix(in srgb, var(--moment-flow-pink) 31%, transparent) 22%,
				transparent 42%
			);
		filter: blur(9px) saturate(1.22);
		transform: translate3d(-12%, 0, 0) scale(1.08);
		mix-blend-mode: screen;
		animation: moment-flow-aurora 3.6s cubic-bezier(0.45, 0, 0.55, 1) infinite alternate;
	}

	.moment-flow::after {
		position: absolute;
		top: -60%;
		bottom: -60%;
		left: -58%;
		width: 58%;
		content: "";
		background: linear-gradient(
			105deg,
			transparent 0%,
			rgba(255, 255, 255, 0.03) 23%,
				rgba(255, 255, 255, 0.1) 43%,
				rgba(255, 255, 255, 0.24) 50%,
				rgba(255, 255, 255, 0.1) 59%,
			transparent 78%
		);
		filter: blur(7px);
		transform: skewX(-14deg);
		mix-blend-mode: screen;
		animation: moment-flow-shimmer 4.2s cubic-bezier(0.38, 0.05, 0.25, 1) infinite;
	}

	.moment-flow-silk {
		position: absolute;
		top: 3px;
		left: -45%;
		z-index: 2;
		width: 46%;
		height: 22px;
		border-radius: 50%;
		background: radial-gradient(
			ellipse at center,
			rgba(255, 255, 255, 0.3) 0%,
			rgba(210, 219, 255, 0.15) 25%,
			transparent 68%
		);
		filter: blur(4px);
		mix-blend-mode: screen;
		opacity: 0.75;
		animation: moment-flow-silk-move 4.1s ease-in-out infinite;
	}

	.moment-flow-stars {
		position: absolute;
		inset: 0;
		z-index: 3;
		width: 100%;
		height: 100%;
		border-radius: inherit;
		pointer-events: none;
	}

	@keyframes moment-flow-base {
		0% { background-position: 0% 50%; }
		100% { background-position: 100% 50%; }
	}

	@keyframes moment-flow-aurora {
		0% { transform: translate3d(-14%, -2%, 0) scale(1.08) rotate(-2deg); }
		55% { transform: translate3d(4%, 2%, 0) scale(1.16) rotate(1deg); }
		100% { transform: translate3d(16%, -1%, 0) scale(1.1) rotate(-1deg); }
	}

	@keyframes moment-flow-shimmer {
		0% { left: -66%; opacity: 0; }
		13% { opacity: 0.8; }
		58% { opacity: 0.95; }
		82% { opacity: 0.55; }
		100% { left: 122%; opacity: 0; }
	}

	@keyframes moment-flow-silk-move {
		0% { left: -48%; transform: translateY(1px) scaleX(0.85); opacity: 0; }
		15% { opacity: 0.5; }
		48% { opacity: 0.83; }
		100% { left: 118%; transform: translateY(-2px) scaleX(1.18); opacity: 0; }
	}


	:global(html.dark) .moment-card--recommended {
		border-color: color-mix(in srgb, #e9bd51 32%, var(--line-divider));
		background: color-mix(in srgb, #7a5714 18%, var(--card-bg));
	}

	:global(html.dark) .moment-card--own {
		border-color: color-mix(in srgb, #1dbde8 34%, var(--line-divider));
		background: color-mix(in srgb, #11627d 18%, var(--card-bg));
	}

	:global(html.dark) .moment-card--recommended .moment-flow {
		opacity: 0.46;
		background: linear-gradient(
			100deg,
			#5b4818 0%,
			#75602a 19%,
			#9a8240 42%,
			#c3ae70 65%,
			#e3d39a 84%,
			#725a20 100%
		);
		background-size: 360% 100%;
		animation: moment-flow-base 4.2s ease-in-out infinite alternate;
	}

	:global(html.dark) .moment-card--own .moment-flow {
		opacity: 0.42;
		background: linear-gradient(
			100deg,
			#1b4c6d 0%,
			#266b91 19%,
			#438db0 42%,
			#70b8d3 65%,
			#b5e7f4 84%,
