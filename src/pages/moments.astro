---
import { Icon } from "astro-icon/components";
import { getEnabledFriends, siteConfig } from "@/config";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { formatDateToYYYYMMDD } from "@/utils/date-utils";
import { loadFriendsFeed } from "@/utils/friends-feed";

const friends = getEnabledFriends();
const feed = await loadFriendsFeed(friends);
const title = "朋友圈";
const description = "把友链博客最近写下的文章，收进一条轻盈的时间线。";

const normalizeFriendUrl = (url: string | undefined | null) =>
	(url ?? "")
		.trim()
		.replace(/^https?:\/\//i, "")
		.replace(/^www\./i, "")
		.replace(/\/+$/, "")
		.toLowerCase();
const ownSiteUrl = normalizeFriendUrl(siteConfig.site_url);
const friendsByUrl = new Map(
	friends
		.map((friend) => [normalizeFriendUrl(friend.siteurl), friend] as const)
		.filter(([url]) => url.length > 0),
);
const subscribedFriendUrls = new Set(
	feed.sources.map((source) => normalizeFriendUrl(source.friendUrl)),
);
const unsubscribedFriends = friends.filter(
	(friend) => !subscribedFriendUrls.has(normalizeFriendUrl(friend.siteurl)),
);
const randomArticleItems = JSON.stringify(
	feed.items.map((item) => {
		const isOwnSite = normalizeFriendUrl(item.friendUrl) === ownSiteUrl;
		const isRecommended =
			!isOwnSite &&
			friendsByUrl.get(normalizeFriendUrl(item.friendUrl))?.recommended ===
				true;

		return {
			friendTitle: item.friendTitle,
			avatar: item.avatar,
			title: item.title,
			link: item.link,
			description: item.description,
			publishedAt: item.publishedAt?.toISOString() ?? null,
			role: isOwnSite ? "own" : isRecommended ? "recommended" : null,
		};
	}),
).replace(/</g, "\\u003c");
---

<MainGridLayout title={title} description={description}>
	<section class="moments-shell card-base z-10 px-9 py-6 relative w-full onload-animation" aria-labelledby="moments-title">
		<header class="moments-header">
			<div class="moments-heading">
				<div class="moments-heading-icon" aria-hidden="true">
					<Icon is:inline name="material-symbols:rss-feed-rounded" />
				</div>
				<div>
					<h1 id="moments-title">朋友圈</h1>
					<p>来自友链站点的最近更新，偶尔路过，也别忘了留下你的脚印。</p>
				</div>
			</div>
			<div class="moments-stats" aria-label="朋友圈更新统计">
				<strong>{feed.items.length}</strong>
				<span>篇更新</span>
			</div>
			<div class="moments-note">
				<Icon is:inline name="material-symbols:auto-awesome-rounded" aria-hidden="true" />
				<span>
					显示 {feed.sources.length}/{feed.checkedCount} 个友链来源（最新 {feed.freshSources} 个，沿用快照 {feed.staleSources} 个）。
				</span>
			</div>
			{unsubscribedFriends.length > 0 && (
				<p class="moments-unsubscribed" role="status">
					<Icon is:inline name="material-symbols:info-outline-rounded" aria-hidden="true" />
					<span>
						未订阅的站点：{unsubscribedFriends.map((friend) => friend.title).join("、")}，如有需要，请与本站站长联系添加 RSS/Atom
					</span>
				</p>
			)}
			<article
				class="moments-random-article"
				data-random-article
				data-items={randomArticleItems}
				data-state="loading"
				aria-label="随机一篇文章"
			>
				<svg class="moments-random-article__filters" aria-hidden="true" focusable="false" width="0" height="0">
					<defs>
						<filter id="moments-random-article-displacement" x="-12%" y="-20%" width="124%" height="140%">
							<feTurbulence type="fractalNoise" baseFrequency="0.018" numOctaves="2" seed="23" result="noise" />
							<feDisplacementMap in="SourceGraphic" in2="noise" scale="7" xChannelSelector="R" yChannelSelector="B" />
						</filter>
					</defs>
				</svg>
				<span class="moments-random-article__noise" aria-hidden="true"></span>
				<span class="moments-random-article__sheen" aria-hidden="true"></span>
				<div class="moments-random-article__icon">
					<img
						data-random-article-avatar
						alt=""
						width="40"
						height="40"
						loading="lazy"
						decoding="async"
						hidden
					/>
					<span data-random-article-avatar-fallback aria-hidden="true">
						<Icon is:inline name="material-symbols:shuffle-rounded" />
					</span>
				</div>
				<div class="moments-random-article__body">
					<div class="moments-random-article__eyebrow">
						<span>随机一篇文章</span>
						<span>随手翻翻</span>
						<span
							class="moment-identity-badge moments-random-article__badge"
							data-random-article-badge
							hidden
						></span>
					</div>
					<a
						class="moments-random-article__link"
						data-random-article-link
						href="/posts/"
						aria-label="打开随机文章"
					>
						<strong data-random-article-title>正在挑选一篇文章…</strong>
						<span data-random-article-description>从朋友圈文章里随机选一篇，换个角度继续阅读。</span>
						<span data-random-article-meta aria-hidden="true"></span>
					</a>
				</div>
				<span class="moments-random-article__countdown" data-random-article-countdown aria-hidden="true">5</span>
				<button
					type="button"
					class="moments-random-article__auto is-active"
					data-random-article-auto
					aria-pressed="true"
					aria-label="关闭自动随机"
				>
					<Icon is:inline name="material-symbols:autorenew-rounded" aria-hidden="true" />
					<span>自动随机</span>
				</button>
				<button
					type="button"
					class="moments-random-article__refresh"
					data-random-article-refresh
					aria-label="换一篇随机文章"
				>
					<Icon is:inline name="material-symbols:refresh-rounded" aria-hidden="true" />
					<span>换一篇</span>
				</button>
			</article>
		</header>

		{feed.items.length > 0 ? (
			<div class="moments-grid my-4" aria-label="友链文章更新">
				{feed.items.map((item) => {
					const isOwnSite = normalizeFriendUrl(item.friendUrl) === ownSiteUrl;
					const isRecommended = !isOwnSite && friendsByUrl.get(normalizeFriendUrl(item.friendUrl))?.recommended === true;

					return (
					<a
						href={item.link}
						target="_blank"
						rel="noopener noreferrer"
						class:list={[
							"moment-card group",
							isOwnSite && "moment-card--own",
							isRecommended && "moment-card--recommended",
						]}
						data-moment-card
						aria-label={`${item.title}，来自 ${item.friendTitle}`}
					>
						{(isOwnSite || isRecommended) && (
							<span
								class="moment-flow"
								data-moment-flow
								data-flow-tone={isRecommended ? "gold" : "blue"}
								aria-hidden="true"
							>
								<span class="moment-flow-silk"></span>
								<canvas class="moment-flow-stars"></canvas>
							</span>
						)}
						<div class="moment-avatar">
							<img src={item.avatar} alt="" width="48" height="48" loading="lazy" decoding="async" />
						</div>
						<div class="moment-content">
							<div class="moment-title-row">
								<h2>{item.title}</h2>
								<Icon is:inline name="material-symbols:arrow-outward-rounded" aria-hidden="true" />
							</div>
							<p class="moment-meta">
								<span>{item.friendTitle}</span>
								{isOwnSite && (
									<span class="moment-identity-badge moment-identity-badge--own">
										<Icon is:inline name="material-symbols:home-rounded" aria-hidden="true" />
										本站主理人
									</span>
								)}
								{isRecommended && (
									<span class="moment-identity-badge moment-identity-badge--recommended">
										<Icon is:inline name="material-symbols:star-rounded" aria-hidden="true" />
										推荐友链
									</span>
								)}
								<span aria-hidden="true">·</span>
								<time datetime={item.publishedAt?.toISOString()}>
									{item.publishedAt ? formatDateToYYYYMMDD(item.publishedAt) : "最近更新"}
								</time>
							</p>
							{item.description && <p class="moment-description">{item.description}</p>}
						</div>
					</a>
					);
				})}
			</div>
			<nav class="moments-pagination" data-moments-pagination aria-label="朋友圈分页">
				<button type="button" data-moments-page="prev" aria-label="上一页">
					<Icon is:inline name="material-symbols:chevron-left-rounded" aria-hidden="true" />
					<span>上一页</span>
				</button>
				<span data-moments-page-indicator aria-live="polite">第 1 / 1 页</span>
				<form class="moments-page-jump" data-moments-page-jump-form aria-label="跳转到朋友圈页">
					<label for="moments-page-jump-input">跳转至</label>
					<input
						id="moments-page-jump-input"
						data-moments-page-jump-input
						type="number"
						min="1"
						inputmode="numeric"
						aria-label="页码"
						placeholder="页码"
					/>
					<span aria-hidden="true">页</span>
					<button type="submit">前往</button>
				</form>
				<button type="button" data-moments-page="next" aria-label="下一页">
					<span>下一页</span>
					<Icon is:inline name="material-symbols:chevron-right-rounded" aria-hidden="true" />
				</button>
			</nav>
		) : (
			<div class="moments-empty card-base">
				<Icon is:inline name="material-symbols:rss-feed-rounded" aria-hidden="true" />
				<h2>暂时还没有读到更新</h2>
				<p>友链站点可能暂未提供 RSS / Atom，下一次构建时会再次尝试探测。</p>
			</div>
		)}
	</section>

<script is:inline>
	(() => {
		const runtimeKey = "__rainztMomentsRuntime";
		const runtime = window[runtimeKey] || {
			activeShell: null,
			cleanup: null,
			init: null,
			eventsBound: false,
			hooksBound: false,
			scheduledFrame: 0,
		};

		const clearActiveRuntime = () => {
			if (typeof runtime.cleanup === "function") runtime.cleanup();
			runtime.cleanup = null;
			runtime.activeShell = null;
		};

		const initMomentsPage = () => {
			const shell = document.querySelector(".moments-shell");
			if (!shell) {
				clearActiveRuntime();
				return;
			}
			if (runtime.activeShell === shell) return;

			clearActiveRuntime();
			runtime.activeShell = shell;
			const cleanups = [];
			runtime.cleanup = () => {
				for (const cleanup of cleanups.splice(0)) cleanup();
				runtime.activeShell = null;
			};

			const randomArticleCard = shell.querySelector("[data-random-article]");
			if (randomArticleCard instanceof HTMLElement) {
				const rawItems = randomArticleCard.dataset.items || "[]";
				const articleLink = randomArticleCard.querySelector("[data-random-article-link]");
				const articleTitle = randomArticleCard.querySelector("[data-random-article-title]");
				const articleDescription = randomArticleCard.querySelector("[data-random-article-description]");
				const articleMeta = randomArticleCard.querySelector("[data-random-article-meta]");
				const articleBadge = randomArticleCard.querySelector("[data-random-article-badge]");
				const articleAvatar = randomArticleCard.querySelector("[data-random-article-avatar]");
				const articleAvatarFallback = randomArticleCard.querySelector("[data-random-article-avatar-fallback]");
				const articleCountdown = randomArticleCard.querySelector("[data-random-article-countdown]");
				const autoRandomButton = randomArticleCard.querySelector("[data-random-article-auto]");
				const refreshButton = randomArticleCard.querySelector("[data-random-article-refresh]");
				let candidates = [];
				let lastArticleLink = "";
				let autoRandomEnabled = true;
				let secondsUntilRandom = 5;
				let randomSwapTimer = 0;

				const reducedMotion = window.matchMedia?.("(prefers-reduced-motion: reduce)").matches ?? false;
				const finePointer = window.matchMedia?.("(hover: hover) and (pointer: fine)").matches ?? false;
				if (!reducedMotion && finePointer) {
					let tiltFrame = 0;
					let targetTiltX = 0;
					let targetTiltY = 0;
					let currentTiltX = 0;
					let currentTiltY = 0;
					let tiltVelocityX = 0;
					let tiltVelocityY = 0;

					const animateTilt = () => {
						const stiffness = 0.105;
						const damping = 0.74;
						tiltVelocityX = (tiltVelocityX + (targetTiltX - currentTiltX) * stiffness) * damping;
						tiltVelocityY = (tiltVelocityY + (targetTiltY - currentTiltY) * stiffness) * damping;
						currentTiltX += tiltVelocityX;
						currentTiltY += tiltVelocityY;
						randomArticleCard.style.setProperty("--tilt-x", `${currentTiltX.toFixed(3)}deg`);
						randomArticleCard.style.setProperty("--tilt-y", `${currentTiltY.toFixed(3)}deg`);

						const settled =
							Math.abs(targetTiltX - currentTiltX) < 0.01 &&
							Math.abs(targetTiltY - currentTiltY) < 0.01 &&
							Math.abs(tiltVelocityX) < 0.01 &&
							Math.abs(tiltVelocityY) < 0.01;
						if (settled && targetTiltX === 0 && targetTiltY === 0) {
							currentTiltX = 0;
							currentTiltY = 0;
							randomArticleCard.style.setProperty("--tilt-x", "0deg");
							randomArticleCard.style.setProperty("--tilt-y", "0deg");
							tiltFrame = 0;
							return;
						}
						tiltFrame = window.requestAnimationFrame(animateTilt);
					};

					const requestTiltFrame = () => {
						if (!tiltFrame) tiltFrame = window.requestAnimationFrame(animateTilt);
					};

					const handlePointerEnter = () => {
						randomArticleCard.dataset.tiltActive = "true";
						requestTiltFrame();
					};

					const handlePointerMove = (event) => {
						if (event.pointerType === "touch") return;
						const rect = randomArticleCard.getBoundingClientRect();
						const x = Math.max(0, Math.min(1, (event.clientX - rect.left) / rect.width));
						const y = Math.max(0, Math.min(1, (event.clientY - rect.top) / rect.height));
						randomArticleCard.style.setProperty("--pointer-x", `${(x * 100).toFixed(2)}%`);
						randomArticleCard.style.setProperty("--pointer-y", `${(y * 100).toFixed(2)}%`);
						targetTiltX = (0.5 - y) * 5.5;
						targetTiltY = (x - 0.5) * 5.5;
						requestTiltFrame();
					};

					const handlePointerLeave = () => {
						targetTiltX = 0;
						targetTiltY = 0;
						randomArticleCard.dataset.tiltActive = "false";
						randomArticleCard.style.setProperty("--pointer-x", "50%");
						randomArticleCard.style.setProperty("--pointer-y", "50%");
						requestTiltFrame();
					};

					randomArticleCard.addEventListener("pointerenter", handlePointerEnter);
					randomArticleCard.addEventListener("pointermove", handlePointerMove);
					randomArticleCard.addEventListener("pointerleave", handlePointerLeave);
					cleanups.push(() => {
						randomArticleCard.removeEventListener("pointerenter", handlePointerEnter);
						randomArticleCard.removeEventListener("pointermove", handlePointerMove);
						randomArticleCard.removeEventListener("pointerleave", handlePointerLeave);
						if (tiltFrame) window.cancelAnimationFrame(tiltFrame);
						randomArticleCard.style.removeProperty("--tilt-x");
						randomArticleCard.style.removeProperty("--tilt-y");
						randomArticleCard.style.removeProperty("--pointer-x");
						randomArticleCard.style.removeProperty("--pointer-y");
					});
				}

				const setRandomArticleState = (state) => {
					randomArticleCard.dataset.state = state;
					if (refreshButton instanceof HTMLButtonElement) refreshButton.disabled = false;
				};

				const updateRandomCountdown = () => {
					if (!(articleCountdown instanceof HTMLElement)) return;
					articleCountdown.textContent = autoRandomEnabled ? String(secondsUntilRandom) : "";
					articleCountdown.dataset.auto = autoRandomEnabled ? "true" : "false";
				};

				const setAutoRandomState = (enabled) => {
					autoRandomEnabled = enabled;
					secondsUntilRandom = 5;
					if (autoRandomButton instanceof HTMLButtonElement) {
						autoRandomButton.classList.toggle("is-active", enabled);
						autoRandomButton.setAttribute("aria-pressed", String(enabled));
						autoRandomButton.setAttribute("aria-label", enabled ? "关闭自动随机" : "开启自动随机");
					}
					updateRandomCountdown();
				};

				const playRandomArticleSwap = () => {
					if (reducedMotion) return;
					randomArticleCard.classList.remove("is-switching");
					void randomArticleCard.offsetWidth;
					randomArticleCard.classList.add("is-switching");
					if (randomSwapTimer) window.clearTimeout(randomSwapTimer);
					randomSwapTimer = window.setTimeout(() => {
						randomArticleCard.classList.remove("is-switching");
						randomSwapTimer = 0;
					}, 640);
				};
				cleanups.push(() => {
					if (randomSwapTimer) window.clearTimeout(randomSwapTimer);
					randomSwapTimer = 0;
					randomArticleCard.classList.remove("is-switching");
				});

				const showRandomArticleAvatarFallback = () => {
					if (articleAvatar instanceof HTMLImageElement) {
						articleAvatar.hidden = true;
						articleAvatar.removeAttribute("src");
					}
					if (articleAvatarFallback instanceof HTMLElement) articleAvatarFallback.hidden = false;
				};

				const handleRandomArticleAvatarError = () => showRandomArticleAvatarFallback();
				if (articleAvatar instanceof HTMLImageElement) {
					articleAvatar.addEventListener("error", handleRandomArticleAvatarError);
					cleanups.push(() => articleAvatar.removeEventListener("error", handleRandomArticleAvatarError));
				}

				const renderRandomArticle = () => {
					if (!(articleLink instanceof HTMLAnchorElement) || !(articleTitle instanceof HTMLElement)) return;
					if (candidates.length === 0) {
						setRandomArticleState("empty");
						secondsUntilRandom = 0;
						updateRandomCountdown();
						randomArticleCard.classList.remove("moments-random-article--own", "moments-random-article--recommended");
						articleLink.removeAttribute("href");
						articleLink.setAttribute("aria-disabled", "true");
						articleTitle.textContent = "暂时没有可推荐的文章";
						if (articleDescription) articleDescription.textContent = "朋友圈暂时没有可读取的更新，请稍后再试。";
						if (articleMeta) articleMeta.textContent = "";
						showRandomArticleAvatarFallback();
						if (articleBadge instanceof HTMLElement) {
							articleBadge.hidden = true;
							articleBadge.textContent = "";
							articleBadge.classList.remove("moment-identity-badge--own", "moment-identity-badge--recommended");
						}
						playRandomArticleSwap();
						return;
					}

					const ownArticles = candidates.filter((item) => item.role === "own");
					const otherArticles = candidates.filter((item) => item.role !== "own");
					const preferredPool = Math.random() < 0.2 ? ownArticles : otherArticles;
					const categoryPool = preferredPool.length > 0 ? preferredPool : candidates;
					const available = categoryPool.filter((item) => item.link !== lastArticleLink);
					const pool = available.length > 0 ? available : categoryPool;
					const picked = pool[Math.floor(Math.random() * pool.length)];
					lastArticleLink = picked.link;
					articleLink.href = picked.link;
					articleLink.removeAttribute("aria-disabled");
					articleLink.setAttribute("aria-label", `阅读随机文章：${picked.title}`);
					articleTitle.textContent = picked.title || "随机文章";
					if (articleAvatar instanceof HTMLImageElement && typeof picked.avatar === "string" && picked.avatar.length > 0) {
						articleAvatar.src = picked.avatar;
						articleAvatar.alt = `${picked.friendTitle || "友链站点"}头像`;
						articleAvatar.hidden = false;
						if (articleAvatarFallback instanceof HTMLElement) articleAvatarFallback.hidden = true;
					} else {
						showRandomArticleAvatarFallback();
					}
					if (articleDescription) {
						articleDescription.textContent = picked.description || "打开这篇友链文章，看看今天会遇见什么。";
					}
					if (articleMeta) {
						const published = picked.publishedAt
							? new Date(picked.publishedAt).toLocaleDateString("zh-CN", { year: "numeric", month: "2-digit", day: "2-digit" })
							: "最近更新";
						articleMeta.textContent = `${picked.friendTitle || "友链文章"} · ${published}`;
					}
					if (articleBadge instanceof HTMLElement) {
						const role = picked.role === "own" || picked.role === "recommended" ? picked.role : "";
						randomArticleCard.classList.remove("moments-random-article--own", "moments-random-article--recommended");
						if (role !== "") randomArticleCard.classList.add(`moments-random-article--${role}`);
						articleBadge.hidden = role === "";
						articleBadge.classList.remove("moment-identity-badge--own", "moment-identity-badge--recommended");
						if (role !== "") {
							articleBadge.classList.add(`moment-identity-badge--${role}`);
							articleBadge.textContent = role === "own" ? "本站主理人" : "推荐友链";
						}
					} else {
						randomArticleCard.classList.remove("moments-random-article--own", "moments-random-article--recommended");
						if (picked.role === "own" || picked.role === "recommended") {
							randomArticleCard.classList.add(`moments-random-article--${picked.role}`);
						}
					}
					setRandomArticleState("ready");
					if (autoRandomEnabled) {
						secondsUntilRandom = 5;
						updateRandomCountdown();
					}
					playRandomArticleSwap();
				};

				const loadRandomArticles = () => {
					try {
						const data = JSON.parse(rawItems);
						candidates = Array.isArray(data)
							? data.filter((item) => item && typeof item.title === "string" && item.link)
							: [];
					} catch {
						candidates = [];
					}
					renderRandomArticle();
				};

				const handleRandomArticleRefresh = () => {
					if (candidates.length > 0) renderRandomArticle();
					else loadRandomArticles();
				};

				const handleAutoRandomToggle = () => setAutoRandomState(!autoRandomEnabled);

				refreshButton?.addEventListener("click", handleRandomArticleRefresh);
				cleanups.push(() => refreshButton?.removeEventListener("click", handleRandomArticleRefresh));
				autoRandomButton?.addEventListener("click", handleAutoRandomToggle);
				cleanups.push(() => autoRandomButton?.removeEventListener("click", handleAutoRandomToggle));
				loadRandomArticles();
				const randomArticleTimer = window.setInterval(() => {
					if (!autoRandomEnabled || candidates.length < 2) return;
					if (secondsUntilRandom <= 1) {
						renderRandomArticle();
						return;
					}
					secondsUntilRandom -= 1;
					updateRandomCountdown();
				}, 1000);
				cleanups.push(() => window.clearInterval(randomArticleTimer));
			}

			const momentsPageSize = 20;
			const momentsCards = Array.from(shell.querySelectorAll("[data-moment-card]"));
			const momentsPagination = shell.querySelector("[data-moments-pagination]");

			if (momentsCards.length > 0 && momentsPagination) {
				const momentsIndicator = momentsPagination.querySelector("[data-moments-page-indicator]");
				const momentsPrev = momentsPagination.querySelector("[data-moments-page='prev']");
				const momentsNext = momentsPagination.querySelector("[data-moments-page='next']");
				const momentsJumpForm = momentsPagination.querySelector("[data-moments-page-jump-form]");
				const momentsJumpInput = momentsPagination.querySelector("[data-moments-page-jump-input]");
				const momentsTotalPages = Math.max(1, Math.ceil(momentsCards.length / momentsPageSize));
				const getMomentsPage = () => {
					const value = Number.parseInt(new URL(window.location.href).searchParams.get("page") || "1", 10);
					return Number.isFinite(value) && value > 0 ? Math.min(value, momentsTotalPages) : 1;
				};
				let momentsCurrentPage = getMomentsPage();

				const updateMomentsUrl = () => {
					const nextUrl = new URL(window.location.href);
					if (momentsCurrentPage === 1) nextUrl.searchParams.delete("page");
					else nextUrl.searchParams.set("page", String(momentsCurrentPage));
					window.history.pushState(null, "", `${nextUrl.pathname}${nextUrl.search}${nextUrl.hash}`);
				};

				const renderMomentsPage = () => {
					const start = (momentsCurrentPage - 1) * momentsPageSize;
					momentsCards.forEach((card, index) => {
						card.hidden = index < start || index >= start + momentsPageSize;
					});
					momentsPagination.classList.toggle("is-visible", momentsTotalPages > 1);
					if (momentsIndicator) {
						momentsIndicator.textContent = `第 ${momentsCurrentPage} / ${momentsTotalPages} 页 · 共 ${momentsCards.length} 篇`;
					}
					if (momentsJumpInput instanceof HTMLInputElement) {
						momentsJumpInput.max = String(momentsTotalPages);
						momentsJumpInput.placeholder = String(momentsCurrentPage);
						momentsJumpInput.setAttribute("aria-valuemax", String(momentsTotalPages));
						momentsJumpInput.setAttribute("aria-valuenow", String(momentsCurrentPage));
					}
					if (momentsPrev) {
						momentsPrev.disabled = momentsCurrentPage === 1;
						momentsPrev.setAttribute("aria-disabled", String(momentsPrev.disabled));
					}
					if (momentsNext) {
						momentsNext.disabled = momentsCurrentPage === momentsTotalPages;
						momentsNext.setAttribute("aria-disabled", String(momentsNext.disabled));
					}
				};

				const goToMomentsPage = (page) => {
					momentsCurrentPage = Math.min(Math.max(page, 1), momentsTotalPages);
					updateMomentsUrl();
					renderMomentsPage();
					shell.querySelector(".moments-header")?.scrollIntoView({ behavior: "smooth", block: "start" });
				};

				const handlePaginationClick = (event) => {
					const button = event.target instanceof Element
						? event.target.closest("button[data-moments-page]")
						: null;
					if (!button || button.disabled) return;
					goToMomentsPage(momentsCurrentPage + (button.dataset.momentsPage === "next" ? 1 : -1));
				};
				const handleJumpSubmit = (event) => {
					event.preventDefault();
					if (!(momentsJumpInput instanceof HTMLInputElement)) return;
					const value = Number.parseInt(momentsJumpInput.value, 10);
					if (!Number.isFinite(value)) {
						momentsJumpInput.focus();
						return;
					}
					momentsJumpInput.value = "";
					goToMomentsPage(value);
				};
				const handlePopState = () => {
					momentsCurrentPage = getMomentsPage();
					renderMomentsPage();
				};

				momentsPagination.addEventListener("click", handlePaginationClick);
				momentsJumpForm?.addEventListener("submit", handleJumpSubmit);
				window.addEventListener("popstate", handlePopState);
				cleanups.push(() => {
					momentsPagination.removeEventListener("click", handlePaginationClick);
					momentsJumpForm?.removeEventListener("submit", handleJumpSubmit);
					window.removeEventListener("popstate", handlePopState);
				});

				renderMomentsPage();
			}

			const momentFlowHosts = Array.from(shell.querySelectorAll("[data-moment-flow]"));
			const momentFlowReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

			for (const host of momentFlowHosts) {
				const canvas = host.querySelector(".moment-flow-stars");
				const context = canvas instanceof HTMLCanvasElement ? canvas.getContext("2d") : null;
				if (!(canvas instanceof HTMLCanvasElement) || !context) continue;

				let dpr = Math.min(window.devicePixelRatio || 1, 2);
				let width = 0;
				let height = 0;
				let particles = [];
				let last = performance.now();
				let animationFrame = 0;
				let resizeObserver = null;
				let stopped = false;
				const particleCount = 32;
				const tone = host.dataset.flowTone === "gold"
					? { core: "255,176,0", glow: "255,225,92" }
					: { core: "32,143,232", glow: "151,220,255" };

				const drawRoundedStar = (x, y, outerRadius, innerRadius, rotation) => {
					const points = Array.from({ length: 10 }, (_, index) => {
						const angle = rotation + (Math.PI * index) / 5;
						const radius = index % 2 === 0 ? outerRadius : innerRadius;
						return { x: x + Math.cos(angle) * radius, y: y + Math.sin(angle) * radius };
					});
					context.beginPath();
					for (let index = 0; index < points.length; index += 1) {
						const previous = points[(index + points.length - 1) % points.length];
						const current = points[index];
						const next = points[(index + 1) % points.length];
						const startX = (previous.x + current.x) / 2;
						const startY = (previous.y + current.y) / 2;
						const endX = (current.x + next.x) / 2;
						const endY = (current.y + next.y) / 2;
						if (index === 0) context.moveTo(startX, startY);
						context.quadraticCurveTo(current.x, current.y, endX, endY);
					}
					context.closePath();
					context.fill();
				};

				const createParticle = () => ({
					x: Math.random() * Math.max(width - 20, 1),
					y: 4 + Math.random() * Math.max(height - 8, 1),
					r: Math.random() < 0.26 ? 2.2 + Math.random() * 1.2 : 1.15 + Math.random() * 1.15,
					speed: 0.08 + Math.random() * 0.2,
					alpha: 0.26 + Math.random() * 0.44,
					pulse: Math.random() * Math.PI * 2,
					pulseSpeed: 0.012 + Math.random() * 0.02,
					rotation: -Math.PI / 2 + (Math.random() - 0.5) * 0.2,
					streak: Math.random() < 0.1,
				});

				const resize = () => {
					if (stopped || !host.isConnected) return;
					const rect = host.getBoundingClientRect();
					width = rect.width;
					height = rect.height;
					if (!width || !height) return;
					dpr = Math.min(window.devicePixelRatio || 1, 2);
					canvas.width = Math.round(width * dpr);
					canvas.height = Math.round(height * dpr);
					canvas.style.width = `${width}px`;
					canvas.style.height = `${height}px`;
					context.setTransform(dpr, 0, 0, dpr, 0, 0);
					particles = Array.from({ length: particleCount }, createParticle);
				};

				const draw = (now) => {
					if (stopped || !host.isConnected) return;
					if (!width || !height) {
						if (!momentFlowReducedMotion) animationFrame = requestAnimationFrame(draw);
						return;
					}
					const dt = Math.min(32, now - last);
					last = now;
					context.clearRect(0, 0, width, height);
					const endX = width - 5;

					for (const particle of particles) {
						if (!momentFlowReducedMotion) particle.x += particle.speed * dt;
						if (particle.x > endX) {
							particle.x = -4 - Math.random() * 24;
							particle.y = 4 + Math.random() * Math.max(height - 8, 1);
						}
						if (!momentFlowReducedMotion) particle.pulse += particle.pulseSpeed * dt;

						const twinkle = 0.68 + 0.32 * Math.sin(particle.pulse);
						const alpha = particle.alpha * twinkle;

						if (particle.streak) {
							const streak = context.createLinearGradient(particle.x - 8, particle.y, particle.x + 2, particle.y);
							streak.addColorStop(0, `rgba(${tone.core},0)`);
							streak.addColorStop(1, `rgba(${tone.core},${alpha * 0.7})`);
							context.strokeStyle = streak;
							context.lineWidth = 0.8;
							context.beginPath();
							context.moveTo(particle.x - 8, particle.y);
							context.lineTo(particle.x + 1, particle.y);
							context.stroke();
						}

						const glow = context.createRadialGradient(
							particle.x,
							particle.y,
							0,
							particle.x,
							particle.y,
							particle.r * 5.2,
						);
						glow.addColorStop(0, `rgba(${tone.core},${Math.min(1, alpha)})`);
						glow.addColorStop(0.26, `rgba(${tone.glow},${alpha * 0.72})`);
						glow.addColorStop(1, `rgba(${tone.core},0)`);
						context.fillStyle = glow;
						context.beginPath();
						context.arc(particle.x, particle.y, particle.r * 5.2, 0, Math.PI * 2);
						context.fill();

						context.fillStyle = `rgba(${tone.core},${Math.min(1, alpha + 0.18)})`;
						drawRoundedStar(
							particle.x,
							particle.y,
							particle.r * 1.35,
							particle.r * 0.58,
							particle.rotation,
						);
					}

					if (!momentFlowReducedMotion) animationFrame = requestAnimationFrame(draw);
				};

				const stop = () => {
					stopped = true;
					if (animationFrame) cancelAnimationFrame(animationFrame);
					resizeObserver?.disconnect();
					window.removeEventListener("resize", resize);
				};

				resize();
				if ("ResizeObserver" in window) {
					resizeObserver = new ResizeObserver(resize);
					resizeObserver.observe(host);
				}
				window.addEventListener("resize", resize, { passive: true });
				animationFrame = requestAnimationFrame(draw);
				cleanups.push(stop);
			}
		};

		const scheduleMomentsInit = () => {
			if (runtime.scheduledFrame) cancelAnimationFrame(runtime.scheduledFrame);
			runtime.scheduledFrame = requestAnimationFrame(() => {
				runtime.scheduledFrame = 0;
				runtime.init?.();
			});
		};
		const bindSwupHooks = () => {
			if (runtime.hooksBound || !window.swup?.hooks) return;
			window.swup.hooks.on("content:replace", scheduleMomentsInit);
			window.swup.hooks.on("page:view", scheduleMomentsInit);
			runtime.hooksBound = true;
		};

		runtime.init = initMomentsPage;
		window[runtimeKey] = runtime;
		if (!runtime.eventsBound) {
			for (const eventName of [
				"astro:page-load",
				"swup:contentReplaced",
				"swup:content:replace",
				"swup:page:view",
			]) {
				document.addEventListener(eventName, scheduleMomentsInit);
			}
			document.addEventListener("swup:enable", bindSwupHooks);
			runtime.eventsBound = true;
		}
		bindSwupHooks();
		initMomentsPage();
	})();
</script>
</MainGridLayout>

