{
	"$schema": "https://pages.edgeone.ai/document/edgeone-json-schema",
	"cloudFunctions": {
		"nodejs": {
			"maxDuration": 120
		}
	},
	"headers": [
		{
			"source": "/assets/*",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=31536000, immutable"
				}
			]
		}
	]
}
